require "shellwords"

default_platform(:ios)

# App Store Connect API key, read from the environment (put them in fastlane/.env, which is
# git ignored):
#   ASC_KEY_ID     key ID shown next to the key in App Store Connect
#   ASC_ISSUER_ID  issuer ID shown above the keys list
#   ASC_KEY_PATH   absolute path to the downloaded AuthKey_<ID>.p8, kept outside the repo
#
# The build number needs no bump: the app target stamps CFBundleVersion with the git commit
# count on every build. The marketing version comes from MARKETING_VERSION in the project.

platform :ios do
  before_all do
    ensure_git_status_clean
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    api_key = asc_api_key
    ipa = build_release
    upload_to_testflight(
      api_key: api_key,
      ipa: ipa,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Build, upload, and submit the version for App Store review"
  desc "Store text and screenshots stay managed in App Store Connect"
  lane :release do
    api_key = asc_api_key
    ipa = build_release

    # Review needs a processed build, so this upload waits for processing.
    upload_to_testflight(api_key: api_key, ipa: ipa)

    upload_to_app_store(
      api_key: api_key,
      app_version: get_ipa_info_plist_value(ipa: ipa, key: "CFBundleShortVersionString"),
      build_number: get_ipa_info_plist_value(ipa: ipa, key: "CFBundleVersion"),
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      precheck_include_in_app_purchases: false,
      submission_information: { add_id_info_uses_idfa: false }
    )
  end

  private_lane :asc_api_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH")
    )
  end

  # Automatic signing; the API key lets xcodebuild create or refresh the distribution
  # certificate and profile without an Xcode account signed in.
  private_lane :build_release do
    build_app(
      project: "NextExplorer.xcodeproj",
      scheme: "NextExplorer",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build/fastlane",
      clean: true,
      xcargs: [
        "-allowProvisioningUpdates",
        "-authenticationKeyPath #{ENV.fetch('ASC_KEY_PATH').shellescape}",
        "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID')}",
        "-authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID')}"
      ].join(" ")
    )
  end
end
