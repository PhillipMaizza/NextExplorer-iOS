require "shellwords"

default_platform(:ios)

# App Store Connect API key, read from the environment (put them in fastlane/.env, which is
# git ignored):
#   ASC_KEY_ID     key ID shown next to the key in App Store Connect
#   ASC_ISSUER_ID  issuer ID shown above the keys list
#   ASC_KEY_PATH   absolute path to the downloaded AuthKey_<ID>.p8, kept outside the repo
# Optional:
#   GH_USER        gh account to open the version bump PR with, when several are logged in
#
# The build number needs no bump: the app target stamps CFBundleVersion with the git commit
# count on every build. The marketing version is MARKETING_VERSION in the project; `release`
# bumps it on main after submitting.

PROJECT = "NextExplorer.xcodeproj".freeze
PBXPROJ = "#{PROJECT}/project.pbxproj".freeze
SCHEME = "NextExplorer".freeze
DEFAULT_DEVICE = "iPhone 17 Pro".freeze

# Same set as CI. Keychain is left out: its tests need an entitled app host (errSecMissingEntitlement
# as a standalone package on the simulator).
TEST_PACKAGES = %w[
  CoreModels NetworkClient AuthClient FilesClient Localization DesignSystem
  AuthFeature FilesFeature AppStorageKeys AppFeature
].freeze

def repo_root
  @repo_root ||= `git rev-parse --show-toplevel`.strip
end

def destination(device)
  "platform=iOS Simulator,name=#{device || DEFAULT_DEVICE},OS=latest"
end

def marketing_version
  versions = File.read(File.join(repo_root, PBXPROJ)).scan(/MARKETING_VERSION = ([0-9.]+);/).flatten
  versions.max_by { |version| Gem::Version.new(version) }
end

def next_version(version, type)
  major, minor, patch = (version.split(".").map(&:to_i) + [0, 0, 0]).first(3)
  case type.to_s
  when "major" then "#{major + 1}.0.0"
  when "minor" then "#{major}.#{minor + 1}.0"
  when "patch", "" then "#{major}.#{minor}.#{patch + 1}"
  else UI.user_error!("Unknown bump type '#{type}', use patch, minor or major")
  end
end

def release_tag(version)
  "v#{version}"
end

platform :ios do
  desc "Run every package's unit tests on the simulator (options: device)"
  lane :unit_tests do |options|
    failed = []
    TEST_PACKAGES.each do |package|
      directory = File.join(repo_root, "Packages", package)
      sh("cd #{directory.shellescape} && xcodebuild test -quiet -scheme #{package} " \
         "-destination #{destination(options[:device]).shellescape} -enableCodeCoverage NO",
         error_callback: ->(_) { failed << package })
    end
    UI.user_error!("Unit tests failed in: #{failed.join(', ')}") unless failed.empty?
    UI.success("Unit tests passed in #{TEST_PACKAGES.count} packages")
  end

  desc "Run the XCUITest suite (options: device, only_testing: comma separated classes)"
  lane :ui_tests do |options|
    only_testing = options[:only_testing].to_s.split(",").map(&:strip).reject(&:empty?)
    run_tests(
      project: PROJECT,
      scheme: SCHEME,
      destination: destination(options[:device]),
      only_testing: only_testing.empty? ? ["NextExplorerUITests"] : only_testing.map { |name| "NextExplorerUITests/#{name}" },
      result_bundle: true,
      output_directory: "build/fastlane/ui-tests",
      parallel_testing: false,
      xcargs: "ENABLE_DEBUG_DYLIB=NO -test-timeouts-enabled YES " \
              "-default-test-execution-time-allowance 90 -maximum-test-execution-time-allowance 150"
    )
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    ensure_git_status_clean
    api_key = asc_api_key
    ipa = build_release
    upload_to_testflight(
      api_key: api_key,
      ipa: ipa,
      changelog: testflight_notes(version: marketing_version),
      skip_waiting_for_build_processing: true
    )
  end

  desc "Run the unit tests and build a Release archive, without uploading anything"
  lane :release_dry_run do
    ensure_git_status_clean
    ensure_version_unreleased
    unit_tests(device: DEFAULT_DEVICE)
    build_release
  end

  desc "Release from main: tag check, unit tests, cut release/<version>, upload, submit for review,"
  desc "tag v<version>, then open an auto merging bump/<next> PR on main."
  desc "Goes live automatically once approved. Options: manual_release (hold for a manual release,"
  desc "default false), phased (7 day phased rollout, default false), bump (patch, minor, major)"
  lane :release do |options|
    ensure_git_status_clean
    ensure_git_branch(branch: "^main$")
    sh("git", "pull", "--ff-only", "origin", "main")

    version = marketing_version
    ensure_version_unreleased
    unit_tests(device: DEFAULT_DEVICE)

    release_branch = "release/#{version}"
    sh("git", "switch", "-c", release_branch)
    sh("git", "push", "-u", "origin", release_branch)

    api_key = asc_api_key
    ipa = build_release
    build_number = get_ipa_info_plist_value(ipa: ipa, key: "CFBundleVersion")

    # Review needs a processed build, so this upload waits for processing.
    upload_to_testflight(api_key: api_key, ipa: ipa, changelog: testflight_notes(version: version))

    upload_to_app_store(
      api_key: api_key,
      app_version: version,
      build_number: build_number,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: options[:manual_release] != true,
      phased_release: options[:phased] == true,
      force: true,
      precheck_include_in_app_purchases: false,
      submission_information: { add_id_info_uses_idfa: false }
    )

    tag = release_tag(version)
    add_git_tag(tag: tag, message: "#{version} (#{build_number}) submitted for review")
    push_git_tags(tag: tag)

    sh("git", "switch", "main")
    bump(type: options[:bump] || "patch")
  end

  desc "Bump MARKETING_VERSION on main through an auto merging bump/<version> PR"
  desc "Options: type (patch, minor, major; default patch)"
  lane :bump do |options|
    ensure_git_status_clean
    ensure_git_branch(branch: "^main$")
    sh("git", "pull", "--ff-only", "origin", "main")

    current = marketing_version
    upcoming = next_version(current, options[:type])
    branch = "bump/#{upcoming}"
    title = "Bump version to #{upcoming}"

    sh("git", "switch", "-c", branch)
    path = File.join(repo_root, PBXPROJ)
    project = File.read(path)
    bumped = project.gsub("MARKETING_VERSION = #{current};", "MARKETING_VERSION = #{upcoming};")
    UI.user_error!("MARKETING_VERSION = #{current}; not found in #{PBXPROJ}") if bumped == project
    File.write(path, bumped)

    sh("git", "commit", "-m", title, "--", path)
    sh("git", "push", "-u", "origin", branch)
    with_gh do
      sh("gh", "pr", "create", "--base", "main", "--head", branch, "--title", title,
         "--body", "Opened by fastlane after #{current}; merges itself once the required checks pass.")
      sh("gh", "pr", "merge", branch, "--auto", "--squash", "--delete-branch")
    end
    sh("git", "switch", "main")
    UI.success("#{title}: PR opened with auto merge")
  end

  # A version is released once its tag exists, locally or on origin. Bump before releasing again.
  private_lane :ensure_version_unreleased do
    tag = release_tag(marketing_version)
    sh("git", "fetch", "--tags", "--quiet", "origin")
    if git_tag_exists(tag: tag, remote: true)
      UI.user_error!("#{tag} is already released; run `fastlane bump` first")
    end
  end

  # "What to Test", generated from main's history for the version (Scripts/gen-changelog.py).
  private_lane :testflight_notes do |options|
    script = File.join(repo_root, "Scripts/gen-changelog.py")
    notes = sh("python3", script, "--notes", options[:version], log: false).strip
    notes.empty? ? nil : notes
  end

  private_lane :asc_api_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH")
    )
  end

  # Automatic signing; the API key lets xcodebuild create or refresh the distribution
  # certificate and profile without an Xcode account signed in.
  private_lane :build_release do
    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build/fastlane",
      clean: true,
      xcargs: [
        "-allowProvisioningUpdates",
        "-authenticationKeyPath #{ENV.fetch('ASC_KEY_PATH').shellescape}",
        "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID')}",
        "-authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID')}"
      ].join(" ")
    )
  end
end

# Runs the block with GH_TOKEN for GH_USER when set, so the PR comes from the right account.
def with_gh
  previous = ENV["GH_TOKEN"]
  ENV["GH_TOKEN"] = `gh auth token --user #{ENV['GH_USER'].shellescape}`.strip if ENV["GH_USER"]
  yield
ensure
  ENV["GH_TOKEN"] = previous
end
