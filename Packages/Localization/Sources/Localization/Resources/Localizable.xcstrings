    "downloads.deleteSingleMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This only removes the local copy. The file stays on the server."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا يزيل النسخة المحلية فقط. يبقى الملف على الخادم."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tím se odebere pouze místní kopie. Soubor zůstane na serveru."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette fjerner kun den lokale kopi. Filen forbliver på serveren."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies entfernt nur die lokale Kopie. Die Datei bleibt auf dem Server."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό αφαιρεί μόνο το τοπικό αντίγραφο. Το αρχείο παραμένει στον διακομιστή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto solo elimina la copia local. El archivo permanece en el servidor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä poistaa vain paikallisen kopion. Tiedosto säilyy palvelimella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime uniquement la copie locale. Le fichier reste sur le serveur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולה זו מסירה רק את העותק המקומי. הקובץ נשאר בשרת."
