    "changePassword.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change the password you use to sign in with your email address. You'll stay signed in on this device."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غيّر كلمة السر التي تستخدمها لتسجيل الدخول ببريدك الإلكتروني. ستبقى مسجّل الدخول على هذا الجهاز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändere das Passwort, mit dem du dich per E-Mail-Adresse anmeldest. Du bleibst auf diesem Gerät angemeldet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia la contraseña que usas para iniciar sesión con tu dirección de correo. Seguirás con la sesión iniciada en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changez le mot de passe que vous utilisez pour vous connecter avec votre adresse e-mail. Vous resterez connecté sur cet appareil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने ईमेल पते से साइन इन करने के लिए उपयोग किया जाने वाला पासवर्ड बदलें। आप इस डिवाइस पर साइन इन रहेंगे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia la password che usi per accedere con il tuo indirizzo email. Resterai connesso su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールアドレスでサインインする際に使うパスワードを変更します。このデバイスではサインインしたままになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이메일 주소로 로그인할 때 사용하는 비밀번호를 변경합니다. 이 기기에서는 로그인 상태가 유지됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wijzig het wachtwoord waarmee je je aanmeldt met je e-mailadres. Je blijft aangemeld op dit apparaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmień hasło używane do logowania za pomocą adresu e-mail. Pozostaniesz zalogowany na tym urządzeniu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Altere a palavra-passe que usa para iniciar sessão com o seu endereço de e-mail. A sua sessão manter-se-á iniciada neste dispositivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Schimbă parola pe care o folosești pentru a te conecta cu adresa ta de e-mail. Vei rămâne conectat pe acest dispozitiv."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Измените пароль, который вы используете для входа с помощью адреса эл. почты. Вы останетесь в системе на этом устройстве."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Byt lösenordet du använder för att logga in med din e-postadress. Du förblir inloggad på den här enheten."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "更改您用于以电子邮件地址登录的密码。您在此设备上仍将保持登录状态。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "更改您用於以電子郵件位址登入的密碼。您在此裝置上仍會保持登入狀態。"
          }
        }
      }
    },
