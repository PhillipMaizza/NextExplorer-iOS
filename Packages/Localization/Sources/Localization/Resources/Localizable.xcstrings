        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उपलब्ध होने पर स्ट्रीम करने के बजाय डाउनलोड किया गया वीडियो उपयोग करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un video scaricato invece dello streaming quando è disponibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用可能な場合はストリーミングの代わりにダウンロードした動画を使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용 가능할 때 스트리밍 대신 다운로드한 동영상을 사용합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een gedownloade video gebruiken in plaats van streamen wanneer die beschikbaar is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Używaj pobranego wideo zamiast strumieniowania, gdy jest dostępne."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
