    "accessRules.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Override read and write access for specific paths."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تجاوز وصول القراءة والكتابة لمسارات محددة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přepište přístup pro čtení a zápis u konkrétních cest."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilsidesæt læse- og skriveadgang for bestemte stier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überschreibe den Lese- und Schreibzugriff für bestimmte Pfade."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παράκαμψη πρόσβασης ανάγνωσης και εγγραφής για συγκεκριμένες διαδρομές."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anula el acceso de lectura y escritura para rutas específicas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohita luku- ja kirjoitusoikeudet tietyille poluille."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplacez l'accès en lecture et écriture pour des chemins spécifiques."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עקיפת הרשאות הקריאה והכתיבה עבור נתיבים מסוימים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विशिष्ट पथों के लिए पढ़ने और लिखने के एक्सेस को ओवरराइड करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az olvasási és írási hozzáférés felülbírálása meghatározott elérési utakhoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Timpa akses baca dan tulis untuk jalur tertentu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovrascrivi l'accesso in lettura e scrittura per percorsi specifici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "特定のパスの読み書きアクセスを上書きします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "특정 경로에 대한 읽기 및 쓰기 접근을 재정의합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
