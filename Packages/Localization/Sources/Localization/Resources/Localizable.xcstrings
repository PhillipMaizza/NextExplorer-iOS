    "browse.deleteLinkedSharesMany": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This also removes %lld share links that point here."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي هذا أيضًا إلى إزالة %lld رابط مشاركة تشير إلى هنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden auch %lld Freigabelinks entfernt, die hierher verweisen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto también elimina %lld enlaces de compartición que apuntan aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime aussi %lld liens de partage pointant ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे यहां इंगित करने वाले %lld साझा लिंक भी हट जाते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo rimuove anche %lld link di condivisione che puntano qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここを指す共有リンク %lld 件も削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기를 가리키는 공유 링크 %lld개도 함께 삭제됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee worden ook %lld deellinks verwijderd die hierheen verwijzen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to również usunięcie %lld linków udostępniania wskazujących tutaj."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto também remove %lld ligações de partilha que apontam para aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceasta elimină și %lld linkuri de partajare care indică aici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При этом также удаляется ссылок, ведущих сюда: %lld."
          }
        },
        "sv": {
