    "apiTokens.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "API tokens let scripts and other tools use your account without your password. A token only does what its access allows, and you can revoke it at any time."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتيح رموز API للسكربتات والأدوات الأخرى استخدام حسابك دون كلمة السر. يقتصر الرمز على ما يسمح به وصوله، ويمكنك إبطاله في أي وقت."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tokeny API umožňují skriptům a dalším nástrojům používat váš účet bez hesla. Token dělá jen to, co povoluje jeho přístup, a můžete ho kdykoli odvolat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "API-tokens lader scripts og andre værktøjer bruge din konto uden din adgangskode. Et token kan kun det, dets adgang tillader, og du kan tilbagekalde det når som helst."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit API-Tokens können Skripte und andere Werkzeuge dein Konto ohne dein Passwort nutzen. Ein Token darf nur das, was sein Zugriff erlaubt, und du kannst ihn jederzeit widerrufen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα διακριτικά API επιτρέπουν σε σενάρια και άλλα εργαλεία να χρησιμοποιούν τον λογαριασμό σας χωρίς τον κωδικό πρόσβασής σας. Ένα διακριτικό κάνει μόνο ό,τι επιτρέπει η πρόσβασή του και μπορείτε να το ανακαλέσετε οποιαδήποτε στιγμή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los tokens de API permiten que scripts y otras herramientas usen tu cuenta sin tu contraseña. Un token solo hace lo que permite su acceso, y puedes revocarlo en cualquier momento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "API-tunnusten avulla komentosarjat ja muut työkalut voivat käyttää tiliäsi ilman salasanaasi. Tunnus tekee vain sen, minkä sen käyttöoikeus sallii, ja voit perua sen milloin tahansa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les jetons d'API permettent à des scripts et à d'autres outils d'utiliser votre compte sans votre mot de passe. Un jeton ne peut faire que ce que son accès autorise, et vous pouvez le révoquer à tout moment."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אסימוני API מאפשרים לסקריפטים ולכלים אחרים להשתמש בחשבון שלכם בלי הסיסמה. אסימון עושה רק את מה שהגישה שלו מתירה, ואפשר לבטל אותו בכל עת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "API टोकन स्क्रिप्ट और अन्य टूल को आपके पासवर्ड के बिना आपका खाता इस्तेमाल करने देते हैं। टोकन केवल वही कर सकता है जो उसकी पहुंच अनुमति देती है, और आप उसे कभी भी रद्द कर सकते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az API-tokenek lehetővé teszik, hogy szkriptek és más eszközök a jelszava nélkül használják a fiókját. A token csak azt teheti, amit a hozzáférése megenged, és bármikor visszavonhatja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Token API memungkinkan skrip dan alat lain memakai akun Anda tanpa kata sandi. Token hanya melakukan apa yang diizinkan aksesnya, dan Anda dapat mencabutnya kapan saja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I token API permettono a script e altri strumenti di usare il tuo account senza la tua password. Un token fa solo ciò che il suo accesso consente e puoi revocarlo in qualsiasi momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "API トークンを使うと、パスワードなしでスクリプトなどのツールからアカウントを利用できます。トークンはアクセス権で許可された操作のみ行え、いつでも失効させられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "API 토큰을 사용하면 비밀번호 없이 스크립트와 다른 도구가 내 계정을 사용할 수 있습니다. 토큰은 허용된 접근 권한 범위 안에서만 동작하며 언제든지 폐기할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "API-tokens lar skript og andre verktøy bruke kontoen din uten passordet ditt. Et token gjør bare det tilgangen tillater, og du kan trekke det tilbake når som helst."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met API-tokens kunnen scripts en andere tools je account gebruiken zonder je wachtwoord. Een token kan alleen doen wat zijn toegang toestaat en je kunt het op elk moment intrekken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tokeny API pozwalają skryptom i innym narzędziom korzystać z Twojego konta bez podawania hasła. Token umożliwia tylko to, na co pozwala jego dostęp, i możesz go unieważnić w dowolnej chwili."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os tokens de API permitem que scripts e outras ferramentas utilizem a sua conta sem a sua palavra-passe. Um token só faz o que o seu acesso permite, e pode revogá-lo em qualquer altura."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tokens de API permitem que scripts e outras ferramentas usem sua conta sem a sua senha. Um token só faz o que o acesso dele permite, e você pode revogá-lo a qualquer momento."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tokenurile API permit scripturilor și altor instrumente să-ți folosească contul fără parola ta. Un token face doar ce permite accesul său, iar îl poți revoca oricând."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "API-токены позволяют скриптам и другим инструментам использовать вашу учётную запись без пароля. Токен делает только то, что разрешает его доступ, и вы можете отозвать его в любой момент."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Med API-tokens kan skript och andra verktyg använda ditt konto utan ditt lösenord. En token kan bara det som dess åtkomst tillåter, och du kan återkalla den när som helst."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โทเคน API ช่วยให้สคริปต์และเครื่องมืออื่นใช้บัญชีของคุณได้โดยไม่ต้องใช้รหัสผ่าน โทเคนทำได้เฉพาะสิ่งที่สิทธิ์การเข้าถึงอนุญาต และคุณเพิกถอนได้ทุกเมื่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "API belirteçleri, betiklerin ve diğer araçların parolanız olmadan hesabınızı kullanmasına izin verir. Bir belirteç yalnızca erişiminin izin verdiğini yapar ve istediğiniz zaman geçersiz kılabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Токени API дають змогу скриптам та іншим інструментам використовувати ваш обліковий запис без пароля. Токен виконує лише те, що дозволяє його доступ, і ви можете відкликати його будь-коли."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Token API cho phép các tập lệnh và công cụ khác dùng tài khoản của bạn mà không cần mật khẩu. Token chỉ làm những gì quyền truy cập của nó cho phép, và bạn có thể thu hồi bất cứ lúc nào."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "API 令牌可让脚本和其他工具在无需您密码的情况下使用您的账户。令牌只能执行其访问权限允许的操作，您可随时撤销。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "API 權杖可讓指令碼和其他工具在不需要您密碼的情況下使用您的帳號。權杖只能執行其取用權限允許的操作，您可隨時撤銷。"
          }
        }
      }
    },
