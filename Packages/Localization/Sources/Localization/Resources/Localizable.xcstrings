    "apiTokens.issuedIntro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the only time it is shown. Store it somewhere safe. If you lose it, revoke it and create a new one."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه هي المرة الوحيدة التي يظهر فيها. احفظه في مكان آمن. إذا فقدته، فأبطله وأنشئ رمزًا جديدًا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazuje se pouze jednou. Uložte ho na bezpečné místo. Pokud ho ztratíte, odvolejte ho a vytvořte nový."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er den eneste gang, det vises. Opbevar det et sikkert sted. Hvis du mister det, skal du tilbagekalde det og oprette et nyt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wird nur dieses eine Mal angezeigt. Bewahre ihn an einem sicheren Ort auf. Wenn du ihn verlierst, widerrufe ihn und erstelle einen neuen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή είναι η μόνη φορά που εμφανίζεται. Φυλάξτε το σε ασφαλές μέρος. Αν το χάσετε, ανακαλέστε το και δημιουργήστε νέο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se muestra esta vez. Guárdalo en un lugar seguro. Si lo pierdes, revócalo y crea uno nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä näytetään vain kerran. Säilytä se turvallisessa paikassa. Jos menetät sen, peru se ja luo uusi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'est affiché qu'une seule fois. Conservez-le en lieu sûr. Si vous le perdez, révoquez-le et créez-en un nouveau."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זו הפעם היחידה שהוא מוצג. שמרו אותו במקום בטוח. אם תאבדו אותו, בטלו אותו וצרו חדש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह केवल एक बार दिखाया जाता है। इसे किसी सुरक्षित जगह रखें। अगर आप इसे खो दें, तो इसे रद्द करके नया बनाएं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez az egyetlen alkalom, amikor megjelenik. Őrizze meg biztonságos helyen. Ha elveszíti, vonja vissza, és hozzon létre újat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini hanya ditampilkan sekali. Simpan di tempat aman. Jika hilang, cabut lalu buat yang baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viene mostrato solo questa volta. Conservalo in un posto sicuro. Se lo perdi, revocalo e creane uno nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示されるのはこの1回だけです。安全な場所に保管してください。紛失した場合は、失効させて新しく作成してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번에만 표시됩니다. 안전한 곳에 보관하세요. 잃어버렸다면 폐기하고 새로 만드세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er den eneste gangen det vises. Oppbevar det på et trygt sted. Hvis du mister det, må du trekke det tilbake og opprette et nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit wordt maar één keer getoond. Bewaar het op een veilige plek. Als je het kwijtraakt, trek je het in en maak je een nieuw token."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Token jest wyświetlany tylko ten jeden raz. Zapisz go w bezpiecznym miejscu. Jeśli go zgubisz, unieważnij go i utwórz nowy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta é a única vez que é apresentado. Guarde-o num local seguro. Se o perder, revogue-o e crie um novo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta é a única vez que ele é exibido. Guarde-o em um lugar seguro. Se você o perder, revogue-o e crie um novo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acesta este singurul moment în care este afișat. Păstrează-l într-un loc sigur. Dacă îl pierzi, revocă-l și creează unul nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Токен показывается только один раз. Сохраните его в надёжном месте. Если вы его потеряете, отзовите его и создайте новый."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta är den enda gången den visas. Förvara den på ett säkert ställe. Om du förlorar den, återkalla den och skapa en ny."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นี่เป็นครั้งเดียวที่โทเคนจะแสดง เก็บไว้ในที่ปลอดภัย หากทำหาย ให้เพิกถอนแล้วสร้างใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca bu kez gösterilir. Güvenli bir yerde saklayın. Kaybederseniz geçersiz kılıp yenisini oluşturun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Його показано лише один раз. Збережіть у надійному місці. Якщо ви його втратите, відкличте його й створіть новий."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Token chỉ hiển thị một lần này. Hãy lưu ở nơi an toàn. Nếu mất, hãy thu hồi và tạo token mới."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此令牌仅显示这一次。请妥善保存。如果丢失，请撤销它并创建新的令牌。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "此權杖只會顯示這一次。請妥善保存。如果遺失，請撤銷它並建立新的權杖。"
          }
        }
      }
    },
