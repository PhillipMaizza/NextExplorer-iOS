    "trashSettings.maxPercentHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The most the trash may hold on a volume, from 1 to 90%."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أقصى ما يمكن أن تشغله السلة على وحدة التخزين، من 1 إلى 90%."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejvíce, co může koš na svazku zabírat, od 1 do 90 %."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det meste, papirkurven må fylde på et drev, fra 1 til 90 %."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höchstens so viel darf der Papierkorb auf einem Volume belegen, von 1 bis 90 %."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το μέγιστο που μπορεί να καταλαμβάνει ο κάδος σε έναν τόμο, από 1 έως 90%."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo máximo que la papelera puede ocupar en un volumen, de 1 a 90 %."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Enimmäismäärä, jonka roskakori saa viedä taltiolla, 1–90 %."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le maximum que la corbeille peut occuper sur un volume, de 1 à 90 %."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המקסימום שפח האשפה רשאי לתפוס בכרך, מ-1 עד 90%."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी वॉल्यूम पर रीसायकल बिन अधिकतम कितना ले सकता है, 1 से 90 %।."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A legtöbb, amit a kuka egy köteten elfoglalhat, 1 és 90% között."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Paling banyak yang boleh dipakai sampah di sebuah volume, dari 1 sampai 90%."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il massimo che il cestino può occupare su un volume, da 1 a 90 %."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱がボリューム上で使える最大の割合です（1〜90%）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통이 한 볼륨에서 차지할 수 있는 최대치, 1~90%."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det meste papirkurven kan oppta på et volum, fra 1 til 90 %."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het maximum dat de prullenbak op een volume mag innemen, van 1 tot 90%."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najwięcej, ile kosz może zająć na woluminie, od 1 do 90 %."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O máximo que a reciclagem pode ocupar num volume, de 1 a 90%."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O máximo que a lixeira pode ocupar em um volume, de 1 a 90 %."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cel mult cât poate ocupa coșul de gunoi pe un volum, între 1 și 90 %."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Максимум, который корзина может занимать на томе, от 1 до 90 %."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det mesta papperskorgen får ta på en volym, från 1 till 90 %."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปริมาณสูงสุดที่ถังขยะใช้ได้บนวอลุ่ม ตั้งแต่ 1 ถึง 90%"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çöp kutusunun bir birimde tutabileceği en fazla miktar, 1 ile 90% arası."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Максимум, який кошик може займати на томі, від 1 до 90%."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mức tối đa thùng rác được chiếm trên một volume, từ 1 đến 90%."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "回收站在一个卷上最多可占用的比例，1 至 90%。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "資源回收筒在一個卷宗上最多可佔用的比例，1 至 90%。"
          }
        }
      }
    },
