            "value": "Platnost tohoto certifikátu vyprší %@. Požádejte o nový před tímto datem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette certifikat udløber %@. Bed om et nyt inden da."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Zertifikat läuft am %@ ab. Fordere vorher ein neues an."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το πιστοποιητικό λήγει στις %@. Ζητήστε νέο πριν από τότε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este certificado caduca el %@. Pide uno nuevo antes de esa fecha."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä varmenne vanhenee %@. Pyydä uusi ennen sitä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce certificat expire le %@. Demandez-en un nouveau avant cette date."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תוקף האישור הזה פג ב-%@. בקשו חדש לפני כן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह सर्टिफ़िकेट %@ को समाप्त होगा। उससे पहले नया माँग लें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a tanúsítvány ekkor jár le: %@. Kérjen újat előtte."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sertifikat ini kedaluwarsa pada %@. Minta yang baru sebelum itu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo certificato scade il %@. Richiedine uno nuovo prima di allora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この証明書は %@ に期限切れになります。それまでに新しい証明書を依頼してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 인증서는 %@에 만료됩니다. 그 전에 새 인증서를 요청하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette sertifikatet utløper %@. Be om et nytt før det."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit certificaat verloopt op %@. Vraag vóór die datum een nieuw aan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten certyfikat wygasa %@. Poproś o nowy przed tym terminem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este certificado expira a %@. Peça um novo antes dessa data."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este certificado expira em %@. Peça um novo antes dessa data."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest certificat expiră pe %@. Cere unul nou înainte de această dată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Срок действия этого сертификата истекает %@. Запросите новый заранее."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Certifikatet går ut %@. Be om ett nytt innan dess."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใบรับรองนี้จะหมดอายุเมื่อ %@ ขอใบรับรองใหม่ก่อนถึงวันนั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sertifikanın süresi %@ tarihinde doluyor. Öncesinde yenisini isteyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Термін дії цього сертифіката спливає %@. Попросіть новий до цього часу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chứng chỉ này hết hạn vào %@. Hãy yêu cầu chứng chỉ mới trước thời điểm đó."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此证书将于 %@ 过期。请在此之前申请新的证书。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "此憑證將於 %@ 過期。請在此之前申請新的憑證。"
          }
        }
      }
