          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо не зберегти, зміни буде втрачено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các thay đổi sẽ mất nếu bạn không lưu."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "如果不存储，你的更改将会丢失。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "如果不儲存，你的變更將會遺失。"
