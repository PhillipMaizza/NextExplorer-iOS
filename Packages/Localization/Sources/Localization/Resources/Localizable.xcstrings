    "fileInfo.deleteMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleted versions are gone for good. The file itself stays as it is."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحذف الإصدارات نهائيًا. يبقى الملف نفسه كما هو."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Smazané verze jsou nenávratně pryč. Samotný soubor zůstane, jak je."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slettede versioner er væk for altid. Selve filen forbliver, som den er."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelöschte Versionen sind endgültig weg. Die Datei selbst bleibt unverändert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι διαγραμμένες εκδόσεις χάνονται για πάντα. Το ίδιο το αρχείο μένει όπως είναι."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las versiones eliminadas desaparecen para siempre. El archivo se queda como está."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistetut versiot ovat poissa lopullisesti. Itse tiedosto säilyy sellaisenaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les versions supprimées le sont définitivement. Le fichier lui-même reste tel quel."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גרסאות שנמחקו נעלמות לצמיתות. הקובץ עצמו נשאר כפי שהוא."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हटाए गए संस्करण हमेशा के लिए चले जाते हैं। फ़ाइल वैसी ही रहती है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A törölt verziók végleg elvesznek. Maga a fájl változatlan marad."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Versi yang dihapus hilang selamanya. File itu sendiri tetap seperti adanya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le versioni eliminate spariscono per sempre. Il file resta com'è."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除したバージョンは元に戻せません。ファイル自体はそのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제한 버전은 영구히 사라집니다. 파일 자체는 그대로 유지됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slettede versjoner er borte for godt. Selve filen forblir som den er."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijderde versies zijn voorgoed weg. Het bestand zelf blijft zoals het is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunięte wersje znikają na zawsze. Sam plik pozostaje bez zmian."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As versões eliminadas desaparecem para sempre. O ficheiro em si fica como está."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As versões apagadas somem para sempre. O arquivo em si continua como está."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Versiunile șterse dispar definitiv. Fișierul rămâne neschimbat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалённые версии исчезают навсегда. Сам файл остаётся как есть."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Raderade versioner försvinner för gott. Själva filen förblir som den är."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวอร์ชันที่ลบแล้วจะหายไปถาวร ตัวไฟล์ยังคงเหมือนเดิม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Silinen sürümler kalıcı olarak gider. Dosyanın kendisi olduğu gibi kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалені версії зникають назавжди. Сам файл залишається як є."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các phiên bản đã xóa sẽ mất vĩnh viễn. Bản thân tệp vẫn giữ nguyên."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "删除的版本无法恢复。文件本身保持不变。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除的版本無法復原。檔案本身維持不變。"
          }
        }
      }
    },
