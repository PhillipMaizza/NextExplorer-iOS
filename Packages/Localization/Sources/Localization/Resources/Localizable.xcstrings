    "downloadQueue.photosAccessDenied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Photos access in Settings to save pictures and videos."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
