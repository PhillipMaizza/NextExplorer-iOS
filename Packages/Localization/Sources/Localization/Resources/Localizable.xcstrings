    "settings.toggleKeepClipboardSubtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copied items stay ready to paste into another folder. Moved items always clear."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى العناصر المنسوخة جاهزة للصق في مجلد آخر. العناصر المنقولة تُمسح دائمًا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkopírované položky zůstanou připravené k vložení do jiné složky. Přesunuté položky se vždy vymažou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopierede emner forbliver klar til at blive indsat i en anden mappe. Flyttede emner ryddes altid."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopierte Objekte bleiben bereit, um in einen anderen Ordner eingesetzt zu werden. Bewegte Objekte werden immer gelöscht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα αντιγραμμένα στοιχεία παραμένουν έτοιμα για επικόλληση σε άλλον φάκελο. Τα μετακινημένα στοιχεία εκκαθαρίζονται πάντα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los elementos copiados quedan listos para pegar en otra carpeta. Los elementos movidos siempre se borran."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopioidut kohteet pysyvät valmiina liitettäväksi toiseen kansioon. Siirretyt kohteet tyhjennetään aina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les éléments copiés restent prêts à coller dans un autre dossier. Les éléments déplacés sont toujours effacés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פריטים שהועתקו נשארים מוכנים להדבקה בתיקייה אחרת. פריטים שהועברו תמיד מתנקים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कॉपी किए गए आइटम दूसरे फ़ोल्डर में पेस्ट करने के लिए तैयार रहते हैं। स्थानांतरित आइटम हमेशा साफ़ हो जाते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A másolt elemek készen maradnak a másik mappába való beillesztésre. Az áthelyezett elemek mindig törlődnek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Item yang disalin tetap siap ditempel ke folder lain. Item yang dipindahkan selalu dikosongkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli elementi copiati restano pronti da incollare in un'altra cartella. Gli elementi spostati vengono sempre cancellati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーした項目は別のフォルダにペーストできる状態のまま残ります。移動した項目は常に消去されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복사한 항목은 다른 폴더에 붙여넣을 수 있도록 유지됩니다. 이동한 항목은 항상 지워집니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopierte elementer blir stående klare til å limes inn i en annen mappe. Flyttede elementer tømmes alltid."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gekopieerde items blijven klaar om in een andere map te plakken. Verplaatste items worden altijd gewist."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skopiowane elementy pozostają gotowe do wklejenia do innego folderu. Przeniesione elementy są zawsze czyszczone."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os itens copiados ficam prontos para colar noutra pasta. Os itens movidos são sempre limpos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os itens copiados ficam prontos para colar em outra pasta. Os itens movidos são sempre limpos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Elementele copiate rămân gata de lipit în alt dosar. Elementele mutate se golesc mereu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопированные объекты остаются готовыми для вставки в другую папку. Перемещённые объекты всегда очищаются."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopierade objekt förblir redo att klistras in i en annan mapp. Flyttade objekt rensas alltid."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการที่คัดลอกจะพร้อมวางในโฟลเดอร์อื่น ส่วนรายการที่ย้ายจะถูกล้างทุกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopyalanan öğeler başka bir klasöre yapıştırılmaya hazır kalır. Taşınan öğeler her zaman temizlenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопійовані елементи залишаються готовими до вставлення в іншу папку. Переміщені елементи завжди очищаються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các mục đã sao chép vẫn sẵn sàng để dán vào thư mục khác. Các mục đã di chuyển luôn bị xóa."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "拷贝的项目会保持可粘贴到其他文件夹的状态。移动的项目始终会被清除。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "拷貝的項目會保持可貼上到其他檔案夾的狀態。移動的項目一律會被清除。"
          }
        }
      }
    },
