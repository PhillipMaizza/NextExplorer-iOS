    "thumbnailSettings.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Control how the server generates image thumbnails for every client."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحكّم في كيفية إنشاء الخادم للصور المصغّرة لكل عميل."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Určete, jak server vytváří miniatury obrázků pro všechny klienty."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Styr, hvordan serveren opretter miniaturer af billeder til alle klienter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steuere, wie der Server Bildminiaturen für jeden Client erzeugt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ελέγξτε πώς ο διακομιστής δημιουργεί μικρογραφίες εικόνων για όλους τους πελάτες."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Controla cómo el servidor genera las miniaturas de imagen para todos los clientes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Määritä, miten palvelin luo kuvien pikkukuvat kaikille asiakkaille."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrôlez la façon dont le serveur génère les miniatures d'image pour tous les clients."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שליטה באופן שבו השרת יוצר תמונות ממוזערות לכל הלקוחות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नियंत्रित करें कि सर्वर हर क्लाइंट के लिए छवि थंबनेल कैसे बनाता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szabályozza, hogyan hozza létre a kiszolgáló a képek miniatűrjeit az összes kliens számára."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Atur cara server membuat gambar mini untuk setiap klien."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla come il server genera le miniature delle immagini per ogni client."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーがすべてのクライアント向けに画像サムネールを生成する方法を制御します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 모든 클라이언트를 위해 이미지 썸네일을 생성하는 방식을 제어합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Styr hvordan serveren lager miniatyrbilder av bilder for alle klienter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bepaal hoe de server afbeeldingsminiaturen genereert voor elke client."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontroluj sposób generowania miniatur obrazów przez serwer dla każdego klienta."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Controle como o servidor gera as miniaturas de imagem para todos os clientes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Controle como o servidor gera as miniaturas de imagem para todos os clientes."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlează modul în care serverul generează miniaturile de imagine pentru fiecare client."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Управляйте тем, как сервер создаёт миниатюры изображений для всех клиентов."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Styr hur servern genererar bildminiatyrer för alla klienter."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ควบคุมวิธีที่เซิร์ฟเวอร์สร้างภาพขนาดย่อสำหรับไคลเอนต์ทั้งหมด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucunun her istemci için küçük resimleri nasıl oluşturacağını denetleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Керуйте тим, як сервер створює мініатюри зображень для всіх клієнтів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm soát cách máy chủ tạo ảnh thu nhỏ cho mọi máy khách."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "控制服务器为每个客户端生成图像缩略图的方式。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "控制伺服器為每個用戶端生成圖像縮覽圖的方式。"
          }
        }
      }
    },
    "thumbnailSettings.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thumbnail settings are only available to administrators."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعدادات الصور المصغّرة متاحة للمسؤولين فقط."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavení miniatur je dostupné pouze správcům."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indstillinger for miniaturer er kun tilgængelige for administratorer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Miniatureinstellungen sind nur für Administratoren verfügbar."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι ρυθμίσεις μικρογραφιών είναι διαθέσιμες μόνο στους διαχειριστές."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ajustes de miniaturas solo están disponibles para administradores."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pikkukuva-asetukset ovat vain ylläpitäjien käytettävissä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réglages de miniatures sont réservés aux administrateurs."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגדרות התמונות הממוזערות זמינות למנהלי מערכת בלבד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "थंबनेल सेटिंग्स केवल व्यवस्थापकों के लिए उपलब्ध हैं।"
