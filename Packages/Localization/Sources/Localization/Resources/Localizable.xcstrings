    "userDetail.volumesFootnote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Volumes give a user access to a directory outside the default shared space. Removing a volume never deletes files."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمنح وحدات التخزين المستخدم وصولاً إلى دليل خارج المساحة المشتركة الافتراضية. إزالة وحدة تخزين لا تحذف الملفات أبدًا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Svazky dávají uživateli přístup k adresáři mimo výchozí sdílený prostor. Odebráním svazku se nikdy nesmažou soubory."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Drev giver en bruger adgang til en mappe uden for det delte standardområde. Fjernelse af et drev sletter aldrig filer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Volumes geben einem Benutzer Zugriff auf ein Verzeichnis außerhalb des standardmäßigen freigegebenen Bereichs. Das Entfernen eines Volumes löscht niemals Dateien."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι τόμοι δίνουν στον χρήστη πρόσβαση σε έναν κατάλογο εκτός του προεπιλεγμένου κοινόχρηστου χώρου. Η αφαίρεση ενός τόμου δεν διαγράφει ποτέ αρχεία."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los volúmenes dan a un usuario acceso a un directorio fuera del espacio compartido predeterminado. Quitar un volumen nunca elimina archivos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Taltiot antavat käyttäjälle pääsyn oletusarvoisen jaetun tilan ulkopuolella olevaan hakemistoon. Taltion poistaminen ei koskaan poista tiedostoja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les volumes donnent à un utilisateur l'accès à un répertoire hors de l'espace partagé par défaut. Retirer un volume ne supprime jamais de fichiers."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כרכים מעניקים למשתמש גישה לספרייה מחוץ למרחב המשותף שמוגדר כברירת מחדל. הסרת כרך לעולם אינה מוחקת קבצים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वॉल्यूम किसी उपयोगकर्ता को डिफ़ॉल्ट साझा स्थान के बाहर की निर्देशिका तक एक्सेस देते हैं। वॉल्यूम निकालने से कभी फ़ाइलें नहीं हटतीं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kötetek hozzáférést adnak a felhasználónak az alapértelmezett megosztott területen kívüli könyvtárhoz. Egy kötet eltávolítása soha nem töröl fájlokat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume memberi pengguna akses ke direktori di luar ruang bersama default. Menghapus volume tidak pernah menghapus file."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I volumi danno a un utente accesso a una directory fuori dallo spazio condiviso predefinito. Rimuovere un volume non elimina mai i file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボリュームは、デフォルトの共有スペース外のディレクトリへのアクセスをユーザに付与します。ボリュームを削除してもファイルは決して削除されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "볼륨은 사용자에게 기본 공유 공간 외부의 디렉터리에 대한 접근을 제공합니다. 볼륨을 제거해도 파일은 삭제되지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Volumer gir en bruker tilgang til en mappe utenfor standard delt område. Å fjerne et volum sletter aldri filer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Volumes geven een gebruiker toegang tot een map buiten de standaard gedeelde ruimte. Een volume verwijderen wist nooit bestanden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Woluminy dają użytkownikowi dostęp do katalogu poza domyślną przestrzenią współdzieloną. Usunięcie woluminu nigdy nie usuwa plików."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os volumes dão a um utilizador acesso a um diretório fora do espaço partilhado predefinido. Remover um volume nunca elimina ficheiros."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os volumes dão a um usuário acesso a um diretório fora do espaço compartilhado padrão. Remover um volume nunca exclui arquivos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Volumele oferă unui utilizator acces la un director în afara spațiului partajat implicit. Eliminarea unui volum nu șterge niciodată fișiere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тома дают пользователю доступ к каталогу вне стандартного общего пространства. Удаление тома никогда не удаляет файлы."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Volymer ger en användare åtkomst till en katalog utanför det delade standardutrymmet. Att ta bort en volym raderar aldrig filer."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วอลุ่มให้ผู้ใช้เข้าถึงไดเรกทอรีนอกพื้นที่ใช้ร่วมกันเริ่มต้น การนำวอลุ่มออกจะไม่ลบไฟล์เลย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birimler, kullanıcıya varsayılan paylaşılan alanın dışındaki bir dizine erişim verir. Bir birimi kaldırmak dosyaları asla silmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Томи надають користувачеві доступ до каталогу поза типовим спільним простором. Вилучення тому ніколи не видаляє файли."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume cho phép người dùng truy cập một thư mục nằm ngoài không gian chia sẻ mặc định. Xóa volume không bao giờ xóa tệp."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "卷可让用户访问默认共享空间之外的目录。移除卷绝不会删除文件。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "卷宗可讓使用者取用預設共享空間之外的目錄。移除卷宗絕不會刪除檔案。"
          }
        }
      }
    },
