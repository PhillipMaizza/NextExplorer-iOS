    "apiTokens.emptyMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create one to let a script use your account."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنشئ رمزًا لتسمح لسكربت باستخدام حسابك."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vytvořte token, aby skript mohl používat váš účet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opret et, så et script kan bruge din konto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle einen, damit ein Skript dein Konto nutzen kann."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δημιουργήστε ένα για να επιτρέψετε σε ένα σενάριο να χρησιμοποιεί τον λογαριασμό σας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea uno para que un script use tu cuenta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luo tunnus, jotta komentosarja voi käyttää tiliäsi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez-en un pour permettre à un script d'utiliser votre compte."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צרו אסימון כדי לאפשר לסקריפט להשתמש בחשבון שלכם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी स्क्रिप्ट को अपना खाता इस्तेमाल करने देने के लिए एक बनाएं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hozzon létre egyet, hogy egy szkript használhassa a fiókját."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buat satu agar skrip dapat memakai akun Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Creane uno per permettere a uno script di usare il tuo account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクリプトからあなたのアカウントを使えるようにするには、トークンを作成してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크립트가 내 계정을 사용할 수 있도록 토큰을 만드세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opprett ett slik at et skript kan bruke kontoen din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak er een zodat een script je account kan gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utwórz token, aby skrypt mógł korzystać z Twojego konta."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie um para permitir que um script utilize a sua conta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie um para permitir que um script use sua conta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Creează unul pentru ca un script să-ți poată folosi contul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создайте токен, чтобы скрипт мог использовать вашу учётную запись."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skapa en så att ett skript kan använda ditt konto."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างหนึ่งโทเคนเพื่อให้สคริปต์ใช้บัญชีของคุณได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir betiğin hesabınızı kullanmasına izin vermek için bir tane oluşturun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Створіть токен, щоб скрипт міг використовувати ваш обліковий запис."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy tạo một token để tập lệnh có thể dùng tài khoản của bạn."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "创建一个，让脚本使用您的账户。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "建立一個，讓指令碼使用您的帳號。"
          }
        }
      }
