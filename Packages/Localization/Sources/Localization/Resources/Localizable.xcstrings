    "serverDetails.urlFootnote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The address where your NextExplorer instance is installed. To change it, sign out and add the server again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العنوان الذي تم تثبيت نسخة NextExplorer الخاصة بك عليه. لتغييره، سجّل الخروج وأضف الخادم مرة أخرى."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresa, na které je nainstalována vaše instance NextExploreru. Chcete-li ji změnit, odhlaste se a přidejte server znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Adressen, hvor din NextExplorer-instans er installeret. Hvis du vil ændre den, skal du logge ud og tilføje serveren igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Adresse, unter der deine NextExplorer-Instanz installiert ist. Zum Ändern melde dich ab und füge den Server erneut hinzu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η διεύθυνση όπου είναι εγκατεστημένο το NextExplorer σας. Για να την αλλάξετε, αποσυνδεθείτε και προσθέστε ξανά τον διακομιστή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La dirección donde está instalada tu instancia de NextExplorer. Para cambiarla, cierra sesión y añade el servidor de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Osoite, jossa NextExplorer-instanssisi on asennettuna. Jos haluat muuttaa sitä, kirjaudu ulos ja lisää palvelin uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'adresse où votre instance NextExplorer est installée. Pour la modifier, déconnectez-vous et ajoutez à nouveau le serveur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הכתובת שבה מותקן מופע ה-NextExplorer שלכם. כדי לשנות אותה, התנתקו והוסיפו את השרת מחדש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वह पता जहां आपका NextExplorer इंस्टेंस स्थापित है। इसे बदलने के लिए, साइन आउट करें और सर्वर फिर से जोड़ें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az a cím, ahol a NextExplorer példánya telepítve van. A módosításhoz jelentkezzen ki, és adja hozzá újra a kiszolgálót."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alamat tempat instans NextExplorer Anda terpasang. Untuk mengubahnya, keluar lalu tambahkan server lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'indirizzo dove è installata la tua istanza di NextExplorer. Per cambiarlo, esci e aggiungi di nuovo il server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer インスタンスがインストールされているアドレスです。変更するには、サインアウトしてサーバーを再度追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer 인스턴스가 설치된 주소입니다. 변경하려면 로그아웃한 후 서버를 다시 추가하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Adressen der NextExplorer-instansen din er installert. For å endre den må du logge ut og legge til serveren på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het adres waar je NextExplorer-instantie is geïnstalleerd. Om het te wijzigen, log uit en voeg de server opnieuw toe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Adres, pod którym zainstalowana jest Twoja instancja NextExplorer. Aby go zmienić, wyloguj się i dodaj serwer ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O endereço onde a sua instância do NextExplorer está instalada. Para o alterar, termine a sessão e adicione o servidor novamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O endereço onde sua instância do NextExplorer está instalada. Para alterá-lo, saia e adicione o servidor novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresa unde este instalată instanța ta NextExplorer. Pentru a o schimba, deconectează-te și adaugă serverul din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Адрес, по которому установлен ваш экземпляр NextExplorer. Чтобы изменить его, выйдите и добавьте сервер заново."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Adressen där din NextExplorer-instans är installerad. För att ändra den, logga ut och lägg till servern igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ที่อยู่ที่ติดตั้ง NextExplorer ของคุณ หากต้องการเปลี่ยน ให้ออกจากระบบแล้วเพิ่มเซิร์ฟเวอร์ใหม่อีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer örneğinizin kurulu olduğu adres. Değiştirmek için oturumu kapatıp sunucuyu yeniden ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Адреса, за якою встановлено ваш екземпляр NextExplorer. Щоб її змінити, вийдіть і додайте сервер знову."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Địa chỉ nơi phiên bản NextExplorer của bạn được cài đặt. Để thay đổi, hãy đăng xuất và thêm lại máy chủ."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "您的 NextExplorer 实例的安装地址。若要更改，请退出登录并重新添加服务器。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "您的 NextExplorer 執行個體的安裝位址。若要更改，請登出並重新加入伺服器。"
          }
        }
      }
    },
