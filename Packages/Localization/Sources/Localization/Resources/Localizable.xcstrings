    "folderSizeSettings.runningHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measures folders in the background, so their size shows in the list."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقيس المجلدات في الخلفية ليظهر حجمها في القائمة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Měří složky na pozadí, aby se jejich velikost zobrazila v seznamu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Måler mapper i baggrunden, så deres størrelse vises på listen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Misst Ordner im Hintergrund, damit ihre Größe in der Liste erscheint."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μετρά τους φακέλους στο παρασκήνιο, ώστε το μέγεθός τους να εμφανίζεται στη λίστα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mide las carpetas en segundo plano, para que su tamaño aparezca en la lista."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mittaa kansiot taustalla, jotta niiden koko näkyy luettelossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesure les dossiers en arrière-plan, pour que leur taille s'affiche dans la liste."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מודד תיקיות ברקע, כך שהגודל שלהן מוצג ברשימה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोल्डरों को पृष्ठभूमि में मापता है, ताकि उनका आकार सूची में दिखे।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Háttérben méri a mappákat, így a méretük megjelenik a listában."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengukur folder di latar belakang agar ukurannya muncul di daftar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Misura le cartelle in background, così la loro dimensione compare nell'elenco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックグラウンドでフォルダを測定し、サイズを一覧に表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더를 백그라운드에서 측정해 목록에 크기가 표시되도록 합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Måler mapper i bakgrunnen, slik at størrelsen vises i listen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meet mappen op de achtergrond, zodat hun grootte in de lijst verschijnt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mierzy foldery w tle, aby ich rozmiar pojawiał się na liście."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mede as pastas em segundo plano, para que o seu tamanho apareça na lista."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mede as pastas em segundo plano, para que o tamanho delas apareça na lista."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Măsoară dosarele în fundal, astfel încât dimensiunea lor să apară în listă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Измеряет папки в фоне, чтобы их размер отображался в списке."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mäter mappar i bakgrunden, så att deras storlek visas i listan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วัดโฟลเดอร์เบื้องหลัง เพื่อให้ขนาดแสดงในรายการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klasörleri arka planda ölçer, böylece boyutları listede görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вимірює папки у фоновому режимі, щоб їхній розмір показувався в списку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đo thư mục ở nền để kích thước của chúng hiển thị trong danh sách."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "在后台测量文件夹，使其大小显示在列表中。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "在背景測量資料夾，讓其大小顯示在清單中。"
          }
        }
      }
    },
