          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này chỉ xóa bản sao trên thiết bị. Tệp vẫn còn trên máy chủ."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "这仅会移除本地副本。文件仍保留在服务器上。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "這只會移除本機副本。檔案仍保留在伺服器上。"
          }
        }
      }
