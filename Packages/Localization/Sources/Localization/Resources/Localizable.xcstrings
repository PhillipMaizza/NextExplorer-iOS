    "userDetail.passwordSSOOnly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This user has no local password and signs in with SSO only."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
