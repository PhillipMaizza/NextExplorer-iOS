          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liian monta versiota puuttuu kerralla: mitään ei muutettu"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de versions introuvables d'un coup : rien n'a été modifié"
