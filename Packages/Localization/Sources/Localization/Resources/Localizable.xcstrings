    "userManagement.createGrantAdminSubtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full control over files, shares and users."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحكّم كامل في الملفات والمشاركات والمستخدمين."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Plná kontrola nad soubory, sdíleními a uživateli."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuld kontrol over filer, delinger og brugere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vollständige Kontrolle über Dateien, Freigaben und Benutzer."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πλήρης έλεγχος αρχείων, κοινοποιήσεων και χρηστών."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Control total sobre archivos, comparticiones y usuarios."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Täysi hallinta tiedostoihin, jakoihin ja käyttäjiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrôle total sur les fichiers, partages et utilisateurs."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שליטה מלאה בקבצים, בשיתופים ובמשתמשים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ाइलों, साझाकरण और उपयोगकर्ताओं पर पूर्ण नियंत्रण।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Teljes irányítás a fájlok, megosztások és felhasználók felett."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendali penuh atas file, berbagi, dan pengguna."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controllo completo su file, condivisioni e utenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイル、共有、ユーザを完全に制御できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일, 공유 및 사용자에 대한 전체 제어."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Full kontroll over filer, delinger og brukere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Volledige controle over bestanden, deellinks en gebruikers."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pełna kontrola nad plikami, udostępnieniami i użytkownikami."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlo total sobre ficheiros, partilhas e utilizadores."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Controle total sobre arquivos, compartilhamentos e usuários."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Control complet asupra fișierelor, partajărilor și utilizatorilor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полный контроль над файлами, ссылками и пользователями."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Full kontroll över filer, delningar och användare."
          }
        },
        "th": {
