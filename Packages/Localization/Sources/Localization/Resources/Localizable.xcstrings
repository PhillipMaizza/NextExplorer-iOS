          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For mange forespørsler. Prøv igjen om litt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te veel verzoeken. Probeer het zo dadelijk opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbyt wiele żądań. Spróbuj ponownie za chwilę."
