    "shareUpload.retrySignInBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to NextExplorer, then tap Retry again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدخول إلى NextExplorer، ثم اضغط على «إعادة المحاولة» مرة أخرى."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přihlaste se do NextExploreru a pak klepněte na Zkusit znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Log ind i NextExplorer, og tryk derefter på Prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich in NextExplorer an und tippe dann erneut auf „Erneut versuchen“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνδεθείτε στο NextExplorer και μετά πατήστε ξανά «Δοκιμή ξανά»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión en NextExplorer y vuelve a pulsar «Reintentar»."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjaudu sisään NextExploreriin ja napauta sitten Yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous à NextExplorer, puis touchez à nouveau « Réessayer »."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התחברו ל-NextExplorer, ואז הקישו שוב על \"ניסיון חוזר\"."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer में साइन इन करें, फिर दोबारा “पुनः प्रयास करें” पर टैप करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelentkezzen be a NextExplorerbe, majd koppintson újra az Újra gombra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masuk ke NextExplorer, lalu ketuk Coba Lagi sekali lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi a NextExplorer, poi tocca di nuovo “Riprova”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorerにサインインしてから、もう一度「再試行」をタップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer에 로그인한 다음 “재시도”를 다시 탭하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Logg inn i NextExplorer, og trykk deretter på Prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Log in bij NextExplorer en tik daarna opnieuw op ‘Opnieuw proberen’."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaloguj się w NextExplorer, a potem ponownie dotknij „Ponów”."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie sessão no NextExplorer e toque em “Tentar novamente”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre no NextExplorer e toque em “Tentar de novo” novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectează-te în NextExplorer, apoi atinge din nou „Reîncearcă”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите в NextExplorer, затем снова нажмите «Повторить»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Logga in i NextExplorer och tryck sedan på ”Försök igen” en gång till."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
