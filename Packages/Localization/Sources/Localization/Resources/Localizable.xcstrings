        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשרו גישה לתמונות בהגדרות כדי לשמור תמונות וסרטונים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चित्र और वीडियो सहेजने के लिए सेटिंग में फ़ोटो की अनुमति दें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Engedélyezze a Fotók elérését a Beállításokban a képek és videók mentéséhez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan akses ke Foto di Pengaturan untuk menyimpan gambar dan video."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti l’accesso a Foto in Impostazioni per salvare immagini e video."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像や動画を保存するには、設定で写真へのアクセスを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지와 비디오를 저장하려면 설정에서 사진 접근을 허용하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gi tilgang til Bilder i Innstillinger for å arkivere bilder og videoer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta in Instellingen toegang tot Foto’s toe om afbeeldingen en video’s te bewaren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól na dostęp do Zdjęć w Ustawieniach, aby zapisywać obrazy i filmy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso a Fotos nas Definições para guardar imagens e vídeos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso a Fotos em Ajustes para salvar imagens e vídeos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite accesul la Fotografii în Setări pentru a salva imagini și videoclipuri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите доступ к Фото в настройках, чтобы сохранять изображения и видео."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillåt åtkomst till Bilder i Inställningar för att spara bilder och videor."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตการเข้าถึงรูปภาพในการตั้งค่าเพื่อบันทึกรูปภาพและวิดีโอ"
