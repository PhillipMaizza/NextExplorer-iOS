    "thumbnailSettings.enableHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn off to serve full images everywhere instead."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أوقف التشغيل لعرض الصور الكاملة في كل مكان بدلاً من ذلك."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypněte, aby se místo toho všude zobrazovaly plné obrázky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå fra for i stedet at vise billeder i fuld størrelse overalt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deaktivieren, um stattdessen überall vollständige Bilder auszuliefern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απενεργοποιήστε το για να παρέχονται παντού οι εικόνες πλήρους μεγέθους."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactívalo para servir imágenes completas en todas partes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poista käytöstä, jos haluat tarjota täysikokoiset kuvat kaikkialla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivez pour servir partout les images complètes."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כבו כדי להציג תמונות מלאות בכל מקום במקום זאת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसके बजाय हर जगह पूरी छवियां देने के लिए बंद करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsolja ki, hogy ehelyett mindenhol teljes méretű képek legyenek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Matikan untuk menyajikan gambar penuh di mana saja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattiva per servire ovunque le immagini complete."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにすると、代わりにすべての場所でフル画像を提供します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끄면 모든 곳에서 전체 이미지를 제공합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå av for å vise bilder i full størrelse overalt i stedet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel uit om overal volledige afbeeldingen te tonen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyłącz, aby wszędzie serwować pełne obrazy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desative para servir imagens completas em todo o lado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desative para servir imagens completas em todo lugar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dezactivează pentru a servi peste tot imaginile complete."
          }
        },
        "ru": {
          "stringUnit": {
