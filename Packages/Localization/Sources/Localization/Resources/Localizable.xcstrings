    "settings.clearCacheMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This clears cached previews, thumbnails, and saved folder listings used offline. Nothing on the server is affected."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي هذا إلى مسح المعاينات والصور المصغّرة وقوائم المجلدات المحفوظة للاستخدام دون اتصال. لا يتأثر أي شيء على الخادم."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tím se vymažou uložené náhledy, miniatury a uložené výpisy složek používané offline. Na serveru se nic nemění."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette rydder cachede eksempelvisninger, miniaturer og gemte mappelister, der bruges offline. Intet på serveren påvirkes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies leert zwischengespeicherte Vorschauen, Miniaturen und offline gesicherte Ordnerlisten. Auf dem Server wird nichts berührt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό εκκαθαρίζει τις προεπισκοπήσεις, τις μικρογραφίες και τις αποθηκευμένες λίστες φακέλων που χρησιμοποιούνται εκτός σύνδεσης. Τίποτα στον διακομιστή δεν επηρεάζεται."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto borra las vistas previas, miniaturas y listados de carpetas guardados para el uso sin conexión. Nada en el servidor se ve afectado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä tyhjentää offline-käytössä olevat välimuistissa olevat esikatselut, pikkukuvat ja tallennetut kansioluettelot. Palvelimeen ei vaikuteta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela efface les aperçus, miniatures et listes de dossiers enregistrés pour une utilisation hors ligne. Rien n'est affecté sur le serveur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולה זו מנקה תצוגות מקדימות, תמונות ממוזערות ורשימות תיקיות שמורות המשמשות במצב לא מקוון. דבר בשרת לא מושפע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह ऑफ़लाइन उपयोग किए गए कैश किए गए पूर्वावलोकन, थंबनेल और सहेजी गई फ़ोल्डर सूचियां साफ़ करता है। सर्वर पर कुछ भी प्रभावित नहीं होता।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez törli a gyorsítótárazott előnézeteket, miniatűröket és az offline használt mentett mappalistákat. A kiszolgálón semmi sem változik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini membersihkan pratinjau, gambar mini, dan daftar folder tersimpan yang dipakai secara offline. Tidak ada yang terpengaruh di server."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo cancella anteprime, miniature ed elenchi di cartelle salvati per l'uso offline. Nulla sul server viene toccato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフラインで使用するキャッシュ済みのプレビュー、サムネール、保存済みフォルダリストを消去します。サーバー上のものには影響しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인에서 사용하는 캐시된 미리보기, 썸네일, 저장된 폴더 목록을 지웁니다. 서버의 데이터는 영향을 받지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette tømmer bufrede forhåndsvisninger, miniatyrbilder og lagrede mappelister som brukes frakoblet. Ingenting på serveren påvirkes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee worden gecachte voorbeelden, miniaturen en offline bewaarde mapoverzichten gewist. Niets op de server wordt beïnvloed."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to wyczyszczenie podglądów, miniatur i zapisanych list folderów używanych offline. Nic na serwerze nie zostaje naruszone."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto limpa pré-visualizações, miniaturas e listas de pastas guardadas para uso offline. Nada no servidor é afetado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto limpa pré-visualizações, miniaturas e listas de pastas salvas para uso offline. Nada no servidor é afetado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceasta golește previzualizările, miniaturile și listele de dosare salvate pentru utilizare offline. Nimic de pe server nu este afectat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это очистит кешированные превью, миниатюры и сохранённые списки папок для офлайн-режима. На сервере ничего не затрагивается."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta rensar cachade förhandsvisningar, miniatyrer och sparade mapplistor som används offline. Inget på servern påverkas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดำเนินการนี้จะล้างตัวอย่าง ภาพขนาดย่อ และรายการโฟลเดอร์ที่บันทึกไว้ซึ่งใช้ในโหมดออฟไลน์ ไม่มีสิ่งใดบนเซิร์ฟเวอร์ได้รับผลกระทบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem, çevrimdışı kullanılan önbelleğe alınmış önizlemeleri, küçük resimleri ve kayıtlı klasör listelerini temizler. Sunucudaki hiçbir şey etkilenmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це очистить кешовані попередні перегляди, мініатюри та збережені списки папок для офлайн-використання. Нічого на сервері не зміниться."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này xóa bản xem trước, ảnh thu nhỏ và danh sách thư mục đã lưu dùng khi ngoại tuyến. Không ảnh hưởng đến máy chủ."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "这会清除用于离线的缓存预览、缩略图和已保存的文件夹列表。服务器上的内容不受影响。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "這會清除用於離線的快取預覽、縮覽圖和已儲存的檔案夾列表。伺服器上的內容不受影響。"
          }
        }
      }
    },
