            "value": "Økten din har utløpt. Logg inn igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je sessie is verlopen. Meld je opnieuw aan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja sesja wygasła. Zaloguj się ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A sua sessão expirou. Inicie sessão novamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua sessão expirou. Entre novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesiunea ta a expirat. Conectează-te din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша сессия истекла. Войдите снова."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din session har gått ut. Logga in igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เซสชันของคุณหมดอายุ เข้าสู่ระบบอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturumunuzun süresi doldu. Yeniden oturum açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш сеанс завершився. Увійдіть знову."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên của bạn đã hết hạn. Hãy đăng nhập lại."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "您的会话已过期。请重新登录。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "您的工作階段已過期。請重新登入。"
          }
        }
      }
    },
    "error.timedOut": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server took too long to respond. The action may still complete."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استغرق الخادم وقتًا طويلًا للرد. قد يكتمل الإجراء مع ذلك."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Server odpovídal příliš dlouho. Akce se přesto může dokončit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveren var for længe om at svare. Handlingen kan stadig blive gennemført."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat zu lange nicht geantwortet. Die Aktion wird möglicherweise trotzdem abgeschlossen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο διακομιστής άργησε πολύ να απαντήσει. Η ενέργεια μπορεί να ολοκληρωθεί ακόμη."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor tardó demasiado en responder. Es posible que la acción aún se complete."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palvelin vastasi liian hitaasti. Toiminto voi silti onnistua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a mis trop de temps à répondre. L’action peut encore aboutir."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השרת התעכב יותר מדי בתגובה. ייתכן שהפעולה עדיין תושלם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्वर ने जवाब देने में बहुत देर लगा दी। कार्रवाई फिर भी पूरी हो सकती है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kiszolgáló túl sokáig válaszolt. A művelet még befejeződhet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Server terlalu lama merespons. Tindakan mungkin tetap selesai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server ha impiegato troppo tempo a rispondere. L’azione potrebbe comunque completarsi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーの応答に時間がかかりすぎました。操作はそのまま完了する場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버 응답이 너무 오래 걸렸습니다. 작업은 그래도 완료될 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveren brukte for lang tid på å svare. Handlingen kan likevel bli fullført."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De server deed er te lang over om te antwoorden. De actie kan alsnog slagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer zbyt długo nie odpowiadał. Akcja może się jeszcze zakończyć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor demorou demais a responder. A ação ainda pode ser concluída."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor demorou demais para responder. A ação ainda pode ser concluída."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Serverul a răspuns prea greu. Acțiunea se poate totuși finaliza."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер слишком долго не отвечал. Действие всё равно может завершиться."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Servern svarade för långsamt. Åtgärden kan ändå slutföras."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เซิร์ฟเวอร์ตอบกลับช้าเกินไป การดำเนินการอาจยังสำเร็จได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu yanıt vermekte çok gecikti. İşlem yine de tamamlanabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер надто довго відповідав. Дія все ще може завершитися."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy chủ phản hồi quá lâu. Thao tác vẫn có thể hoàn tất."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器响应时间过长。该操作仍可能完成。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器回應時間過長。該動作仍可能完成。"
          }
        }
      }
    },
