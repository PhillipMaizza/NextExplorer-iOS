        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιτρέψτε την πρόσβαση στις Φωτογραφίες από τις Ρυθμίσεις για να αποθηκεύετε εικόνες και βίντεο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
