    "twoFactor.recoveryIntro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each code works once if you lose your authenticator app. They won't be shown again, so store them somewhere safe."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل كل رمز مرة واحدة إذا فقدت تطبيق المصادقة. لن تُعرض مرة أخرى، لذا احفظها في مكان آمن."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý kód funguje jednou, pokud ztratíte ověřovací aplikaci. Znovu se nezobrazí, proto je uložte na bezpečné místo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver kode virker én gang, hvis du mister din godkendelsesapp. De vises ikke igen, så opbevar dem et sikkert sted."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Code funktioniert einmal, falls du deine Authenticator-App verlierst. Sie werden nicht noch einmal angezeigt, bewahre sie also an einem sicheren Ort auf."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε κωδικός λειτουργεί μία φορά αν χάσετε την εφαρμογή ελέγχου ταυτότητας. Δεν θα εμφανιστούν ξανά, γι' αυτό φυλάξτε τους σε ασφαλές μέρος."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada código funciona una vez si pierdes tu app de autenticación. No se volverán a mostrar, así que guárdalos en un lugar seguro."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokainen koodi toimii kerran, jos menetät todennussovelluksesi. Niitä ei näytetä uudelleen, joten säilytä ne turvallisessa paikassa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque code ne fonctionne qu'une fois si vous perdez votre app d'authentification. Ils ne seront plus affichés, conservez-les donc en lieu sûr."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל קוד פועל פעם אחת אם תאבדו את אפליקציית האימות. הם לא יוצגו שוב, לכן שמרו אותם במקום בטוח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर आपका ऑथेंटिकेटर ऐप खो जाए तो हर कोड एक बार काम करता है। ये दोबारा नहीं दिखाए जाएंगे, इसलिए इन्हें किसी सुरक्षित जगह रखें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden kód egyszer használható, ha elveszíti a hitelesítő alkalmazást. Nem jelennek meg újra, ezért őrizze meg őket biztonságos helyen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap kode hanya berfungsi sekali jika Anda kehilangan aplikasi autentikator. Kode tidak akan ditampilkan lagi, jadi simpan di tempat aman."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni codice funziona una sola volta se perdi la tua app di autenticazione. Non verranno mostrati di nuovo, quindi conservali in un posto sicuro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証アプリを紛失した場合に、各コードを1回ずつ使えます。再表示されないため、安全な場所に保管してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증 앱을 잃어버렸을 때 각 코드를 한 번씩 사용할 수 있습니다. 다시 표시되지 않으니 안전한 곳에 보관하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver kode fungerer én gang hvis du mister autentiseringsappen. De vises ikke igjen, så oppbevar dem på et trygt sted."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke code werkt één keer als je je authenticatie-app kwijtraakt. Ze worden niet opnieuw getoond, dus bewaar ze op een veilige plek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy kod działa raz, jeśli utracisz aplikację uwierzytelniającą. Nie będą wyświetlane ponownie, więc zapisz je w bezpiecznym miejscu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada código funciona uma vez se perder a sua aplicação de autenticação. Não voltarão a ser apresentados, por isso guarde-os num local seguro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada código funciona uma vez se você perder seu app autenticador. Eles não serão exibidos novamente, então guarde-os em um lugar seguro."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare cod funcționează o singură dată dacă pierzi aplicația de autentificare. Nu vor mai fi afișate, așa că păstrează-le într-un loc sigur."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый код работает один раз, если вы потеряете приложение-аутентификатор. Они больше не будут показаны, поэтому сохраните их в надёжном месте."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje kod fungerar en gång om du förlorar din autentiseringsapp. De visas inte igen, så förvara dem på ett säkert ställe."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แต่ละรหัสใช้ได้ครั้งเดียวหากคุณทำแอปยืนยันตัวตนหาย รหัสจะไม่แสดงอีก ดังนั้นโปรดเก็บไว้ในที่ปลอดภัย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimlik doğrulayıcı uygulamanızı kaybederseniz her kod yalnızca bir kez işe yarar. Bir daha gösterilmeyecekler, bu yüzden güvenli bir yerde saklayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен код спрацьовує один раз, якщо ви втратите застосунок-автентифікатор. Їх більше не буде показано, тож збережіть у надійному місці."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi mã chỉ dùng được một lần nếu bạn mất ứng dụng xác thực. Mã sẽ không hiển thị lại, nên hãy lưu ở nơi an toàn."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "如果您丢失验证器 App，每个恢复码可使用一次。它们不会再次显示，请妥善保存。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "如果您遺失驗證器 App，每組復原碼可使用一次。它們不會再次顯示，請妥善保存。"
          }
        }
      }
    },
