    "serverSettings.featureOffHowTo": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To turn it on, set %@ and restart the container."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لتفعيلها، اضبط %@ وأعد تشغيل الحاوية."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete-li ji zapnout, nastavte %@ a restartujte kontejner."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For at slå den til skal du angive %@ og genstarte containeren."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Aktivieren setze %@ und starte den Container neu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για να την ενεργοποιήσετε, ορίστε το %@ και κάντε επανεκκίνηση του κοντέινερ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para activarla, define %@ y reinicia el contenedor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ota se käyttöön asettamalla %@ ja käynnistämällä säiliö uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour l’activer, définissez %@ et redémarrez le conteneur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי להפעיל אותה, הגדירו את %@ והפעילו מחדש את הקונטיינר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे चालू करने के लिए %@ सेट करें और कंटेनर को रीस्टार्ट करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A bekapcsoláshoz állítsa be a(z) %@ értékét, és indítsa újra a konténert."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk mengaktifkannya, setel %@ lalu mulai ulang kontainer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per attivarla, imposta %@ e riavvia il container."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにするには、%@ を設定してコンテナを再起動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜려면 %@ 값을 설정하고 컨테이너를 다시 시작하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For å slå den på må du angi %@ og starte containeren på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel %@ in en herstart de container om dit in te schakelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby ją włączyć, ustaw %@ i uruchom ponownie kontener."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para a ativar, defina %@ e reinicie o contentor."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ativá-lo, defina %@ e reinicie o contêiner."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a o activa, setează %@ și repornește containerul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы включить её, задайте %@ и перезапустите контейнер."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För att aktivera den, ställ in %@ och starta om containern."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากต้องการเปิด ให้ตั้งค่า %@ แล้วรีสตาร์ตคอนเทนเนอร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açmak için %@ değerini ayarlayıp kapsayıcıyı yeniden başlatın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб увімкнути її, задайте %@ і перезапустіть контейнер."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để bật, hãy đặt %@ và khởi động lại container."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "要启用它，请设置 %@ 并重启容器。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "若要啟用，請設定 %@ 並重新啟動容器。"
          }
        }
      }
    },
    "serverSettings.featureOffKept": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you configure here is saved and applies as soon as it is enabled."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما تضبطه هنا يُحفظ ويُطبَّق بمجرد تفعيلها."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Co zde nastavíte, se uloží a použije se, jakmile funkci zapnete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det, du konfigurerer her, gemmes og gælder, så snart den slås til."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was du hier einstellst, wird gespeichert und gilt, sobald die Funktion aktiviert ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ό,τι ρυθμίσετε εδώ αποθηκεύεται και ισχύει μόλις ενεργοποιηθεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que configures aquí se guarda y se aplica en cuanto se active."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Täällä määrittämäsi asiat tallennetaan, ja ne tulevat voimaan heti, kun ominaisuus otetaan käyttöön."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que vous configurez ici est enregistré et s’applique dès l’activation."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מה שתגדירו כאן נשמר ויחול מיד כשהתכונה תופעל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ आप जो भी कॉन्फ़िगर करते हैं वह सहेजा जाता है और चालू होते ही लागू हो जाता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amit itt beállít, az mentésre kerül, és a funkció bekapcsolásakor azonnal érvénybe lép."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang Anda konfigurasikan di sini disimpan dan berlaku segera setelah fitur diaktifkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò che configuri qui viene salvato e si applica non appena la funzione viene attivata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここで設定した内容は保存され、有効にするとすぐに適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서 설정한 내용은 저장되며 활성화되는 즉시 적용됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det du konfigurerer her, lagres og gjelder så snart den slås på."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat je hier instelt, wordt opgeslagen en geldt zodra de functie is ingeschakeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To, co tutaj skonfigurujesz, zostanie zapisane i zacznie obowiązywać po włączeniu funkcji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O que configurar aqui é guardado e aplica-se assim que for ativada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que você configurar aqui é salvo e se aplica assim que o recurso for ativado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce configurezi aici este salvat și se aplică imediat ce funcția este activată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё, что вы настроите здесь, сохраняется и начнёт действовать, как только функция будет включена."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det du ställer in här sparas och gäller så snart funktionen aktiveras."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิ่งที่คุณกำหนดค่าที่นี่จะถูกบันทึกและมีผลทันทีเมื่อเปิดใช้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Burada yapılandırdığınız her şey kaydedilir ve özellik etkinleştirilir etkinleştirilmez uygulanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе, що ви налаштуєте тут, зберігається й почне діяти, щойно функцію буде ввімкнено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những gì bạn cấu hình ở đây được lưu và áp dụng ngay khi tính năng được bật."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "你在此处配置的内容会被保存，并在启用后立即生效。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "你在此處設定的內容會被儲存，並在啟用後立即生效。"
          }
        }
      }
    },
    "serverSettings.featureOffTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This feature is not enabled"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه الميزة غير مفعّلة"
          }
