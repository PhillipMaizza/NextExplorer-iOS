    "twoFactor.passwordNewCodesIntro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your password to replace your recovery codes. The old ones stop working."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل كلمة السر لاستبدال رموز الاسترداد. ستتوقف الرموز القديمة عن العمل."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadejte heslo, abyste nahradili záložní kódy. Staré přestanou fungovat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indtast din adgangskode for at erstatte dine gendannelseskoder. De gamle holder op med at virke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib dein Passwort ein, um deine Wiederherstellungscodes zu ersetzen. Die alten funktionieren dann nicht mehr."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εισαγάγετε τον κωδικό πρόσβασής σας για να αντικαταστήσετε τους κωδικούς ανάκτησης. Οι παλιοί σταματούν να λειτουργούν."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce tu contraseña para reemplazar tus códigos de recuperación. Los antiguos dejarán de funcionar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Syötä salasanasi korvataksesi palautuskoodisi. Vanhat lakkaavat toimimasta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez votre mot de passe pour remplacer vos codes de récupération. Les anciens cessent de fonctionner."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הזינו את הסיסמה כדי להחליף את קודי השחזור. הישנים מפסיקים לעבוד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने रिकवरी कोड बदलने के लिए अपना पासवर्ड दर्ज करें। पुराने कोड काम करना बंद कर देंगे।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adja meg a jelszavát a helyreállítási kódok cseréjéhez. A régiek megszűnnek működni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan kata sandi Anda untuk mengganti kode pemulihan. Kode lama berhenti berfungsi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci la password per sostituire i codici di recupero. Quelli vecchi smettono di funzionare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リカバリーコードを置き換えるにはパスワードを入力してください。古いコードは使えなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복구 코드를 교체하려면 비밀번호를 입력하세요. 기존 코드는 더 이상 작동하지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv inn passordet ditt for å erstatte gjenopprettingskodene. De gamle slutter å virke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer je wachtwoord in om je herstelcodes te vervangen. De oude werken dan niet meer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz hasło, aby wymienić kody odzyskiwania. Stare przestaną działać."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduza a sua palavra-passe para substituir os códigos de recuperação. Os antigos deixam de funcionar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite sua senha para substituir seus códigos de recuperação. Os antigos deixam de funcionar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Introdu parola pentru a-ți înlocui codurile de recuperare. Cele vechi nu vor mai funcționa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите пароль, чтобы заменить резервные коды. Старые перестанут работать."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange ditt lösenord för att ersätta dina återställningskoder. De gamla slutar fungera."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ป้อนรหัสผ่านของคุณเพื่อแทนที่รหัสกู้คืน รหัสเก่าจะหยุดทำงาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurtarma kodlarınızı değiştirmek için parolanızı girin. Eskileri çalışmayı durdurur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть пароль, щоб замінити коди відновлення. Старі перестануть працювати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập mật khẩu để thay mã khôi phục. Các mã cũ sẽ ngừng hoạt động."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "输入您的密码以替换恢复码。旧的恢复码将失效。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入您的密碼以取代復原碼。舊的復原碼將失效。"
          }
        }
      }
    },
    "twoFactor.passwordTurnOffIntro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your password to turn off two-factor authentication."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل كلمة السر لإيقاف المصادقة الثنائية."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadejte heslo, abyste vypnuli dvoufázové ověření."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indtast din adgangskode for at slå tofaktorgodkendelse fra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib dein Passwort ein, um die Zwei-Faktor-Authentifizierung auszuschalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εισαγάγετε τον κωδικό πρόσβασής σας για να απενεργοποιήσετε τον έλεγχο ταυτότητας δύο παραγόντων."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce tu contraseña para desactivar la autenticación en dos pasos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Syötä salasanasi poistaaksesi kaksivaiheisen tunnistautumisen käytöstä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez votre mot de passe pour désactiver l'authentification à deux facteurs."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הזינו את הסיסמה כדי לכבות את האימות הדו-שלבי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दो-चरणीय प्रमाणीकरण बंद करने के लिए अपना पासवर्ड दर्ज करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adja meg a jelszavát a kétlépcsős hitelesítés kikapcsolásához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan kata sandi Anda untuk mematikan autentikasi dua faktor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci la password per disattivare l'autenticazione a due fattori."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2 要素認証をオフにするにはパスワードを入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "2단계 인증을 끄려면 비밀번호를 입력하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv inn passordet ditt for å slå av tofaktorautentisering."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer je wachtwoord in om tweestapsverificatie uit te schakelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz hasło, aby wyłączyć uwierzytelnianie dwuskładnikowe."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduza a sua palavra-passe para desativar a autenticação de dois fatores."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite sua senha para desativar a autenticação de dois fatores."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Introdu parola pentru a dezactiva autentificarea în doi pași."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите пароль, чтобы выключить двухфакторную аутентификацию."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange ditt lösenord för att slå av tvåfaktorsautentisering."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ป้อนรหัสผ่านของคุณเพื่อปิดการยืนยันตัวตนสองขั้นตอน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki faktörlü kimlik doğrulamayı kapatmak için parolanızı girin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть пароль, щоб вимкнути двофакторну автентифікацію."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập mật khẩu để tắt xác thực hai yếu tố."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
