          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta tar bara bort den lokala kopian. Filen finns kvar på servern."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดำเนินการนี้จะนำออกเฉพาะสำเนาในเครื่อง ไฟล์ยังอยู่บนเซิร์ฟเวอร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yalnızca yerel kopyayı kaldırır. Dosya sunucuda kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
