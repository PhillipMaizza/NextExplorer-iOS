    "permissions.ownershipNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing ownership usually needs root or admin privileges on the server."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عادةً ما يتطلب تغيير الملكية صلاحيات الجذر أو المسؤول على الخادم."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změna vlastnictví obvykle vyžaduje na serveru práva roota nebo správce."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ændring af ejerskab kræver normalt root- eller administratorrettigheder på serveren."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ändern des Eigentums erfordert auf dem Server meist Root- oder Administratorrechte."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αλλαγή ιδιοκτησίας απαιτεί συνήθως δικαιώματα root ή διαχειριστή στον διακομιστή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar la propiedad suele requerir privilegios de root o de administrador en el servidor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Omistajuuden muuttaminen vaatii yleensä root- tai ylläpitäjän oikeudet palvelimella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changer la propriété nécessite généralement des privilèges root ou administrateur sur le serveur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שינוי בעלות דורש בדרך כלל הרשאות root או מנהל מערכת בשרת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वामित्व बदलने के लिए आमतौर पर सर्वर पर रूट या व्यवस्थापक विशेषाधिकार की आवश्यकता होती है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tulajdonjog módosításához általában root vagy rendszergazdai jogosultság kell a kiszolgálón."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengubah kepemilikan biasanya memerlukan hak akses root atau admin di server."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiare la proprietà di solito richiede privilegi di root o di amministratore sul server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "所有権の変更には通常、サーバー上の root または管理者権限が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소유권을 변경하려면 보통 서버에서 root 또는 관리자 권한이 필요합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å endre eierskap krever vanligvis root- eller administratorrettigheter på serveren."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eigendom wijzigen vereist meestal root- of beheerdersrechten op de server."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiana własności zwykle wymaga uprawnień roota lub administratora na serwerze."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterar a propriedade normalmente requer privilégios de root ou de administrador no servidor."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterar a propriedade normalmente requer privilégios de root ou de administrador no servidor."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Schimbarea proprietății necesită de obicei privilegii de root sau administrator pe server."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменение владельца обычно требует прав root или администратора на сервере."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att ändra ägarskap kräver oftast root- eller administratörsbehörighet på servern."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเปลี่ยนความเป็นเจ้าของมักต้องใช้สิทธิ์ root หรือผู้ดูแลระบบบนเซิร์ฟเวอร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sahipliği değiştirmek genellikle sunucuda root veya yönetici ayrıcalıkları gerektirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для зміни власника зазвичай потрібні права root або адміністратора на сервері."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đổi quyền sở hữu thường cần quyền root hoặc quản trị trên máy chủ."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "更改所有权通常需要服务器上的 root 或管理员权限。"
          }
        },
        "zh-TW": {
          "stringUnit": {
