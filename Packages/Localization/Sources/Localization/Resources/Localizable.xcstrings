          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te veel verzoeken. Probeer het zo dadelijk opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbyt wiele żądań. Spróbuj ponownie za chwilę."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiados pedidos. Tente novamente em breve."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Prea multe cereri. Încearcă din nou în scurt timp."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком много запросов. Повторите попытку позже."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För många förfrågningar. Försök igen strax."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "请求过多。请稍后重试。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "請求過多。請稍後重試。"
          }
