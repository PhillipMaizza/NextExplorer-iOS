    "userDetail.removeVolumeMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is unassigned from this user. The directory itself is untouched."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إلغاء تعيين %@ من هذا المستخدم. لا يتأثر الدليل نفسه."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ již není tomuto uživateli přiřazen. Samotný adresář se nemění."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er ikke længere tildelt denne bruger. Selve mappen berøres ikke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird von diesem Benutzer entfernt. Das Verzeichnis selbst wird nicht berührt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εκχώρηση του %@ σε αυτόν τον χρήστη καταργείται. Ο ίδιος ο κατάλογος δεν επηρεάζεται."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se desasigna de este usuario. El directorio en sí no se toca."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ei ole enää määritetty tälle käyttäjälle. Itse hakemistoon ei kosketa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est retiré de cet utilisateur. Le répertoire lui-même n'est pas touché."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ אינו מוקצה עוד למשתמש הזה. הספרייה עצמה לא נפגעת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ इस उपयोगकर्ता से अनिर्दिष्ट किया जाता है। निर्देशिका स्वयं अछूती रहती है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) %@ hozzárendelése megszűnt ennél a felhasználónál. Magát a könyvtárat nem érinti."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tidak lagi ditetapkan untuk pengguna ini. Direktori itu sendiri tidak terpengaruh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ viene rimosso da questo utente. La directory non viene toccata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はこのユーザから割り当て解除されます。ディレクトリ自体には影響しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 이 사용자에서 할당 해제됩니다. 디렉터리 자체는 영향을 받지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er ikke lenger tildelt denne brukeren. Selve mappen berøres ikke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wordt van deze gebruiker losgekoppeld. De map zelf blijft ongemoeid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ zostaje odpięty od tego użytkownika. Sam katalog nie zostaje naruszony."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ é desatribuído deste utilizador. O diretório em si não é afetado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ é desvinculado deste usuário. O diretório em si não é afetado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ este dezatribuit de la acest utilizator. Directorul în sine nu este afectat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ отвязывается от этого пользователя. Сам каталог не затрагивается."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ avtilldelas från den här användaren. Själva katalogen rörs inte."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ไม่ได้ถูกกำหนดให้ผู้ใช้นี้อีกต่อไป ตัวไดเรกทอรีเองไม่ได้รับผลกระทบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bu kullanıcıdan çıkarıldı. Dizinin kendisine dokunulmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ більше не призначено цьому користувачеві. Сам каталог не змінюється."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ không còn được gán cho người dùng này. Bản thân thư mục không bị ảnh hưởng."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已从此用户取消分配。目录本身不受影响。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已從此使用者取消指派。目錄本身不受影響。"
          }
        }
      }
    },
