    "apiTokens.limitReached": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have reached the limit of %lld tokens. Revoke one to create another."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وصلت إلى الحد الأقصى وهو %lld رمز. أبطل رمزًا لإنشاء آخر."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosáhli jste limitu tokenů: %lld. Odvolejte jeden, abyste mohli vytvořit další."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har nået grænsen på %lld tokens. Tilbagekald ét for at oprette et andet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast das Limit von %lld Tokens erreicht. Widerrufe einen, um einen weiteren zu erstellen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έχετε φτάσει το όριο των %lld διακριτικών. Ανακαλέστε ένα για να δημιουργήσετε άλλο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has alcanzado el límite de %lld tokens. Revoca uno para crear otro."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olet saavuttanut %lld tunnuksen rajan. Peru yksi luodaksesi toisen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez atteint la limite de %lld jetons. Révoquez-en un pour en créer un autre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגעתם למגבלה של %lld אסימונים. בטלו אחד כדי ליצור אחר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप %lld टोकन की सीमा तक पहुंच गए हैं। दूसरा बनाने के लिए एक को रद्द करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elérte a(z) %lld tokenes korlátot. Vonjon vissza egyet egy újabb létrehozásához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda telah mencapai batas %lld token. Cabut satu untuk membuat yang lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai raggiunto il limite di %lld token. Revocane uno per crearne un altro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トークンの上限 %lld 個に達しました。別のトークンを作成するには、どれかを失効させてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "토큰 한도 %lld개에 도달했습니다. 다른 토큰을 만들려면 하나를 폐기하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har nådd grensen på %lld tokens. Trekk tilbake ett for å opprette et nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt de limiet van %lld tokens bereikt. Trek er een in om een nieuw token te maken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Osiągnięto limit tokenów: %lld. Unieważnij jeden, aby utworzyć kolejny."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atingiu o limite de %lld tokens. Revogue um para criar outro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você atingiu o limite de %lld tokens. Revogue um para criar outro."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai atins limita de %lld tokenuri. Revocă unul pentru a crea altul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Достигнут лимит в %lld токенов. Отзовите один, чтобы создать новый."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har nått gränsen på %lld tokens. Återkalla en för att skapa en ny."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณถึงขีดจำกัด %lld โทเคนแล้ว เพิกถอนหนึ่งโทเคนเพื่อสร้างโทเคนอื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld belirteç sınırına ulaştınız. Başka birini oluşturmak için bir tanesini geçersiz kılın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви досягли ліміту токенів: %lld. Відкличте один, щоб створити інший."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã đạt giới hạn %lld token. Hãy thu hồi một token để tạo token khác."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "您已达到 %lld 个令牌的上限。请撤销一个后再创建。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "您已達到 %lld 個權杖的上限。請撤銷一個後再建立。"
          }
        }
      }
    },
