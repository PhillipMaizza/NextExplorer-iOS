    "apiTokens.revokeMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anything using \"%@\" will stop working right away. This can't be undone."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتوقف كل ما يستخدم ‏«%@» عن العمل فورًا. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vše, co používá \"%@\", okamžitě přestane fungovat. Tuto akci nelze vrátit zpět."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt, der bruger \"%@\", holder straks op med at virke. Dette kan ikke fortrydes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was „%@“ verwendet, funktioniert sofort nicht mehr. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ό,τι χρησιμοποιεί το \"%@\" θα σταματήσει να λειτουργεί αμέσως. Αυτό δεν μπορεί να αναιρεθεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que use “%@” dejará de funcionar de inmediato. Esta acción no se puede deshacer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki, mikä käyttää tunnusta \"%@\", lakkaa toimimasta heti. Tätä ei voi kumota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce qui utilise « %@ » cessera de fonctionner immédiatement. Cette action est irréversible."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל מה שמשתמש ב-\"%@\" יפסיק לעבוד מיד. לא ניתן לבטל פעולה זו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” का इस्तेमाल करने वाली हर चीज़ तुरंत काम करना बंद कर देगी। इसे पूर्ववत नहीं किया जा सकता।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden, ami a(z) \"%@\" tokent használja, azonnal leáll. Ez nem vonható vissza."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa pun yang memakai \"%@\" akan langsung berhenti berfungsi. Tindakan ini tidak dapat dibatalkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto ciò che usa “%@” smetterà di funzionare subito. Questa azione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」を使っているものはすべてすぐに動作しなくなります。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”을(를) 사용하는 모든 항목이 즉시 작동을 멈춥니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt som bruker «%@», slutter å virke med en gang. Dette kan ikke angres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles wat “%@” gebruikt, werkt meteen niet meer. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko, co używa „%@”, natychmiast przestanie działać. Tej operacji nie można cofnąć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que utilize “%@” deixará de funcionar de imediato. Esta ação não pode ser anulada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que usa “%@” vai parar de funcionar imediatamente. Isso não pode ser desfeito."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tot ce folosește „%@” va înceta să funcționeze imediat. Acțiunea nu poate fi anulată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё, что использует «%@», сразу перестанет работать. Это действие нельзя отменить."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt som använder ”%@” slutar fungera direkt. Det går inte att ångra."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกสิ่งที่ใช้ \"%@\" จะหยุดทำงานทันที ไม่สามารถเลิกทำได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" kullanan her şey hemen çalışmayı durdurur. Bu işlem geri alınamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе, що використовує \"%@\", одразу перестане працювати. Цю дію не можна скасувати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi thứ đang dùng \"%@\" sẽ ngừng hoạt động ngay. Không thể hoàn tác."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "所有使用“%@”的内容将立即停止工作。此操作无法撤销。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "所有使用「%@」的項目將立即停止運作。此操作無法還原。"
          }
        }
      }
    },
