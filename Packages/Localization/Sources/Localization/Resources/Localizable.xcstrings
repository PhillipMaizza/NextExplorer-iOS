    "userManagement.setPasswordSetIntro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give %@ a local password so they can sign in without SSO."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امنح %@ كلمة سر محلية ليتمكن من تسجيل الدخول دون SSO."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejte uživateli %@ místní heslo, aby se mohl přihlašovat bez SSO."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Giv %@ en lokal adgangskode, så vedkommende kan logge ind uden SSO."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib %@ ein lokales Passwort, damit die Anmeldung ohne SSO möglich ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δώστε στον χρήστη %@ έναν τοπικό κωδικό πρόσβασης ώστε να μπορεί να συνδεθεί χωρίς SSO."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dale a %@ una contraseña local para que pueda iniciar sesión sin SSO."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anna käyttäjälle %@ paikallinen salasana, jotta hän voi kirjautua ilman SSO:ta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donnez à %@ un mot de passe local pour qu'il puisse se connecter sans SSO."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תנו ל-%@ סיסמה מקומית כדי שיוכל להתחבר בלי SSO."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ को स्थानीय पासवर्ड दें ताकि वे SSO के बिना साइन इन कर सकें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjon a(z) %@ felhasználónak helyi jelszót, hogy SSO nélkül is be tudjon jelentkezni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berikan kata sandi lokal kepada %@ agar dapat masuk tanpa SSO."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Assegna a %@ una password locale così può accedere senza SSO."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SSO なしでサインインできるように、%@ にローカルパスワードを設定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) SSO 없이 로그인할 수 있도록 로컬 비밀번호를 부여하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gi %@ et lokalt passord slik at vedkommende kan logge inn uten SSO."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef %@ een lokaal wachtwoord zodat aanmelden zonder SSO mogelijk is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadaj użytkownikowi %@ hasło lokalne, aby mógł logować się bez SSO."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dê a %@ uma palavra-passe local para poder iniciar sessão sem SSO."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dê a %@ uma senha local para poder entrar sem SSO."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dă-i lui %@ o parolă locală pentru a se putea conecta fără SSO."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задайте пользователю %@ локальный пароль, чтобы он мог входить без SSO."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ge %@ ett lokalt lösenord så att inloggning utan SSO blir möjlig."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ให้รหัสผ่านภายในแก่ %@ เพื่อให้เข้าสู่ระบบได้โดยไม่ต้องใช้ SSO"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kullanıcısına SSO olmadan oturum açabilmesi için yerel bir parola verin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дайте користувачеві %@ локальний пароль, щоб він міг входити без SSO."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cấp cho %@ một mật khẩu cục bộ để họ có thể đăng nhập mà không cần SSO."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "为 %@ 设置本地密码，以便无需 SSO 即可登录。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "為 %@ 設定本機密碼，以便無需 SSO 即可登入。"
          }
        }
      }
    },
