    "settings.uploadDefaultsFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos and files you share to NextExplorer from other apps start in this folder. With Upload Without Asking on, they upload straight there."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبدأ الصور والملفات التي تشاركها مع NextExplorer من التطبيقات الأخرى في هذا المجلد. عند تفعيل الرفع دون سؤال، تُرفع إليه مباشرة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotky a soubory, které sdílíte do NextExploreru z jiných aplikací, začínají v této složce. Když je zapnuto Nahrát bez ptaní, nahrají se přímo sem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos og filer, du deler til NextExplorer fra andre apps, starter i denne mappe. Når Upload uden at spørge er slået til, uploades de direkte dertil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos und Dateien, die du aus anderen Apps mit NextExplorer teilst, beginnen in diesem Ordner. Mit „Ohne Nachfrage hochladen“ werden sie direkt dorthin hochgeladen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι φωτογραφίες και τα αρχεία που κοινοποιείτε στο NextExplorer από άλλες εφαρμογές ξεκινούν σε αυτόν τον φάκελο. Όταν η «Μεταφόρτωση χωρίς ερώτηση» είναι ενεργή, μεταφορτώνονται απευθείας εκεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos y archivos que compartes con NextExplorer desde otras apps empiezan en esta carpeta. Con Subir sin preguntar activado, se suben directamente allí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valokuvat ja tiedostot, joita jaat NextExploreriin muista sovelluksista, alkavat tästä kansiosta. Kun Lähetä kysymättä on päällä, ne lähetetään suoraan sinne."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos et fichiers que vous partagez avec NextExplorer depuis d’autres apps commencent dans ce dossier. Avec Envoyer sans demander, ils y sont envoyés directement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תמונות וקבצים שאתם משתפים ל-NextExplorer מאפליקציות אחרות מתחילים בתיקייה הזו. כשהאפשרות \"העלאה ללא שאלה\" פועלת, הם מועלים ישירות אליה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दूसरे ऐप्स से NextExplorer पर शेयर की गई फ़ोटो और फ़ाइलें इसी फ़ोल्डर से शुरू होती हैं। बिना पूछे अपलोड करें चालू होने पर वे सीधे यहीं अपलोड होती हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A más alkalmazásokból a NextExplorerbe megosztott fényképek és fájlok ebben a mappában kezdődnek. Ha a „Feltöltés rákérdezés nélkül” be van kapcsolva, közvetlenül ide kerülnek feltöltésre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto dan file yang Anda bagikan ke NextExplorer dari aplikasi lain dimulai di folder ini. Dengan Unggah Tanpa Bertanya aktif, file langsung diunggah ke sana."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le foto e i file che condividi con NextExplorer da altre app partono da questa cartella. Con Carica senza chiedere attivo, vengono caricati direttamente lì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのアプリからNextExplorerに共有した写真やファイルは、このフォルダから始まります。「確認せずにアップロード」をオンにすると、そのままここにアップロードされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 앱에서 NextExplorer로 공유한 사진과 파일은 이 폴더에서 시작합니다. 묻지 않고 업로드를 켜면 바로 이곳에 업로드됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilder og filer du deler til NextExplorer fra andre apper, starter i denne mappen. Når Last opp uten å spørre er på, lastes de opp direkte dit."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto’s en bestanden die je vanuit andere apps met NextExplorer deelt, beginnen in deze map. Met Uploaden zonder te vragen aan gaan ze er direct naartoe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdjęcia i pliki udostępniane do NextExplorer z innych aplikacji trafiają najpierw do tego folderu. Gdy włączysz Przesyłaj bez pytania, zostaną przesłane prosto tam."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As fotos e os ficheiros que partilha com o NextExplorer a partir de outras apps começam nesta pasta. Com Enviar sem perguntar ativado, são enviados diretamente para lá."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos e arquivos que você compartilha com o NextExplorer a partir de outros apps começam nesta pasta. Com Enviar sem perguntar ativado, eles vão direto para lá."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografiile și fișierele pe care le partajezi cu NextExplorer din alte aplicații pornesc din acest dosar. Cu Încarcă fără să întrebe activat, ajung direct acolo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото и файлы, которыми вы делитесь с NextExplorer из других приложений, начинают с этой папки. Если включено «Загружать без вопросов», они сразу загружаются туда."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilder och filer du delar till NextExplorer från andra appar börjar i den här mappen. Med Ladda upp utan att fråga påslaget hamnar de direkt där."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปภาพและไฟล์ที่คุณแชร์ไปยัง NextExplorer จากแอปอื่นจะเริ่มต้นในโฟลเดอร์นี้ เมื่อเปิด “อัปโหลดโดยไม่ถาม” ไฟล์จะถูกอัปโหลดไปที่นั่นโดยตรง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer uygulamalardan NextExplorer'a paylaştığınız fotoğraflar ve dosyalar bu klasörde başlar. Sormadan Yükle açıkken doğrudan buraya yüklenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото й файли, якими ви ділитеся з NextExplorer з інших застосунків, починаються в цій папці. Коли ввімкнено «Вивантажувати без запитання», вони вивантажуються прямо туди."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh và tệp bạn chia sẻ đến NextExplorer từ ứng dụng khác sẽ bắt đầu ở thư mục này. Khi bật Tải lên không cần hỏi, chúng được tải thẳng lên đó."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "你从其他 App 共享到 NextExplorer 的照片和文件会从这个文件夹开始。打开“上传时不询问”后，它们会直接上传到这里。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "你從其他 App 分享到 NextExplorer 的照片與檔案會從這個資料夾開始。開啟「上傳時不詢問」後，它們會直接上傳到這裡。"
          }
        }
      }
    },
