    "downloads.deleteBulkMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This only removes the local copies. The files stay on the server."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا يزيل النسخ المحلية فقط. تبقى الملفات على الخادم."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tím se odeberou pouze místní kopie. Soubory zůstanou na serveru."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette fjerner kun de lokale kopier. Filerne forbliver på serveren."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies entfernt nur die lokalen Kopien. Die Dateien bleiben auf dem Server."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό αφαιρεί μόνο τα τοπικά αντίγραφα. Τα αρχεία παραμένουν στον διακομιστή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto solo elimina las copias locales. Los archivos permanecen en el servidor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä poistaa vain paikalliset kopiot. Tiedostot säilyvät palvelimella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime uniquement les copies locales. Les fichiers restent sur le serveur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולה זו מסירה רק את העותקים המקומיים. הקבצים נשארים בשרת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह केवल स्थानीय प्रतियां हटाता है। फ़ाइलें सर्वर पर बनी रहती हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez csak a helyi másolatokat távolítja el. A fájlok a kiszolgálón maradnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini hanya menghapus salinan lokal. File tetap ada di server."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo rimuove solo le copie locali. I file restano sul server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルコピーのみを削除します。ファイルはサーバーに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 사본만 제거됩니다. 파일은 서버에 남아 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette fjerner bare de lokale kopiene. Filene blir liggende på serveren."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee worden alleen de lokale kopieën verwijderd. De bestanden blijven op de server."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to usunięcie tylko lokalnych kopii. Pliki pozostają na serwerze."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto apenas remove as cópias locais. Os ficheiros permanecem no servidor."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto apenas remove as cópias locais. Os arquivos permanecem no servidor."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceasta elimină doar copiile locale. Fișierele rămân pe server."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это удалит только локальные копии. Файлы останутся на сервере."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta tar bara bort de lokala kopiorna. Filerna finns kvar på servern."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดำเนินการนี้จะนำออกเฉพาะสำเนาในเครื่อง ไฟล์ยังอยู่บนเซิร์ฟเวอร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yalnızca yerel kopyaları kaldırır. Dosyalar sunucuda kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це лише видалить локальні копії. Файли залишаться на сервері."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này chỉ xóa các bản sao trên thiết bị. Các tệp vẫn còn trên máy chủ."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "这仅会移除本地副本。文件仍保留在服务器上。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "這只會移除本機副本。檔案仍保留在伺服器上。"
          }
        }
      }
    },
