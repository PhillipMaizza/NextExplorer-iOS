    "changePassword.addIntro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account signs in with single sign-on and has no password yet. Add one to also sign in with your email address or username."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسجّل هذا الحساب الدخول عبر تسجيل الدخول الموحّد وليس له كلمة سر بعد. أضف واحدة لتسجيل الدخول أيضًا باستخدام بريدك الإلكتروني أو اسم المستخدم."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento účet se přihlašuje jednotným přihlášením a zatím nemá heslo. Přidejte ho, abyste se mohli přihlašovat také e-mailovou adresou nebo uživatelským jménem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne konto logger ind med single sign-on og har endnu ingen adgangskode. Tilføj en for også at kunne logge ind med din e-mailadresse eller dit brugernavn."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Konto meldet sich per Single Sign-on an und hat noch kein Passwort. Lege eines an, um dich auch mit deiner E-Mail-Adresse oder deinem Benutzernamen anzumelden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτός ο λογαριασμός συνδέεται με single sign-on και δεν έχει ακόμη κωδικό πρόσβασης. Προσθέστε έναν για να συνδέεστε και με τη διεύθυνση email ή το όνομα χρήστη σας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cuenta inicia sesión con inicio de sesión único y aún no tiene contraseña. Añade una para iniciar sesión también con tu correo electrónico o nombre de usuario."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä tili kirjautuu kertakirjautumisella eikä sillä ole vielä salasanaa. Lisää sellainen, jotta voit kirjautua myös sähköpostiosoitteellasi tai käyttäjänimelläsi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce compte se connecte avec l'authentification unique et n'a pas encore de mot de passe. Ajoutez-en un pour vous connecter aussi avec votre adresse e-mail ou votre nom d'utilisateur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החשבון הזה מתחבר באמצעות כניסה יחידה ועדיין אין לו סיסמה. הוסיפו אחת כדי להתחבר גם עם כתובת האימייל או שם המשתמש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह खाता सिंगल साइन-ऑन से साइन इन करता है और इसमें अभी तक पासवर्ड नहीं है। अपने ईमेल पते या उपयोगकर्ता नाम से भी साइन इन करने के लिए एक जोड़ें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a fiók egyszeri bejelentkezéssel jelentkezik be, és még nincs jelszava. Adjon hozzá egyet, hogy e-mail-címével vagy felhasználónevével is be tudjon jelentkezni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akun ini masuk dengan single sign-on dan belum punya kata sandi. Tambahkan satu agar juga bisa masuk dengan alamat email atau nama pengguna."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo account accede con il single sign-on e non ha ancora una password. Aggiungine una per accedere anche con il tuo indirizzo email o nome utente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントはシングルサインオンでサインインしており、まだパスワードがありません。パスワードを追加すると、メールアドレスまたはユーザ名でもサインインできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계정은 싱글 사인온으로 로그인하며 아직 비밀번호가 없습니다. 비밀번호를 추가하면 이메일 주소나 사용자 이름으로도 로그인할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne kontoen logger inn med single sign-on og har ikke passord ennå. Legg til ett for også å kunne logge inn med e-postadressen eller brukernavnet ditt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit account logt in met single sign-on en heeft nog geen wachtwoord. Voeg er een toe om ook in te loggen met je e-mailadres of gebruikersnaam."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To konto loguje się przez jednokrotne logowanie (SSO) i nie ma jeszcze hasła. Dodaj je, aby móc logować się także adresem e-mail lub nazwą użytkownika."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conta inicia sessão com início de sessão único (SSO) e ainda não tem palavra-passe. Adicione uma para também iniciar sessão com o seu endereço de e-mail ou nome de utilizador."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conta entra com login único (SSO) e ainda não tem senha. Adicione uma para também entrar com seu e-mail ou nome de usuário."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest cont se conectează prin autentificare unică și nu are încă o parolă. Adaugă-o pentru a te conecta și cu adresa de e-mail sau cu numele de utilizator."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта учётная запись входит через единый вход и пока не имеет пароля. Добавьте его, чтобы также входить с помощью адреса эл. почты или имени пользователя."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här kontot loggar in med enkel inloggning och har inget lösenord ännu. Lägg till ett för att också logga in med din e-postadress eller ditt användarnamn."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บัญชีนี้เข้าสู่ระบบด้วยการลงชื่อเข้าใช้ครั้งเดียวและยังไม่มีรหัสผ่าน เพิ่มรหัสผ่านเพื่อให้เข้าสู่ระบบด้วยที่อยู่อีเมลหรือชื่อผู้ใช้ได้ด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hesap tek oturum açma ile oturum açar ve henüz parolası yok. E-posta adresiniz veya kullanıcı adınızla da oturum açmak için bir parola ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей обліковий запис входить через єдиний вхід і ще не має пароля. Додайте його, щоб також входити за адресою електронної пошти чи іменем користувача."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản này đăng nhập bằng đăng nhập một lần và chưa có mật khẩu. Hãy thêm mật khẩu để cũng có thể đăng nhập bằng địa chỉ email hoặc tên người dùng."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此账户使用单点登录，尚未设置密码。添加密码后，您还可以使用电子邮件地址或用户名登录。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "此帳號使用單一登入，尚未設定密碼。新增密碼後，您也可以使用電子郵件地址或使用者名稱登入。"
          }
        }
      }
    },
