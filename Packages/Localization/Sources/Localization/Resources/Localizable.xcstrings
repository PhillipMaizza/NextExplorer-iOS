    "versionedFiles.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every file that has a history, wherever it is. It shows paths from every space, personal folders included, so it is for administrators only."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل ملف له سجل، أينما كان. يعرض مسارات من جميع المساحات، بما فيها المجلدات الشخصية، لذا فهو للمشرفين فقط."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý soubor, který má historii, ať je kdekoli. Zobrazuje cesty ze všech prostorů včetně osobních složek, proto je jen pro správce."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle filer, der har en historik, uanset hvor de er. Viser stier fra alle områder, også personlige mapper, og er derfor kun for administratorer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Datei mit einem Verlauf, wo auch immer sie liegt. Sie zeigt Pfade aus allen Bereichen, auch aus persönlichen Ordnern, und ist deshalb nur für Administratoren gedacht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε αρχείο που έχει ιστορικό, οπουδήποτε κι αν βρίσκεται. Εμφανίζει διαδρομές από όλους τους χώρους, συμπεριλαμβανομένων των προσωπικών φακέλων, γι' αυτό είναι μόνο για διαχειριστές."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada archivo que tiene un historial, esté donde esté. Muestra rutas de todos los espacios, incluidas las carpetas personales, así que es solo para administradores."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokainen tiedosto, jolla on historia, missä tahansa se onkin. Näyttää polut kaikista tiloista, myös henkilökohtaisista kansioista, joten se on vain ylläpitäjille."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque fichier qui a un historique, où qu’il soit. Cette liste montre les chemins de tous les espaces, dossiers personnels compris, elle est donc réservée aux administrateurs."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל קובץ שיש לו היסטוריה, בכל מקום שהוא נמצא. מציג נתיבים מכל המרחבים, כולל תיקיות אישיות, ולכן מיועד למנהלי מערכת בלבד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर वह फ़ाइल जिसका इतिहास है, चाहे वह कहीं भी हो। यह सभी जगहों के पाथ दिखाता है, निजी फ़ोल्डर समेत, इसलिए यह केवल एडमिनिस्ट्रेटर के लिए है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden fájl, amelynek van előzménye, bárhol is legyen. Az összes térből megjeleníti az elérési utakat, a személyes mappákat is beleértve, ezért csak rendszergazdáknak szól."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap file yang punya riwayat, di mana pun berada. Menampilkan jalur dari semua ruang, termasuk folder pribadi, sehingga hanya untuk administrator."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni file che ha una cronologia, ovunque si trovi. Mostra i percorsi di tutti gli spazi, comprese le cartelle personali, quindi è solo per gli amministratori."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴のあるすべてのファイルを場所を問わず表示します。個人フォルダを含むすべての領域のパスが見えるため、管理者専用です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록이 있는 모든 파일을 위치와 상관없이 보여 줍니다. 개인 폴더를 포함해 모든 공간의 경로가 표시되므로 관리자 전용입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle filer som har en historikk, uansett hvor de er. Viser stier fra alle områder, også personlige mapper, og er derfor bare for administratorer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk bestand met een geschiedenis, waar het ook staat. Het toont paden uit alle ruimtes, inclusief persoonlijke mappen, dus het is alleen voor beheerders."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy plik, który ma historię, gdziekolwiek się znajduje. Pokazuje ścieżki ze wszystkich przestrzeni, także foldery osobiste, więc jest tylko dla administratorów."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os ficheiros que têm um histórico, onde quer que estejam. Mostra caminhos de todos os espaços, incluindo pastas pessoais, pelo que é apenas para administradores."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os arquivos que têm um histórico, onde quer que estejam. Mostra caminhos de todos os espaços, inclusive pastas pessoais, por isso é apenas para administradores."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare fișier care are un istoric, oriunde s-ar afla. Arată căi din toate spațiile, inclusiv dosarele personale, deci este doar pentru administratori."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый файл, у которого есть история, где бы он ни находился. Здесь показаны пути из всех пространств, включая личные папки, поэтому раздел только для администраторов."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje fil som har en historik, var den än finns. Den visar sökvägar från alla utrymmen, även personliga mappar, så den är bara för administratörer."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกไฟล์ที่มีประวัติ ไม่ว่าจะอยู่ที่ใด แสดงพาธจากทุกพื้นที่ รวมถึงโฟลเดอร์ส่วนตัว จึงใช้ได้สำหรับผู้ดูแลระบบเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçmişi olan her dosya, nerede olursa olsun. Kişisel klasörler dahil her alandaki yolları gösterir, bu yüzden yalnızca yöneticilere yöneliktir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен файл, що має історію, де б він не був. Показує шляхи з усіх просторів, зокрема з особистих папок, тому доступно лише адміністраторам."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi tệp có lịch sử, ở bất cứ đâu. Hiển thị đường dẫn từ mọi không gian, kể cả thư mục cá nhân, nên chỉ dành cho quản trị viên."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "所有有历史记录的文件，无论在何处。这里会显示所有空间的路径，包括个人文件夹，因此仅限管理员使用。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "所有有歷史記錄的檔案，無論在何處。這裡會顯示所有空間的路徑，包括個人資料夾，因此僅限管理員使用。"
          }
        }
      }
    },
