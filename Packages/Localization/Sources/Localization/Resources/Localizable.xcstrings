    "downloads.deleteSingleMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This only removes the local copy. The file stays on the server."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا يزيل النسخة المحلية فقط. يبقى الملف على الخادم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies entfernt nur die lokale Kopie. Die Datei bleibt auf dem Server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto solo elimina la copia local. El archivo permanece en el servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime uniquement la copie locale. Le fichier reste sur le serveur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह केवल स्थानीय प्रति हटाता है। फ़ाइल सर्वर पर बनी रहती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo rimuove solo la copia locale. Il file resta sul server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルコピーのみを削除します。ファイルはサーバに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 사본만 제거됩니다. 파일은 서버에 남아 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee wordt alleen de lokale kopie verwijderd. Het bestand blijft op de server."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to usunięcie tylko lokalnej kopii. Plik pozostaje na serwerze."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto apenas remove a cópia local. O ficheiro permanece no servidor."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceasta elimină doar copia locală. Fișierul rămâne pe server."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это удалит только локальную копию. Файл останется на сервере."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta tar bara bort den lokala kopian. Filen finns kvar på servern."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "这仅会移除本地副本。文件仍保留在服务器上。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "這只會移除本機副本。檔案仍保留在伺服器上。"
          }
        }
      }
    },
