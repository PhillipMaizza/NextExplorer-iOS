    "shareUpload.started": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uploading in the background. You'll get a notification when it's done."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ الرفع في الخلفية. سيصلك إشعار عند الانتهاء."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahrává se na pozadí. Až bude hotovo, dostanete oznámení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Uploader i baggrunden. Du får en notifikation, når det er færdigt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird im Hintergrund hochgeladen. Du bekommst eine Mitteilung, sobald es fertig ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μεταφόρτωση στο παρασκήνιο. Θα λάβετε ειδοποίηση όταν ολοκληρωθεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Subiendo en segundo plano. Recibirás una notificación cuando termine."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähetetään taustalla. Saat ilmoituksen, kun se on valmis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoi en arrière-plan. Vous recevrez une notification une fois terminé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מעלה ברקע. תקבלו התראה כשזה יסתיים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बैकग्राउंड में अपलोड हो रहा है। पूरा होने पर आपको सूचना मिलेगी।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Feltöltés a háttérben. Értesítést kap, amikor kész."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengunggah di latar belakang. Anda akan mendapat notifikasi saat selesai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Caricamento in background. Riceverai una notifica al termine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックグラウンドでアップロードしています。完了すると通知が届きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백그라운드에서 업로드 중입니다. 완료되면 알림을 보내 드립니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Laster opp i bakgrunnen. Du får et varsel når det er ferdig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uploaden op de achtergrond. Je krijgt een melding als het klaar is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesyłanie w tle. Otrzymasz powiadomienie po zakończeniu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A enviar em segundo plano. Receberá uma notificação quando terminar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviando em segundo plano. Você receberá uma notificação quando terminar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se încarcă în fundal. Vei primi o notificare când se termină."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузка в фоне. Вы получите уведомление, когда всё будет готово."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Laddar upp i bakgrunden. Du får en notis när det är klart."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังอัปโหลดในเบื้องหลัง คุณจะได้รับการแจ้งเตือนเมื่อเสร็จสิ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arka planda yükleniyor. Bittiğinde bildirim alacaksınız."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вивантаження у фоновому режимі. Ви отримаєте сповіщення, коли воно завершиться."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang tải lên ở nền. Bạn sẽ nhận được thông báo khi xong."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "正在后台上传。完成后你会收到通知。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "正在背景上傳。完成後你會收到通知。"
          }
        }
      }
    },
