    "browse.newFileTypeHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a file type the editor can open, such as .txt, .md or .js."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم نوع ملف يمكن للمحرر فتحه، مثل .txt أو .md أو .js."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použijte typ souboru, který editor otevře, například .txt, .md nebo .js."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug en filtype, som editoren kan åbne, f.eks. .txt, .md eller .js."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende einen Dateityp, den der Editor öffnen kann, etwa .txt, .md oder .js."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποιήστε έναν τύπο αρχείου που μπορεί να ανοίξει ο επεξεργαστής, όπως .txt, .md ή .js."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un tipo de archivo que el editor pueda abrir, como .txt, .md o .js."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytä tiedostotyyppiä, jonka editori osaa avata, esimerkiksi .txt, .md tai .js."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez un type de fichier que l’éditeur peut ouvrir, comme .txt, .md ou .js."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השתמשו בסוג קובץ שהעורך יכול לפתוח, כמו txt‎ ,md‎ או js‎."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐसा फ़ाइल प्रकार इस्तेमाल करें जिसे एडिटर खोल सके, जैसे .txt, .md या .js।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Használjon olyan fájltípust, amelyet a szerkesztő meg tud nyitni, például .txt, .md vagy .js."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan jenis file yang dapat dibuka editor, seperti .txt, .md, atau .js."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un tipo di file che l’editor può aprire, come .txt, .md o .js."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": ".txt、.md、.js など、エディタで開けるファイル形式を使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ".txt, .md, .js처럼 편집기에서 열 수 있는 파일 형식을 사용하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk en filtype som redigeringsprogrammet kan åpne, for eksempel .txt, .md eller .js."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik een bestandstype dat de editor kan openen, zoals .txt, .md of .js."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj typu pliku, który edytor potrafi otworzyć, np. .txt, .md lub .js."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Use um tipo de ficheiro que o editor consiga abrir, como .txt, .md ou .js."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use um tipo de arquivo que o editor consiga abrir, como .txt, .md ou .js."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folosește un tip de fișier pe care editorul îl poate deschide, cum ar fi .txt, .md sau .js."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте тип файла, который открывает редактор, например .txt, .md или .js."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd en filtyp som redigeraren kan öppna, till exempel .txt, .md eller .js."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ชนิดไฟล์ที่ตัวแก้ไขเปิดได้ เช่น .txt, .md หรือ .js"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düzenleyicinin açabileceği bir dosya türü kullanın, örneğin .txt, .md veya .js."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використайте тип файлу, який може відкрити редактор, наприклад .txt, .md або .js."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy dùng loại tệp mà trình soạn thảo có thể mở, như .txt, .md hoặc .js."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用编辑器可以打开的文件类型，例如 .txt、.md 或 .js。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "請使用編輯器可開啟的檔案類型，例如 .txt、.md 或 .js。"
          }
        }
      }
    },
