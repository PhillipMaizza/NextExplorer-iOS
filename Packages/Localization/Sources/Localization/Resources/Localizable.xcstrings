        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उस सर्वर तक नहीं पहुंच सके। पता जांचें और पुनः प्रयास करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile raggiungere quel server. Controlla l'indirizzo e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのサーバに接続できませんでした。アドレスを確認して再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 서버에 연결할 수 없습니다. 주소를 확인하고 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan die server niet bereiken. Controleer het adres en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można połączyć się z tym serwerem. Sprawdź adres i spróbuj ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível contactar esse servidor. Verifique o endereço e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu s-a putut contacta acel server. Verifică adresa și încearcă din nou."
