    "tipJar.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer is free and open source. If it's useful to you, a small tip helps keep it going. Thank you!"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer مجاني ومفتوح المصدر. إذا كان مفيدًا لك، فإن إكرامية صغيرة تساعد على استمراره. شكرًا لك!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer ist kostenlos und quelloffen. Wenn sie dir nützt, hilft ein kleines Trinkgeld, sie am Leben zu halten. Danke!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer es gratis y de código abierto. Si te resulta útil, una pequeña propina ayuda a mantenerlo. ¡Gracias!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer est gratuit et open source. S’il vous est utile, un petit pourboire aide à le faire vivre. Merci !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer मुफ़्त और ओपन सोर्स है। अगर यह आपके काम आता है, तो एक छोटी सी टिप इसे चलाते रहने में मदद करती है। धन्यवाद!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer è gratuito e open source. Se ti è utile, una piccola offerta aiuta a mantenerlo. Grazie!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer は無料でオープンソースです。お役に立てているなら、ささやかなチップが開発の支えになります。ありがとうございます！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer는 무료이며 오픈 소스입니다. 유용하셨다면 작은 후원이 개발을 이어가는 데 도움이 됩니다. 감사합니다!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer is gratis en open source. Als je er iets aan hebt, helpt een kleine fooi om het draaiende te houden. Bedankt!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer jest darmowy i open source. Jeśli jest dla Ciebie przydatny, mały napiwek pomoże go utrzymać. Dziękuję!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O NextExplorer é gratuito e de código aberto. Se for útil para você, uma pequena gorjeta ajuda a mantê-lo. Obrigado!"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer este gratuit și open source. Dacă îți este util, un mic bacșiș ajută să meargă mai departe. Mulțumesc!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer бесплатен и с открытым исходным кодом. Если он вам полезен, небольшие чаевые помогут его развивать. Спасибо!"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer är gratis och öppen källkod. Om den är användbar hjälper en liten dricks till att hålla den vid liv. Tack!"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer 免费且开源。如果它对你有用，一点小小的打赏能帮助它继续下去。谢谢！"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer 免費且開源。如果它對你有用，一點小小的贊助能幫助它繼續下去。謝謝！"
          }
        }
      }
    },
    "tipJar.pending": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for approval. You'll be charged once it's approved."
