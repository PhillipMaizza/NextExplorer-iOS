    "settings.accountSignOutMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign %@ out on this device? You'll need to sign in again to use this account."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجيل خروج %@ من هذا الجهاز؟ ستحتاج إلى تسجيل الدخول مرة أخرى لاستخدام هذا الحساب."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odhlásit účet %@ na tomto zařízení? Pro jeho použití se budete muset znovu přihlásit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Log %@ ud på denne enhed? Du skal logge ind igen for at bruge denne konto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ auf diesem Gerät abmelden? Du musst dich erneut anmelden, um dieses Konto zu verwenden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποσύνδεση του %@ σε αυτήν τη συσκευή; Θα χρειαστεί να συνδεθείτε ξανά για να χρησιμοποιήσετε αυτόν τον λογαριασμό."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cerrar la sesión de %@ en este dispositivo? Deberás iniciar sesión de nuevo para usar esta cuenta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjataanko %@ ulos tässä laitteessa? Sinun on kirjauduttava uudelleen sisään käyttääksesi tätä tiliä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déconnecter %@ de cet appareil ? Vous devrez vous reconnecter pour utiliser ce compte."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להתנתק מהחשבון של %@ במכשיר זה? תצטרכו להתחבר שוב כדי להשתמש בחשבון הזה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस पर %@ को साइन आउट करें? इस खाते का उपयोग करने के लिए आपको फिर से साइन इन करना होगा."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kijelentkezteti a(z) %@ fiókot ezen az eszközön? A fiók használatához újra be kell jelentkeznie."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Keluarkan %@ di perangkat ini? Anda perlu masuk lagi untuk memakai akun ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnettere %@ da questo dispositivo? Dovrai accedere di nuovo per usare questo account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスで %@ をサインアウトしますか？このアカウントを使うには再度サインインする必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 %@ 계정을 로그아웃할까요? 이 계정을 사용하려면 다시 로그인해야 합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Logge %@ ut på denne enheten? Du må logge inn igjen for å bruke denne kontoen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ afmelden op dit apparaat? Je moet opnieuw inloggen om dit account te gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wylogować %@ na tym urządzeniu? Aby korzystać z tego konta, trzeba będzie zalogować się ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminar a sessão de %@ neste dispositivo? Terá de iniciar sessão novamente para usar esta conta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sair da conta de %@ neste dispositivo? Você precisará entrar novamente para usar esta conta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deconectezi %@ de pe acest dispozitiv? Va trebui să te autentifici din nou pentru a folosi acest cont."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выйти из аккаунта %@ на этом устройстве? Чтобы снова использовать этот аккаунт, потребуется войти заново."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Logga ut %@ på den här enheten? Du måste logga in igen för att använda det här kontot."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ออกจากระบบ %@ บนอุปกรณ์เครื่องนี้หรือไม่ คุณจะต้องเข้าสู่ระบบอีกครั้งเพื่อใช้บัญชีนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hesabının bu cihazdaki oturumu kapatılsın mı? Bu hesabı kullanmak için yeniden oturum açmanız gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вийти з облікового запису %@ на цьому пристрої? Щоб користуватися ним, потрібно буде ввійти знову."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng xuất %@ trên thiết bị này? Bạn sẽ cần đăng nhập lại để dùng tài khoản này."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "在此设备上退出 %@ 吗？您需要重新登录才能使用此账户。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "要在此裝置上登出 %@ 嗎？您需要重新登入才能使用此帳戶。"
          }
        }
      }
    },
