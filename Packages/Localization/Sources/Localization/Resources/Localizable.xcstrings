    "settings.removeAllDownloadsMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This deletes every downloaded file from this device. They stay on the server."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي هذا إلى حذف كل ملف تم تنزيله من هذا الجهاز. تبقى على الخادم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies löscht jede geladene Datei von diesem Gerät. Sie bleiben auf dem Server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina todos los archivos descargados de este dispositivo. Permanecen en el servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime tous les fichiers téléchargés de cet appareil. Ils restent sur le serveur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह इस डिवाइस से हर डाउनलोड की गई फ़ाइल हटा देता है। वे सर्वर पर बनी रहती हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo elimina ogni file scaricato da questo dispositivo. Restano sul server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスからすべてのダウンロード済みファイルを削除します。サーバには残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 다운로드한 모든 파일을 삭제합니다. 서버에는 남아 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee worden alle gedownloade bestanden van dit apparaat verwijderd. Ze blijven op de server."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to usunięcie wszystkich pobranych plików z tego urządzenia. Pozostają one na serwerze."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto elimina todos os ficheiros transferidos deste dispositivo. Permanecem no servidor."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceasta șterge toate fișierele descărcate de pe acest dispozitiv. Rămân pe server."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это удалит все загруженные файлы с этого устройства. Они останутся на сервере."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta raderar alla nedladdade filer från den här enheten. De finns kvar på servern."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "这会从此设备删除所有已下载的文件。它们仍保留在服务器上。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "這會從此裝置刪除所有已下載的檔案。它們仍保留在伺服器上。"
          }
        }
      }
    },
