        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인이 완료되지 않았습니다. 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aanmelden is niet voltooid. Probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Logowanie nie zostało ukończone. Spróbuj ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O início de sessão não foi concluído. Tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectarea nu s-a finalizat. Te rugăm să încerci din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
