    "downloads.deleteBulkMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This only removes the local copies. The files stay on the server."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا يزيل النسخ المحلية فقط. تبقى الملفات على الخادم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies entfernt nur die lokalen Kopien. Die Dateien bleiben auf dem Server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto solo elimina las copias locales. Los archivos permanecen en el servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime uniquement les copies locales. Les fichiers restent sur le serveur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह केवल स्थानीय प्रतियां हटाता है। फ़ाइलें सर्वर पर बनी रहती हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo rimuove solo le copie locali. I file restano sul server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルコピーのみを削除します。ファイルはサーバに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 사본만 제거됩니다. 파일은 서버에 남아 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee worden alleen de lokale kopieën verwijderd. De bestanden blijven op de server."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to usunięcie tylko lokalnych kopii. Pliki pozostają na serwerze."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto apenas remove as cópias locais. Os ficheiros permanecem no servidor."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceasta elimină doar copiile locale. Fișierele rămân pe server."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это удалит только локальные копии. Файлы останутся на сервере."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta tar bara bort de lokala kopiorna. Filerna finns kvar på servern."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "这仅会移除本地副本。文件仍保留在服务器上。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "這只會移除本機副本。檔案仍保留在伺服器上。"
          }
        }
      }
    },
