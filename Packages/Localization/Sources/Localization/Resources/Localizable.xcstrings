    "trashSettings.trashInvalid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the values: retention from 1 to 3650 days, share from 1 to 90%, a positive size or none."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق من القيم: مدة الاحتفاظ من 1 إلى 3650 يومًا، والحصة من 1 إلى 90%، وحجم موجب أو بلا حجم."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkontrolujte hodnoty: doba uchování od 1 do 3650 dnů, podíl od 1 do 90 %, kladná velikost nebo žádná."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tjek værdierne: opbevaringstid fra 1 til 3650 dage, andel fra 1 til 90 %, en positiv størrelse eller ingen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe die Werte: Aufbewahrung von 1 bis 3650 Tagen, Anteil von 1 bis 90 %, eine positive Größe oder keine."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ελέγξτε τις τιμές: διατήρηση από 1 έως 3650 ημέρες, μερίδιο από 1 έως 90%, θετικό μέγεθος ή κανένα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa los valores: retención de 1 a 3650 días, parte de 1 a 90 %, un tamaño positivo o ninguno."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkista arvot: säilytysaika 1–3650 päivää, osuus 1–90 %, positiivinen koko tai ei mitään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez les valeurs : rétention de 1 à 3650 jours, part de 1 à 90 %, une taille positive ou aucune."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בדקו את הערכים: תקופת שמירה מ-1 עד 3650 ימים, חלק מ-1 עד 90%, גודל חיובי או ללא."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मान जाँचें: अवधि 1 से 3650 दिन, हिस्सा 1 से 90 %, सकारात्मक आकार या कोई नहीं।."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ellenőrizze az értékeket: megőrzés 1 és 3650 nap között, arány 1 és 90% között, pozitív méret vagy semmi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Periksa nilainya: masa simpan 1 sampai 3650 hari, bagian 1 sampai 90%, ukuran positif atau kosong."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla i valori: conservazione da 1 a 3650 giorni, quota da 1 a 90 %, una dimensione positiva o nessuna."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "値を確認してください。保存期間は1〜3650日、割合は1〜90%、サイズは正の値または空です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "값을 확인하세요: 보관 기간 1~3650일, 비율 1~90%, 양수 크기 또는 비워 두기."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sjekk verdiene: oppbevaringstid fra 1 til 3650 dager, andel fra 1 til 90 %, en positiv størrelse eller ingen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer de waarden: bewaartermijn van 1 tot 3650 dagen, aandeel van 1 tot 90%, een positieve grootte of geen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź wartości: przechowywanie od 1 do 3650 dni, udział od 1 do 90 %, dodatni rozmiar lub brak."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique os valores: retenção de 1 a 3650 dias, parte de 1 a 90%, um tamanho positivo ou nenhum."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique os valores: retenção de 1 a 3650 dias, parte de 1 a 90 %, um tamanho positivo ou nenhum."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificați valorile: păstrare între 1 și 3650 de zile, cotă între 1 și 90 %, o dimensiune pozitivă sau niciuna."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте значения: срок хранения от 1 до 3650 дней, доля от 1 до 90 %, положительный размер или пусто."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollera värdena: lagringstid 1 till 3650 dagar, andel 1 till 90 %, en positiv storlek eller ingen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบค่า: ระยะเวลาเก็บรักษา 1 ถึง 3650 วัน สัดส่วน 1 ถึง 90% ขนาดเป็นบวกหรือไม่ระบุ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değerleri kontrol edin: saklama süresi 1 ile 3650 gün, pay 1 ile 90%, pozitif bir boyut veya boş."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевірте значення: термін зберігання від 1 до 3650 днів, частка від 1 до 90%, додатний розмір або без нього."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy kiểm tra các giá trị: thời gian lưu giữ từ 1 đến 3650 ngày, phần từ 1 đến 90%, dung lượng dương hoặc để trống."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查数值：保留期 1 至 3650 天，占比 1 至 90%，正数大小或留空。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "請檢查數值：保留期 1 至 3650 天，比例 1 至 90%，正數大小或留空。"
          }
        }
      }
    },
    "trashSettings.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trash and version settings are only available to administrators."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعدادات سلة المحذوفات والإصدارات متاحة للمشرفين فقط."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavení koše a verzí je dostupné pouze správcům."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indstillinger for papirkurv og versioner er kun tilgængelige for administratorer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen für Papierkorb und Versionen sind nur für Administratoren verfügbar."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι ρυθμίσεις κάδου και εκδόσεων είναι διαθέσιμες μόνο στους διαχειριστές."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ajustes de la papelera y las versiones solo están disponibles para administradores."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Roskakorin ja versioiden asetukset ovat vain ylläpitäjien käytettävissä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réglages de la corbeille et des versions sont réservés aux administrateurs."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגדרות פח האשפה והגרסאות זמינות למנהלי מערכת בלבד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रैश और संस्करण सेटिंग केवल एडमिनिस्ट्रेटर के लिए उपलब्ध हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kuka- és verzióbeállítások csak rendszergazdák számára érhetők el."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengaturan sampah dan versi hanya tersedia untuk administrator."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le impostazioni di cestino e versioni sono disponibili solo per gli amministratori."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱とバージョンの設定は管理者のみ利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통 및 버전 설정은 관리자만 사용할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Innstillinger for papirkurv og versjoner er bare tilgjengelige for administratorer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Instellingen voor prullenbak en versies zijn alleen beschikbaar voor beheerders."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustawienia kosza i wersji są dostępne tylko dla administratorów."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As definições da reciclagem e das versões só estão disponíveis para administradores."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As configurações da lixeira e das versões só estão disponíveis para administradores."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Setările pentru coșul de gunoi și versiuni sunt disponibile doar administratorilor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки корзины и версий доступны только администраторам."
          }
        },
        "sv": {
          "stringUnit": {
