          "stringUnit": {
            "state": "translated",
            "value": "新しい並び順を保存できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 순서를 저장할 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke lagre den nye rekkefølgen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan de nieuwe volgorde niet bewaren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można zapisać nowej kolejności."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível guardar a nova ordem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar a nova ordem."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu s-a putut salva noua ordine."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить новый порядок."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att spara den nya ordningen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถบันทึกลำดับใหม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni sıra kaydedilemedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося зберегти новий порядок."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể lưu thứ tự mới."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存新顺序。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存新順序。"
          }
        }
      }
    },
    "ffmpegSettings.containerPathHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter absolute paths visible inside the application container. To use host binaries, bind-mount them into the container first."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل مسارات مطلقة ظاهرة داخل حاوية التطبيق. لاستخدام ملفات تنفيذية من المضيف، اربطها بالحاوية أولًا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadejte absolutní cesty viditelné uvnitř kontejneru aplikace. Chcete-li použít binárky hostitele, nejprve je připojte do kontejneru."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Angiv absolutte stier, der er synlige i programmets container. For at bruge værtens programfiler skal du først montere dem i containeren."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib absolute Pfade an, die im Anwendungscontainer sichtbar sind. Um Programme des Hosts zu verwenden, binde sie zuerst in den Container ein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εισαγάγετε απόλυτες διαδρομές ορατές μέσα στο κοντέινερ της εφαρμογής. Για να χρησιμοποιήσετε εκτελέσιμα του κεντρικού υπολογιστή, προσαρτήστε τα πρώτα στο κοντέινερ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Indique rutas absolutas visibles dentro del contenedor de la aplicación. Para usar los binarios del anfitrión, móntelos antes en el contenedor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anna absoluuttiset polut, jotka näkyvät sovelluksen säiliön sisällä. Jos haluat käyttää isännän ohjelmia, liitä ne ensin säiliöön."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indiquez des chemins absolus visibles à l'intérieur du conteneur de l'application. Pour utiliser les binaires de l'hôte, montez-les d'abord dans le conteneur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הזינו נתיבים מוחלטים הנראים בתוך קונטיינר היישום. כדי להשתמש בקבצים בינאריים של המארח, חברו אותם תחילה לקונטיינר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एप्लिकेशन कंटेनर के भीतर दिखने वाले पूर्ण पथ दर्ज करें। होस्ट के बाइनरी उपयोग करने के लिए उन्हें पहले कंटेनर में माउंट करें।."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjon meg abszolút elérési utakat, amelyek az alkalmazás konténerében láthatók. A gazdagép bináris fájljainak használatához előbb csatolja azokat a konténerhez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan jalur absolut yang terlihat di dalam kontainer aplikasi. Untuk menggunakan biner host, pasang (bind-mount) ke kontainer terlebih dahulu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indicare percorsi assoluti visibili all'interno del container dell'applicazione. Per usare i binari dell'host, montarli prima nel container."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリケーションのコンテナ内から見える絶対パスを入力してください。ホストのバイナリを使うには、先にコンテナへマウントしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "애플리케이션 컨테이너 안에서 보이는 절대 경로를 입력하세요. 호스트의 실행 파일을 쓰려면 먼저 컨테이너에 마운트하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv inn absolutte stier som er synlige inne i programmets container. For å bruke vertens kjørbare filer må du først montere dem i containeren."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef absolute paden op die binnen de container van de toepassing zichtbaar zijn. Koppel programma's van de host eerst in de container om ze te gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaj ścieżki bezwzględne widoczne wewnątrz kontenera aplikacji. Aby użyć plików z hosta, najpierw zamontuj je w kontenerze."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduza caminhos absolutos visíveis dentro do contentor da aplicação. Para usar binários do anfitrião, monte-os primeiro no contentor."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Informe caminhos absolutos visíveis dentro do contêiner do aplicativo. Para usar binários do host, monte-os no contêiner primeiro."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduceți căi absolute, vizibile în interiorul containerului aplicației. Pentru a folosi binarele gazdei, montați-le mai întâi în container."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите абсолютные пути, видимые внутри контейнера приложения. Чтобы использовать файлы хоста, сначала смонтируйте их в контейнер."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange absoluta sökvägar som syns inuti programmets container. Montera värdens program i containern först om du vill använda dem."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ป้อนพาธสัมบูรณ์ที่มองเห็นได้ภายในคอนเทนเนอร์ของแอป หากต้องการใช้ไฟล์ไบนารีของโฮสต์ ให้เมานต์เข้าไปในคอนเทนเนอร์ก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama kapsayıcısının içinde görünen mutlak yolları girin. Ana makinedeki ikili dosyaları kullanmak için önce bunları kapsayıcıya bağlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вкажіть абсолютні шляхи, видимі всередині контейнера застосунку. Щоб використати бінарні файли хоста, спершу змонтуйте їх у контейнер."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập đường dẫn tuyệt đối nhìn thấy bên trong container của ứng dụng. Để dùng tệp nhị phân của máy chủ, hãy bind-mount chúng vào container trước."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "请填写在应用容器内可见的绝对路径。若要使用主机上的程序，请先将其挂载到容器中。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "請填寫在應用程式容器內可見的絕對路徑。若要使用主機上的程式，請先將其掛載到容器中。"
          }
        }
      }
    },
    "ffmpegSettings.defaultHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave a path empty to use FFMPEG_PATH or FFPROBE_PATH from the environment, then the bundled executable. Changes apply immediately."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اترك المسار فارغًا لاستخدام FFMPEG_PATH أو FFPROBE_PATH من البيئة، ثم الملف التنفيذي المضمّن. تُطبَّق التغييرات فورًا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nechte cestu prázdnou, aby se použila proměnná FFMPEG_PATH nebo FFPROBE_PATH z prostředí a poté přibalený spustitelný soubor. Změny se projeví okamžitě."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lad en sti stå tom for at bruge FFMPEG_PATH eller FFPROBE_PATH fra miljøet og derefter den medfølgende programfil. Ændringer træder i kraft med det samme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass einen Pfad leer, um FFMPEG_PATH oder FFPROBE_PATH aus der Umgebung zu verwenden, danach das mitgelieferte Programm. Änderungen gelten sofort."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφήστε μια διαδρομή κενή για να χρησιμοποιηθεί το FFMPEG_PATH ή το FFPROBE_PATH από το περιβάλλον και μετά το ενσωματωμένο εκτελέσιμο. Οι αλλαγές ισχύουν άμεσα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deje una ruta vacía para usar FFMPEG_PATH o FFPROBE_PATH del entorno y después el ejecutable incluido. Los cambios se aplican de inmediato."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jätä polku tyhjäksi, jos haluat käyttää ympäristön muuttujaa FFMPEG_PATH tai FFPROBE_PATH ja sen jälkeen mukana tulevaa ohjelmaa. Muutokset tulevat voimaan heti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez un chemin vide pour utiliser FFMPEG_PATH ou FFPROBE_PATH de l'environnement, puis l'exécutable fourni. Les changements s'appliquent immédiatement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השאירו נתיב ריק כדי להשתמש ב-FFMPEG_PATH או ב-FFPROBE_PATH מהסביבה, ואז בקובץ ההרצה המצורף. שינויים חלים מיד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पथ खाली छोड़ें ताकि परिवेश से FFMPEG_PATH या FFPROBE_PATH और फिर साथ दिया गया निष्पादनीय उपयोग हो। बदलाव तुरंत लागू होते हैं।."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hagyjon üresen egy elérési utat, hogy a környezet FFMPEG_PATH vagy FFPROBE_PATH értékét, majd a mellékelt futtatható fájlt használja. A módosítások azonnal érvénybe lépnek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Biarkan jalur kosong untuk memakai FFMPEG_PATH atau FFPROBE_PATH dari lingkungan, lalu file eksekusi bawaan. Perubahan langsung berlaku."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lasciare un percorso vuoto per usare FFMPEG_PATH o FFPROBE_PATH dall'ambiente e poi l'eseguibile incluso. Le modifiche hanno effetto immediato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスを空にすると、環境のFFMPEG_PATHまたはFFPROBE_PATH、次に同梱の実行ファイルを使います。変更はすぐに反映されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "경로를 비워 두면 환경의 FFMPEG_PATH 또는 FFPROBE_PATH를 먼저 쓰고, 그다음 기본 포함된 실행 파일을 씁니다. 변경은 즉시 적용됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "La en sti stå tom for å bruke FFMPEG_PATH eller FFPROBE_PATH fra miljøet, og deretter den medfølgende kjørbare filen. Endringer gjelder umiddelbart."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat een pad leeg om FFMPEG_PATH of FFPROBE_PATH uit de omgeving te gebruiken en daarna het meegeleverde programma. Wijzigingen zijn direct actief."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozostaw ścieżkę pustą, aby użyć FFMPEG_PATH lub FFPROBE_PATH ze środowiska, a następnie dołączonego pliku wykonywalnego. Zmiany działają natychmiast."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe um caminho vazio para usar FFMPEG_PATH ou FFPROBE_PATH do ambiente e, depois, o executável incluído. As alterações aplicam-se de imediato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe um caminho vazio para usar FFMPEG_PATH ou FFPROBE_PATH do ambiente e, depois, o executável incluído. As alterações valem imediatamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lăsați o cale goală pentru a folosi FFMPEG_PATH sau FFPROBE_PATH din mediu, apoi executabilul inclus. Modificările se aplică imediat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставьте путь пустым, чтобы использовать FFMPEG_PATH или FFPROBE_PATH из окружения, а затем встроенный файл. Изменения применяются сразу."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lämna en sökväg tom för att använda FFMPEG_PATH eller FFPROBE_PATH från miljön och därefter det medföljande programmet. Ändringar gäller direkt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เว้นพาธว่างไว้เพื่อใช้ FFMPEG_PATH หรือ FFPROBE_PATH จากสภาพแวดล้อม แล้วจึงใช้ไฟล์ที่มาพร้อมแอป การเปลี่ยนแปลงมีผลทันที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ortamdaki FFMPEG_PATH veya FFPROBE_PATH'i, ardından paketlenmiş çalıştırılabilir dosyayı kullanmak için yolu boş bırakın. Değişiklikler hemen uygulanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залиште шлях порожнім, щоб використати FFMPEG_PATH або FFPROBE_PATH із середовища, а потім вбудований виконуваний файл. Зміни застосовуються одразу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để trống đường dẫn để dùng FFMPEG_PATH hoặc FFPROBE_PATH từ môi trường, sau đó đến tệp thực thi đi kèm. Thay đổi có hiệu lực ngay."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "留空则先使用环境中的 FFMPEG_PATH 或 FFPROBE_PATH，再使用内置的可执行文件。更改立即生效。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "留空則先使用環境中的 FFMPEG_PATH 或 FFPROBE_PATH，再使用內建的執行檔。變更立即生效。"
          }
        }
      }
    },
