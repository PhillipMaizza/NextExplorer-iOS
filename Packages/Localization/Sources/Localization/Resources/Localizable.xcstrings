    "settings.signOutMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll need to sign in again to access your files. Cached previews, thumbnails, and saved folder listings on this device will be cleared."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستحتاج إلى تسجيل الدخول مرة أخرى للوصول إلى ملفاتك."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro přístup k souborům se budete muset znovu přihlásit. Uložené náhledy, miniatury a výpisy složek na tomto zařízení budou vymazány."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du skal logge ind igen for at få adgang til dine filer. Cachede eksempelvisninger, miniaturer og gemte mappelister på denne enhed ryddes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du musst dich erneut anmelden, um auf deine Dateien zuzugreifen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θα χρειαστεί να συνδεθείτε ξανά για να αποκτήσετε πρόσβαση στα αρχεία σας. Οι προεπισκοπήσεις, οι μικρογραφίες και οι αποθηκευμένες λίστες φακέλων σε αυτήν τη συσκευή θα εκκαθαριστούν."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deberás iniciar sesión de nuevo para acceder a tus archivos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinun on kirjauduttava uudelleen sisään päästäksesi tiedostoihisi. Tämän laitteen välimuistissa olevat esikatselut, pikkukuvat ja tallennetut kansioluettelot tyhjennetään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous devrez vous reconnecter pour accéder à vos fichiers."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תצטרכו להתחבר שוב כדי לגשת לקבצים. תצוגות מקדימות, תמונות ממוזערות ורשימות תיקיות שמורות במכשיר זה יימחקו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी फ़ाइलों तक पहुंचने के लिए आपको फिर से साइन इन करना होगा।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fájlok eléréséhez újra be kell jelentkeznie. A gyorsítótárazott előnézetek, miniatűrök és mentett mappalisták ezen az eszközön törlődnek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda perlu masuk lagi untuk mengakses file. Pratinjau, gambar mini, dan daftar folder tersimpan di perangkat ini akan dibersihkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dovrai accedere di nuovo per usare i tuoi file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルにアクセスするには再度サインインする必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일에 접근하려면 다시 로그인해야 합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du må logge inn igjen for å få tilgang til filene dine. Bufrede forhåndsvisninger, miniatyrbilder og lagrede mappelister på denne enheten tømmes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je moet opnieuw inloggen om bij je bestanden te komen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby uzyskać dostęp do plików, musisz zalogować się ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Terá de iniciar sessão novamente para aceder aos seus ficheiros."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você precisará entrar novamente para acessar seus arquivos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Va trebui să te conectezi din nou pentru a-ți accesa fișierele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы получить доступ к файлам, нужно снова войти."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du måste logga in igen för att komma åt dina filer."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณจะต้องเข้าสู่ระบบอีกครั้งเพื่อเข้าถึงไฟล์ของคุณ ตัวอย่าง ภาพขนาดย่อ และรายการโฟลเดอร์ที่บันทึกไว้ในอุปกรณ์เครื่องนี้จะถูกล้าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyalarınıza erişmek için yeniden oturum açmanız gerekir. Bu cihazdaki önbelleğe alınmış önizlemeler, küçük resimler ve kayıtlı klasör listeleri temizlenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб отримати доступ до файлів, потрібно буде ввійти знову. Кешовані попередні перегляди, мініатюри та збережені списки папок на цьому пристрої буде очищено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn sẽ cần đăng nhập lại để truy cập tệp. Bản xem trước, ảnh thu nhỏ và danh sách thư mục đã lưu trên thiết bị này sẽ bị xóa."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "您需要重新登录才能访问您的文件。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "您需要重新登入才能取用您的檔案。"
          }
        }
