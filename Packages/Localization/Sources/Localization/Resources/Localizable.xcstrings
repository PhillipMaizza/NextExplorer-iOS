        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mapper kan ikke deles. Del filene inni i stedet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mappen kunnen niet worden gedeeld. Deel in plaats daarvan de bestanden erin."
