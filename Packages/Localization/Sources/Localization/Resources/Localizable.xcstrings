    "menu.quitTransfersMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uploads or downloads are still in progress. Quitting now stops them."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تزال عمليات الرفع أو التنزيل جارية. سيؤدي الإنهاء الآن إلى إيقافها."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahrávání nebo stahování stále probíhá. Ukončením ho zastavíte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Uploads eller downloads er stadig i gang. Hvis du afslutter nu, stopper de."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Uploads oder Downloads laufen noch. Wenn du jetzt beendest, werden sie abgebrochen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μεταφορτώσεις ή λήψεις βρίσκονται ακόμη σε εξέλιξη. Αν βγείτε τώρα, θα σταματήσουν."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía hay subidas o descargas en curso. Si sales ahora, se detendrán."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähetyksiä tai latauksia on yhä kesken. Lopettaminen nyt pysäyttää ne."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des envois ou des téléchargements sont encore en cours. Quitter maintenant les interrompra."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העלאות או הורדות עדיין מתבצעות. יציאה עכשיו תעצור אותן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपलोड या डाउनलोड अभी भी चल रहे हैं। अभी बंद करने पर वे रुक जाएँगे।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Feltöltések vagy letöltések még folyamatban vannak. Ha most kilép, leállnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Unggahan atau unduhan masih berlangsung. Keluar sekarang akan menghentikannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ci sono ancora caricamenti o download in corso. Uscendo ora verranno interrotti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップロードまたはダウンロードが進行中です。今終了すると停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업로드 또는 다운로드가 아직 진행 중입니다. 지금 종료하면 중단됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opplastinger eller nedlastinger pågår fortsatt. Hvis du avslutter nå, stoppes de."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er lopen nog uploads of downloads. Als je nu stopt, worden ze afgebroken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesyłanie lub pobieranie nadal trwa. Zakończenie teraz je przerwie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda há envios ou downloads em andamento. Encerrar agora irá interrompê-los."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda há envios ou downloads em andamento. Encerrar agora irá interrompê-los."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încărcările sau descărcările sunt încă în curs. Dacă închizi acum, se vor opri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузки на сервер или скачивания ещё выполняются. Если завершить сейчас, они будут остановлены."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uppladdningar eller hämtningar pågår fortfarande. Om du avslutar nu stoppas de."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การอัปโหลดหรือการดาวน์โหลดยังดำเนินอยู่ การออกตอนนี้จะหยุดการทำงานเหล่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüklemeler veya indirmeler hâlâ sürüyor. Şimdi çıkmak bunları durdurur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вивантаження або завантаження ще тривають. Вихід зараз їх зупинить."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các lượt tải lên hoặc tải xuống vẫn đang diễn ra. Thoát bây giờ sẽ dừng chúng."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "上传或下载仍在进行中。现在退出将会停止它们。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "上傳或下載仍在進行中。現在結束將會停止它們。"
          }
        }
      }
    },
