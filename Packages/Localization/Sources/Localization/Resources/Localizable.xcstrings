    "searchIndexSettings.runningHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads the documents in the volume in the background, so a search inside them answers at once."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقرأ المستندات في وحدة التخزين في الخلفية، فيستجيب البحث داخلها فورًا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čte dokumenty na svazku na pozadí, aby vyhledávání v nich odpovídalo okamžitě."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Læser dokumenterne på drevet i baggrunden, så en søgning i dem svarer med det samme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest die Dokumente des Volumes im Hintergrund, damit eine Suche in ihrem Inhalt sofort antwortet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαβάζει τα έγγραφα του τόμου στο παρασκήνιο, ώστε η αναζήτηση σε αυτά να απαντά αμέσως."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee los documentos del volumen en segundo plano, para que una búsqueda en su contenido responda al instante."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lukee taltion asiakirjat taustalla, jotta niistä haku vastaa heti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit les documents du volume en arrière-plan, pour qu'une recherche dans leur contenu réponde aussitôt."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קורא את המסמכים בכרך ברקע, כך שחיפוש בהם מחזיר תשובה מיד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वॉल्यूम के दस्तावेज़ पृष्ठभूमि में पढ़ता है, ताकि उनकी सामग्री में खोज तुरंत उत्तर दे।."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Háttérben beolvassa a kötet dokumentumait, így a bennük való keresés azonnal válaszol."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membaca dokumen di volume di latar belakang agar pencarian di dalamnya langsung menjawab."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Legge i documenti del volume in background, così una ricerca nel loro contenuto risponde subito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボリューム内のドキュメントをバックグラウンドで読み取り、その中の検索がすぐに返るようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "볼륨의 문서를 백그라운드에서 읽어, 내용 검색이 바로 응답하도록 합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Leser dokumentene på volumet i bakgrunnen, slik at et søk i dem svarer med en gang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leest de documenten van het volume op de achtergrond, zodat zoeken in hun inhoud meteen antwoordt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czyta dokumenty woluminu w tle, aby wyszukiwanie w ich treści odpowiadało od razu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Lê os documentos do volume em segundo plano, para que uma pesquisa no seu interior responda de imediato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lê os documentos do volume em segundo plano, para que uma busca no conteúdo deles responda na hora."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Citește documentele volumului în fundal, astfel încât o căutare în conținutul lor să răspundă imediat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Читает документы тома в фоне, чтобы поиск по их содержимому отвечал сразу."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Läser volymens dokument i bakgrunden, så att en sökning i innehållet svarar direkt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านเอกสารในวอลุ่มเบื้องหลัง เพื่อให้การค้นหาในเอกสารตอบกลับทันที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birimdeki belgeleri arka planda okur, böylece içlerinde yapılan arama anında yanıt verir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Читає документи на томі у фоновому режимі, щоб пошук у них відповідав одразу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc các tài liệu trong volume ở nền để tìm kiếm trong đó phản hồi ngay."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "在后台读取卷中的文档，使对其内容的搜索能立即响应。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "在背景讀取卷宗中的文件，讓對其內容的搜尋能立即回應。"
          }
        }
      }
    },
