    "uploads.stagingFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't add those files. Try again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر إضافة تلك الملفات. أعد المحاولة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tyto soubory se nepodařilo přidat. Zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Filerne kunne ikke tilføjes. Prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Dateien konnten nicht hinzugefügt werden. Versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η προσθήκη αυτών των αρχείων. Δοκιμάστε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron añadir esos archivos. Inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiedostoja ei voitu lisätä. Yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'ajouter ces fichiers. Réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה להוסיף את הקבצים האלה. נסו שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वे फ़ाइलें जोड़ नहीं सके। पुनः प्रयास करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fájlokat nem sikerült hozzáadni. Próbálja újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat menambahkan file tersebut. Coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile aggiungere quei file. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それらのファイルを追加できませんでした。再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 파일을 추가할 수 없습니다. 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke legge til filene. Prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan die bestanden niet toevoegen. Probeer het opnieuw."
          }
        },
        "pl": {
