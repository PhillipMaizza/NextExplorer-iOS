    "login.diagnosticsIntro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This log shows what the server answered at each step, to help find why signing in fails. It never contains your password, the address you typed or your username. Send it to the developer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض هذا السجل ما ردّ به الخادم في كل خطوة، لمساعدتك في معرفة سبب فشل تسجيل الدخول. لا يحتوي أبدًا على كلمة السر أو العنوان الذي كتبته أو اسم المستخدم. أرسله إلى المطوّر."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento protokol ukazuje, co server odpověděl v každém kroku, aby bylo možné zjistit, proč se přihlášení nedaří. Nikdy neobsahuje vaše heslo, zadanou adresu ani uživatelské jméno. Pošlete ho vývojáři."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne log viser, hvad serveren svarede i hvert trin, så det er lettere at finde ud af, hvorfor login mislykkes. Den indeholder aldrig din adgangskode, den adresse, du indtastede, eller dit brugernavn. Send den til udvikleren."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Protokoll zeigt, was der Server bei jedem Schritt geantwortet hat, um herauszufinden, warum die Anmeldung fehlschlägt. Es enthält nie dein Passwort, die eingegebene Adresse oder deinen Benutzernamen. Sende es an den Entwickler."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το αρχείο καταγραφής δείχνει τι απάντησε ο διακομιστής σε κάθε βήμα, για να βοηθήσει στον εντοπισμό του γιατί αποτυγχάνει η σύνδεση. Δεν περιέχει ποτέ τον κωδικό πρόσβασής σας, τη διεύθυνση που πληκτρολογήσατε ή το όνομα χρήστη σας. Στείλτε το στον προγραμματιστή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este registro muestra lo que respondió el servidor en cada paso, para ayudar a encontrar por qué falla el inicio de sesión. Nunca contiene tu contraseña, la dirección que escribiste ni tu nombre de usuario. Envíalo al desarrollador."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä loki näyttää, mitä palvelin vastasi kussakin vaiheessa, jotta voi selvittää, miksi kirjautuminen epäonnistuu. Se ei koskaan sisällä salasanaasi, kirjoittamaasi osoitetta tai käyttäjänimeäsi. Lähetä se kehittäjälle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce journal indique ce que le serveur a répondu à chaque étape, pour aider à trouver pourquoi la connexion échoue. Il ne contient jamais votre mot de passe, l'adresse saisie ni votre nom d'utilisateur. Envoyez-le au développeur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היומן הזה מראה מה השרת השיב בכל שלב, כדי לעזור למצוא מדוע ההתחברות נכשלת. הוא לעולם אינו כולל את הסיסמה שלכם, את הכתובת שהקלדתם או את שם המשתמש שלכם. שלחו אותו למפתח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह लॉग दिखाता है कि सर्वर ने हर चरण पर क्या जवाब दिया, ताकि साइन इन विफल होने का कारण खोजने में मदद मिले। इसमें आपका पासवर्ड, आपका दर्ज किया गया पता या आपका उपयोगकर्ता नाम कभी शामिल नहीं होता। इसे डेवलपर को भेजें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a napló azt mutatja, mit válaszolt a kiszolgáló az egyes lépéseknél, hogy segítsen kideríteni, miért hiúsul meg a bejelentkezés. Soha nem tartalmazza a jelszavát, a beírt címet vagy a felhasználónevét. Küldje el a fejlesztőnek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Log ini menunjukkan jawaban server pada setiap langkah, untuk membantu mencari alasan masuk gagal. Log tidak pernah berisi kata sandi, alamat yang Anda ketik, atau nama pengguna Anda. Kirimkan ke pengembang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo log mostra cosa ha risposto il server a ogni passaggio, per aiutare a capire perché l'accesso non riesce. Non contiene mai la tua password, l'indirizzo che hai digitato o il tuo nome utente. Invialo allo sviluppatore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このログには、サインインの各段階でサーバーが返した内容が記録され、サインインに失敗する原因の特定に役立ちます。パスワード、入力したアドレス、ユーザ名は含まれません。開発者に送信してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 로그에는 로그인 각 단계에서 서버가 응답한 내용이 담겨 있어, 로그인이 실패하는 이유를 찾는 데 도움이 됩니다. 비밀번호, 입력한 주소, 사용자 이름은 포함되지 않습니다. 개발자에게 보내 주세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne loggen viser hva serveren svarte i hvert trinn, for å hjelpe deg å finne ut hvorfor innloggingen mislykkes. Den inneholder aldri passordet ditt, adressen du skrev inn eller brukernavnet ditt. Send den til utvikleren."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit logboek laat zien wat de server bij elke stap antwoordde, om te achterhalen waarom inloggen mislukt. Het bevat nooit je wachtwoord, het adres dat je hebt getypt of je gebruikersnaam. Stuur het naar de ontwikkelaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten dziennik pokazuje, co serwer odpowiedział na każdym etapie, aby pomóc ustalić, dlaczego logowanie się nie udaje. Nigdy nie zawiera Twojego hasła, wpisanego adresu ani nazwy użytkownika. Wyślij go deweloperowi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este registo mostra o que o servidor respondeu em cada passo, para ajudar a descobrir porque falha o início de sessão. Nunca contém a sua palavra-passe, o endereço que introduziu nem o seu nome de utilizador. Envie-o ao programador."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este log mostra o que o servidor respondeu em cada etapa, para ajudar a descobrir por que o login falha. Ele nunca contém sua senha, o endereço que você digitou nem seu nome de usuário. Envie-o ao desenvolvedor."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest jurnal arată ce a răspuns serverul la fiecare pas, ca să ajute la aflarea motivului pentru care conectarea eșuează. Nu conține niciodată parola ta, adresa pe care ai introdus-o sau numele tău de utilizator. Trimite-l dezvoltatorului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот журнал показывает, что ответил сервер на каждом шаге, и помогает найти причину сбоя входа. В нём никогда нет вашего пароля, введённого адреса и имени пользователя. Отправьте его разработчику."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här loggen visar vad servern svarade i varje steg, för att hjälpa till att hitta varför inloggningen misslyckas. Den innehåller aldrig ditt lösenord, adressen du angav eller ditt användarnamn. Skicka den till utvecklaren."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกนี้แสดงสิ่งที่เซิร์ฟเวอร์ตอบกลับในแต่ละขั้นตอน เพื่อช่วยหาสาเหตุที่เข้าสู่ระบบไม่ได้ บันทึกนี้ไม่เคยมีรหัสผ่าน ที่อยู่ที่คุณพิมพ์ หรือชื่อผู้ใช้ของคุณ ส่งให้นักพัฒนา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu günlük, oturum açmanın neden başarısız olduğunu bulmaya yardımcı olmak için sunucunun her adımda ne yanıt verdiğini gösterir. Parolanızı, yazdığınız adresi veya kullanıcı adınızı asla içermez. Geliştiriciye gönderin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей журнал показує, що відповів сервер на кожному кроці, щоб допомогти знайти причину збою входу. Він ніколи не містить вашого пароля, введеної адреси чи імені користувача. Надішліть його розробнику."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhật ký này cho thấy máy chủ đã trả lời gì ở mỗi bước, để giúp tìm lý do đăng nhập thất bại. Nó không bao giờ chứa mật khẩu, địa chỉ bạn đã nhập hay tên người dùng của bạn. Hãy gửi nó cho nhà phát triển."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此日志显示服务器在每一步的响应，以帮助查明登录失败的原因。其中绝不包含您的密码、您输入的地址或用户名。请将其发送给开发者。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "此記錄會顯示伺服器在每一步的回應，以協助找出登入失敗的原因。其中絕不包含您的密碼、您輸入的位址或使用者名稱。請將其傳送給開發者。"
          }
        }
      }
    },
