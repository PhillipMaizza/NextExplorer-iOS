    "versionedFiles.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File versions are only available to administrators."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إصدارات الملفات متاحة للمشرفين فقط."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
