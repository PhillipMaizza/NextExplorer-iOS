    "trashSettings.eventVersionTooLarge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" is larger than the whole space: what it replaced was not kept"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» أكبر من المساحة كلها: لم يُحتفظ بما استبدله"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ je větší než celý prostor: to, co nahradilo, nebylo zachováno"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" er større end hele pladsen: det, den erstattede, blev ikke bevaret"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist größer als der ganze Bereich: Was es ersetzte, wurde nicht behalten"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το \"%@\" είναι μεγαλύτερο από ολόκληρο τον χώρο: αυτό που αντικατέστησε δεν διατηρήθηκε"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» supera todo el espacio: lo que reemplazaba no se conservó"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" on suurempi kuin koko tila: sen korvaamaa sisältöä ei säilytetty"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » dépasse tout l'espace : ce qu'il remplaçait n'a pas été gardé"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" גדול מכל המקום: מה שהוא החליף לא נשמר"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" पूरे स्थान से बड़ी है: जो उसने बदला, वह नहीं रखा गया"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) \"%@\" nagyobb, mint a teljes hely: amit lecserélt, az nem maradt meg"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" lebih besar dari seluruh ruang: yang digantikannya tidak dipertahankan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» supera l'intero spazio: ciò che sostituiva non è stato conservato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」は領域全体より大きいため、置き換えられた内容は保持されませんでした"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\"이(가) 전체 공간보다 커서 대체된 내용을 보관하지 않았습니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» er større enn hele plassen: det den erstattet, ble ikke beholdt"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" is groter dan de volledige ruimte: wat het verving, is niet bewaard"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” jest większy niż cała przestrzeń: to, co zastąpił, nie zostało zachowane"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» é maior do que todo o espaço: o que substituía não foi mantido"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" é maior que todo o espaço: o que ele substituiu não foi guardado"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” depășește tot spațiul: ce înlocuia nu a fost păstrat"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» больше всего места: заменённое содержимое не сохранено"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” är större än hela utrymmet: det den ersatte behölls inte"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" ใหญ่กว่าพื้นที่ทั้งหมด: สิ่งที่ถูกแทนที่ไม่ได้ถูกเก็บไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" tüm alandan büyük: değiştirdiği içerik korunmadı"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" більший за весь простір: те, що він замінив, не збережено"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" lớn hơn toàn bộ dung lượng: nội dung bị nó thay thế không được giữ lại"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”大于整个空间：被替换的内容未保留"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」大於整個空間：被取代的內容未保留"
          }
        }
      }
    },
    "trashSettings.eventVersionsBreaker": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many versions missing at once: nothing was changed"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
