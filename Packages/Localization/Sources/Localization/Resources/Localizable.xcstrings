    "trashSettings.sharedSpace": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Versions and the trash share each volume's reserved space. When it runs short, older versions go first, then trash items, then each file's latest version, and pinned versions last."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتشارك الإصدارات والسلة المساحة المحجوزة لكل وحدة تخزين. عند نفادها تُزال الإصدارات الأقدم أولًا، ثم عناصر السلة، ثم أحدث إصدار لكل ملف، وأخيرًا الإصدارات المثبّتة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Verze a koš sdílejí vyhrazené místo každého svazku. Když ho dochází, odcházejí nejdřív starší verze, pak položky koše, pak poslední verze každého souboru a nakonec připnuté verze."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Versioner og papirkurven deler hvert drevs reserverede plads. Når den bliver knap, går ældre versioner først, derefter emner i papirkurven, derefter hver fils seneste version, og fastgjorte versioner til sidst."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versionen und Papierkorb teilen sich den reservierten Bereich jedes Volumes. Wird er knapp, gehen zuerst ältere Versionen, dann Papierkorbelemente, dann die letzte Version jeder Datei und zuletzt angeheftete Versionen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι εκδόσεις και ο κάδος μοιράζονται τον δεσμευμένο χώρο κάθε τόμου. Όταν αυτός λιγοστεύει, φεύγουν πρώτα οι παλαιότερες εκδόσεις, μετά τα στοιχεία του κάδου, μετά η τελευταία έκδοση κάθε αρχείου και τέλος οι καρφιτσωμένες εκδόσεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las versiones y la papelera comparten el espacio reservado de cada volumen. Cuando falta, primero se van las versiones antiguas, luego los elementos de la papelera, luego la última versión de cada archivo y, por último, las versiones fijadas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Versiot ja roskakori jakavat kunkin taltion varatun tilan. Kun tila käy vähiin, vanhemmat versiot poistuvat ensin, sitten roskakorin kohteet, sitten kunkin tiedoston uusin versio ja viimeisenä kiinnitetyt versiot."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les versions et la corbeille partagent l'espace réservé de chaque volume. Quand il manque, les versions anciennes partent d'abord, puis les éléments de la corbeille, puis la dernière version de chaque fichier, et les versions épinglées en dernier."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גרסאות ופח האשפה חולקים את המקום השמור של כל כרך. כשהוא אוזל, הגרסאות הישנות יוצאות ראשונות, אחריהן פריטי הפח, אחריהן הגרסה האחרונה של כל קובץ, ולבסוף הגרסאות המוצמדות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संस्करण और रीसायकल बिन हर वॉल्यूम का आरक्षित स्थान साझा करते हैं। जगह कम पड़ने पर पहले पुराने संस्करण हटते हैं, फिर रीसायकल बिन के आइटम, फिर हर फ़ाइल का नवीनतम संस्करण, और अंत में पिन किए गए संस्करण।."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A verziók és a kuka osztoznak az egyes kötetek fenntartott helyén. Ha fogy a hely, először a régebbi verziók mennek, majd a kuka elemei, majd az egyes fájlok legutóbbi verziója, végül a kitűzött verziók."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Versi dan sampah berbagi ruang khusus setiap volume. Saat ruang menipis, versi lama dihapus lebih dulu, lalu item sampah, lalu versi terbaru tiap file, dan versi yang disematkan paling akhir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le versioni e il cestino condividono lo spazio riservato di ogni volume. Quando scarseggia, se ne vanno prima le versioni vecchie, poi gli elementi del cestino, poi l'ultima versione di ogni file e infine le versioni fissate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バージョンとゴミ箱は各ボリュームの予約領域を共有します。足りなくなると、古いバージョン、ゴミ箱の項目、各ファイルの最新バージョン、最後にピン留めしたバージョンの順に削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버전과 휴지통은 각 볼륨의 예약 공간을 함께 사용합니다. 공간이 부족하면 오래된 버전, 휴지통 항목, 각 파일의 최신 버전 순으로 제거되며 고정된 버전은 마지막에 제거됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Versjoner og papirkurven deler hvert volums reserverte plass. Når den blir knapp, går eldre versjoner først, deretter elementer i papirkurven, deretter hver fils siste versjon, og festede versjoner til slutt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Versies en de prullenbak delen de gereserveerde ruimte van elk volume. Wordt die krap, dan gaan eerst oudere versies, daarna items uit de prullenbak, dan de laatste versie van elk bestand en als laatste vastgezette versies."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wersje i kosz dzielą zarezerwowaną przestrzeń każdego woluminu. Gdy jej brakuje, najpierw znikają starsze wersje, potem elementy kosza, potem ostatnia wersja każdego pliku, a na końcu przypięte wersje."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As versões e a reciclagem partilham o espaço reservado de cada volume. Quando escasseia, saem primeiro as versões mais antigas, depois os itens da reciclagem, depois a última versão de cada ficheiro e, por fim, as versões afixadas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Versões e lixeira dividem o espaço reservado de cada volume. Quando falta espaço, saem primeiro as versões antigas, depois os itens da lixeira, depois a última versão de cada arquivo e, por fim, as versões fixadas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Versiunile și coșul de gunoi împart spațiul rezervat al fiecărui volum. Când nu ajunge, pleacă întâi versiunile vechi, apoi elementele din coș, apoi ultima versiune a fiecărui fișier și, la final, versiunile fixate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Версии и корзина делят зарезервированное место каждого тома. Когда его не хватает, сначала удаляются старые версии, затем элементы корзины, затем последняя версия каждого файла и в последнюю очередь закреплённые версии."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Versioner och papperskorgen delar varje volyms reserverade utrymme. När det inte räcker försvinner först äldre versioner, sedan objekt i papperskorgen, sedan varje fils senaste version och sist fästa versioner."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวอร์ชันและถังขยะใช้พื้นที่สำรองของแต่ละวอลุ่มร่วมกัน เมื่อพื้นที่ใกล้หมด เวอร์ชันเก่าจะถูกนำออกก่อน ตามด้วยรายการในถังขยะ จากนั้นเวอร์ชันล่าสุดของแต่ละไฟล์ และเวอร์ชันที่ปักหมุดเป็นอันดับสุดท้าย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sürümler ve çöp kutusu, her birimin ayrılmış alanını paylaşır. Alan azaldığında önce eski sürümler, sonra çöp kutusu öğeleri, sonra her dosyanın en son sürümü, en sonda da sabitlenmiş sürümler gider."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Версії й кошик ділять зарезервоване місце кожного тому. Коли його не вистачає, першими йдуть старіші версії, потім елементи кошика, потім остання версія кожного файлу, а наостанок закріплені версії."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên bản và thùng rác dùng chung vùng dành riêng của mỗi volume. Khi thiếu chỗ, phiên bản cũ đi trước, rồi đến mục thùng rác, rồi phiên bản mới nhất của mỗi tệp, và cuối cùng là các phiên bản được ghim."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "版本与回收站共用每个卷的预留空间。空间不足时，依次移除旧版本、回收站项目、每个文件的最新版本，最后才是已固定的版本。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "版本與資源回收筒共用每個卷宗的保留空間。空間不足時，依序移除舊版本、資源回收筒項目、每個檔案的最新版本，最後才是已釘選的版本。"
          }
        }
      }
    },
    "trashSettings.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleted items and earlier versions of files are kept in a reserved space on their own volume, and removed after their retention or when that space is needed."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ العناصر المحذوفة والإصدارات السابقة للملفات في مساحة محجوزة على وحدة التخزين الخاصة بها، وتُزال بعد انتهاء مدة الاحتفاظ أو عند الحاجة إلى تلك المساحة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Smazané položky a dřívější verze souborů se uchovávají ve vyhrazeném místě na vlastním svazku a odstraňují se po uplynutí doby uchování nebo když je toto místo potřeba."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slettede emner og tidligere versioner af filer opbevares i en reserveret plads på deres eget drev og fjernes, når opbevaringstiden er gået, eller når pladsen skal bruges."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelöschte Elemente und frühere Dateiversionen werden in einem reservierten Bereich auf ihrem eigenen Volume aufbewahrt und nach ihrer Aufbewahrungsfrist oder bei Platzbedarf entfernt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα διαγραμμένα στοιχεία και οι προηγούμενες εκδόσεις αρχείων φυλάσσονται σε δεσμευμένο χώρο στον δικό τους τόμο και αφαιρούνται μετά την περίοδο διατήρησής τους ή όταν χρειάζεται ο χώρος."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los elementos eliminados y las versiones anteriores de los archivos se guardan en un espacio reservado de su propio volumen y se eliminan al terminar su retención o cuando se necesita ese espacio."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistetut kohteet ja tiedostojen aiemmat versiot säilytetään varatussa tilassa omalla taltiollaan, ja ne poistetaan säilytysajan jälkeen tai kun tilaa tarvitaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les éléments supprimés et les versions antérieures des fichiers sont conservés dans un espace réservé sur leur propre volume, puis supprimés à la fin de leur rétention ou lorsque cet espace est nécessaire."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פריטים שנמחקו וגרסאות קודמות של קבצים נשמרים במקום שמור בכרך שלהם, ומוסרים לאחר תקופת השמירה או כשנדרש המקום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हटाए गए आइटम और फ़ाइलों के पिछले संस्करण उनके अपने वॉल्यूम पर एक आरक्षित स्थान में रखे जाते हैं, और अवधि पूरी होने पर या उस स्थान की ज़रूरत पड़ने पर हटा दिए जाते हैं।."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A törölt elemek és a fájlok korábbi verziói a saját kötetükön lévő fenntartott helyen vannak tárolva, és a megőrzési idő letelte után vagy akkor törlődnek, amikor a helyre szükség van."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Item yang dihapus dan versi file sebelumnya disimpan di ruang khusus pada volume masing-masing, lalu dihapus setelah masa simpan berakhir atau saat ruang itu dibutuhkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli elementi eliminati e le versioni precedenti dei file sono conservati in uno spazio riservato sul loro volume e rimossi alla fine della conservazione o quando serve spazio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除した項目とファイルの以前のバージョンは、各ボリューム上の予約領域に保存され、保存期間が過ぎるか、その領域が必要になると削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제된 항목과 파일의 이전 버전은 해당 볼륨의 예약 공간에 보관되며, 보존 기간이 끝나거나 공간이 필요할 때 제거됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slettede elementer og tidligere versjoner av filer oppbevares i en reservert plass på sitt eget volum, og fjernes etter oppbevaringstiden eller når plassen trengs."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijderde items en eerdere versies van bestanden worden bewaard in een gereserveerde ruimte op hun eigen volume, en gewist na hun bewaartermijn of wanneer die ruimte nodig is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunięte elementy i wcześniejsze wersje plików są przechowywane w zarezerwowanej przestrzeni na ich własnym woluminie i usuwane po okresie przechowywania lub gdy ta przestrzeń jest potrzebna."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os itens eliminados e as versões anteriores dos ficheiros ficam num espaço reservado no seu próprio volume e são removidos após o período de retenção ou quando esse espaço é necessário."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Itens excluídos e versões anteriores dos arquivos ficam em um espaço reservado no próprio volume e são removidos ao fim da retenção ou quando esse espaço é necessário."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Elementele șterse și versiunile anterioare ale fișierelor sunt păstrate într-un spațiu rezervat pe propriul volum și eliminate la finalul retenției sau când este nevoie de acel spațiu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалённые элементы и предыдущие версии файлов хранятся в зарезервированном месте на своём томе и удаляются по истечении срока хранения или когда это место нужно."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Borttagna objekt och tidigare versioner av filer sparas i ett reserverat utrymme på sin egen volym och tas bort efter lagringstiden eller när utrymmet behövs."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการที่ลบและไฟล์เวอร์ชันก่อนหน้าจะเก็บไว้ในพื้นที่สำรองบนวอลุ่มของตัวเอง และจะถูกนำออกหลังพ้นระยะเวลาเก็บรักษาหรือเมื่อต้องการพื้นที่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Silinen öğeler ve dosyaların önceki sürümleri, kendi birimlerinde ayrılmış bir alanda tutulur; saklama süresinden sonra veya bu alana ihtiyaç duyulduğunda kaldırılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалені елементи та попередні версії файлів зберігаються в зарезервованому місці на власному томі й вилучаються після завершення терміну зберігання або коли це місце потрібне."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các mục đã xóa và phiên bản trước của tệp được giữ trong một vùng dành riêng trên volume của chúng, và bị loại bỏ sau thời gian lưu giữ hoặc khi cần vùng đó."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "已删除的项目和文件的历史版本保存在其所在卷的预留空间中，在保留期结束或需要该空间时移除。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "已刪除的項目和檔案的先前版本保存在其所在卷宗的保留空間中，在保留期結束或需要該空間時移除。"
          }
        }
      }
    },
    "trashSettings.tiersHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After these tiers, one version per week is kept. An office editing session leaves one version, plus a checkpoint at most this often. Pinned versions escape the thinning and the per-file limit."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد هذه المراحل يُحتفظ بإصدار واحد كل أسبوع. تترك جلسة تحرير Office إصدارًا واحدًا، إضافة إلى نقطة تحقق بهذه الوتيرة على الأكثر. الإصدارات المثبّتة لا تخضع للتخفيف ولا لحد الملف الواحد."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Po těchto stupních se uchovává jedna verze týdně. Editační relace v Office zanechá jednu verzi a kontrolní bod nejvýše takto často. Připnuté verze se neprořeďují a nepočítají se do limitu na soubor."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Efter disse trin beholdes én version om ugen. En redigeringssession i Office efterlader én version plus et kontrolpunkt højst så ofte. Fastgjorte versioner undgår udtyndingen og grænsen pr. fil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach diesen Stufen wird eine Version pro Woche behalten. Eine Office-Bearbeitungssitzung hinterlässt eine Version, dazu höchstens in diesem Abstand einen Zwischenstand. Angeheftete Versionen sind von der Ausdünnung und der Grenze pro Datei ausgenommen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μετά από αυτά τα επίπεδα, διατηρείται μία έκδοση ανά εβδομάδα. Μια συνεδρία επεξεργασίας Office αφήνει μία έκδοση, συν ένα σημείο ελέγχου το πολύ τόσο συχνά. Οι καρφιτσωμένες εκδόσεις ξεφεύγουν από την αραίωση και το όριο ανά αρχείο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras estos niveles se conserva una versión por semana. Una sesión de edición de ofimática deja una versión, más un punto de control como mucho con esta frecuencia. Las versiones fijadas escapan al espaciado y al límite por archivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näiden portaiden jälkeen säilytetään yksi versio viikossa. Officen muokkausistunto jättää yhden version sekä tarkistuspisteen enintään tällä tiheydellä. Kiinnitetyt versiot välttävät harvennuksen ja tiedostokohtaisen rajan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au-delà de ces paliers, une version par semaine est gardée. Une session d'édition bureautique laisse une version, plus un point d'étape au plus à cette fréquence. Les versions épinglées échappent à l'espacement et à la limite par fichier."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אחרי השלבים האלה נשמרת גרסה אחת בשבוע. מפגש עריכה ב-Office משאיר גרסה אחת, ובנוסף נקודת ביקורת לכל היותר בתדירות הזו. גרסאות מוצמדות פטורות מהדילול ומהמגבלה לכל קובץ."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इन स्तरों के बाद हर सप्ताह एक संस्करण रखा जाता है। ऑफ़िस संपादन का एक सत्र एक संस्करण छोड़ता है, और इस अंतराल से अधिक बार नहीं एक चेकपॉइंट। पिन किए गए संस्करण छँटाई और प्रति फ़ाइल सीमा से मुक्त रहते हैं।."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezek a szintek után hetente egy verzió marad meg. Egy Office-szerkesztési munkamenet egy verziót hagy hátra, plusz egy ellenőrzőpontot legfeljebb ilyen gyakran. A kitűzött verziókra nem vonatkozik a ritkítás és a fájlonkénti korlát."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setelah tingkatan ini, satu versi per minggu dipertahankan. Satu sesi pengeditan Office meninggalkan satu versi, ditambah titik pemeriksaan paling sering sekian. Versi yang disematkan lolos dari pengurangan dan batas per file."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo queste fasce si conserva una versione a settimana. Una sessione di modifica office lascia una versione, più un punto di controllo al massimo con questa frequenza. Le versioni fissate sfuggono al diradamento e al limite per file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの段階の後は週に1バージョンが保持されます。Officeの編集セッションは1バージョンを残し、さらにこの間隔以上の頻度でチェックポイントを残します。ピン留めしたバージョンは間引きとファイルごとの上限の対象外です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 단계 이후에는 주당 하나의 버전이 보관됩니다. 오피스 편집 세션은 하나의 버전을 남기며, 이 간격보다 자주 체크포인트를 만들지 않습니다. 고정된 버전은 간격 정리와 파일당 한도에서 제외됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Etter disse trinnene beholdes én versjon per uke. En redigeringsøkt i Office etterlater én versjon, pluss et sjekkpunkt høyst så ofte. Festede versjoner unngår uttynningen og grensen per fil."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na deze stappen wordt één versie per week bewaard. Een Office-bewerksessie laat één versie achter, plus hooguit zo vaak een tussenstand. Vastgezette versies ontsnappen aan het uitdunnen en aan de limiet per bestand."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po tych progach zachowywana jest jedna wersja na tydzień. Sesja edycji biurowej zostawia jedną wersję i najwyżej jeden punkt kontrolny w tym odstępie. Przypięte wersje nie podlegają przerzedzaniu ani limitowi na plik."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois destes escalões, mantém-se uma versão por semana. Uma sessão de edição do Office deixa uma versão, mais um ponto de controlo no máximo com esta frequência. As versões afixadas escapam à redução e ao limite por ficheiro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois dessas faixas, uma versão por semana é guardada. Uma sessão de edição do Office deixa uma versão, mais um ponto de controle no máximo nesse intervalo. Versões fixadas escapam do espaçamento e do limite por arquivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "După aceste trepte se păstrează o versiune pe săptămână. O sesiune de editare office lasă o versiune, plus un punct de control cel mult la acest interval. Versiunile fixate scapă de rărire și de limita per fișier."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После этих ступеней хранится одна версия в неделю. Сеанс редактирования в офисном редакторе оставляет одну версию и не чаще этого интервала контрольную точку. Закреплённые версии не прореживаются и не учитываются в лимите на файл."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Efter dessa nivåer behålls en version per vecka. En redigeringssession i Office lämnar en version, plus högst en kontrollpunkt med detta intervall. Fästa versioner undantas från utglesningen och gränsen per fil."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หลังจากขั้นเหล่านี้ จะเก็บหนึ่งเวอร์ชันต่อสัปดาห์ เซสชันแก้ไขของ Office จะทิ้งหนึ่งเวอร์ชัน บวกจุดตรวจสอบอย่างถี่ที่สุดเท่านี้ เวอร์ชันที่ปักหมุดไว้จะไม่ถูกลดทอนและไม่นับรวมในขีดจำกัดต่อไฟล์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kademelerden sonra haftada bir sürüm tutulur. Bir Office düzenleme oturumu bir sürüm bırakır, ayrıca en fazla bu sıklıkta bir kontrol noktası. Sabitlenmiş sürümler seyreltmeden ve dosya başına sınırdan muaftır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після цих ступенів зберігається одна версія на тиждень. Сеанс редагування в Office залишає одну версію, плюс контрольну точку не частіше ніж зазначено. Закріплені версії не проріджуються й не враховуються в обмеженні на файл."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau các mức này, mỗi tuần giữ một phiên bản. Một phiên chỉnh sửa Office để lại một phiên bản, cộng một điểm kiểm tra với tần suất tối đa như vậy. Các phiên bản được ghim không bị thưa dần và không tính vào giới hạn mỗi tệp."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "超过这些阶段后，每周保留一个版本。一次办公文档编辑会话保留一个版本，检查点不会比此间隔更频繁。已固定的版本不受稀疏和每文件上限影响。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "超過這些階段後，每週保留一個版本。一次 Office 編輯工作階段保留一個版本，檢查點不會比此間隔更頻繁。已釘選的版本不受稀疏與每檔案上限影響。"
          }
        }
      }
    },
