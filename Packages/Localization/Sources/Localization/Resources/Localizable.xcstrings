        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह केवल स्थानीय प्रति हटाता है। फ़ाइल सर्वर पर बनी रहती है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez csak a helyi másolatot távolítja el. A fájl a kiszolgálón marad."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini hanya menghapus salinan lokal. File tetap ada di server."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo rimuove solo la copia locale. Il file resta sul server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルコピーのみを削除します。ファイルはサーバーに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 사본만 제거됩니다. 파일은 서버에 남아 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette fjerner bare den lokale kopien. Filen blir liggende på serveren."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee wordt alleen de lokale kopie verwijderd. Het bestand blijft op de server."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to usunięcie tylko lokalnej kopii. Plik pozostaje na serwerze."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto apenas remove a cópia local. O ficheiro permanece no servidor."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto apenas remove a cópia local. O arquivo permanece no servidor."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceasta elimină doar copia locală. Fișierul rămâne pe server."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
