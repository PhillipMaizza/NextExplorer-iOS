    "browse.deleteLinkedSharesUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't check for share links that point here. Any that exist will stop working."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر التحقق من الروابط التي تشير إلى هنا. أي روابط موجودة ستتوقف عن العمل."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepodařilo se zkontrolovat odkazy ke sdílení, které sem vedou. Případné stávající přestanou fungovat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Delingslinks, der peger hertil, kunne ikke kontrolleres. Eksisterende links holder op med at virke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Links, die hierher verweisen, konnten nicht geprüft werden. Vorhandene Links funktionieren dann nicht mehr."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατός ο έλεγχος των συνδέσμων κοινοποίησης που οδηγούν εδώ. Όσοι υπάρχουν θα σταματήσουν να λειτουργούν."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron comprobar los enlaces que apuntan aquí. Los que existan dejarán de funcionar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tänne osoittavia jakolinkkejä ei voitu tarkistaa. Mahdolliset olemassa olevat linkit lakkaavat toimimasta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de vérifier les liens pointant ici. Ceux qui existent cesseront de fonctionner."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה לבדוק קישורי שיתוף שמצביעים לכאן. קישורים קיימים יפסיקו לעבוד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहां इंगित करने वाले लिंक जांच नहीं सके। जो मौजूद हैं वे काम करना बंद कर देंगे।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az ide mutató megosztási hivatkozásokat nem sikerült ellenőrizni. A meglévők megszűnnek működni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat memeriksa tautan berbagi yang mengarah ke sini. Tautan yang ada akan berhenti berfungsi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile verificare i link che puntano qui. Quelli esistenti smetteranno di funzionare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここを指すリンクを確認できませんでした。存在するリンクは機能しなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기를 가리키는 링크를 확인할 수 없습니다. 존재하는 링크는 작동을 멈춥니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke sjekke delingslenker som peker hit. Eventuelle eksisterende lenker slutter å virke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan de links die hierheen verwijzen niet controleren. Bestaande links werken niet meer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można sprawdzić linków wskazujących tutaj. Istniejące przestaną działać."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar as ligações que apontam para aqui. As existentes deixarão de funcionar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
