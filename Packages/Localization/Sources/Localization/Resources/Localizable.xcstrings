    "uploads.cameraDeniedMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow camera access in Settings to take a photo or video."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح بالوصول إلى الكاميرا في الإعدادات لالتقاط صورة أو فيديو."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povolte v Nastavení přístup k fotoaparátu, abyste mohli pořídit fotku nebo video."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillad adgang til kameraet i Indstillinger for at tage et foto eller en video."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube den Kamerazugriff in den Einstellungen, um ein Foto oder Video aufzunehmen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιτρέψτε την πρόσβαση στην κάμερα στις Ρυθμίσεις για να τραβήξετε φωτογραφία ή βίντεο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso a la cámara en Ajustes para hacer una foto o vídeo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salli kameran käyttö Asetuksissa ottaaksesi kuvan tai videon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l'accès à l'appareil photo dans Réglages pour prendre une photo ou une vidéo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשרו גישה למצלמה בהגדרות כדי לצלם תמונה או וידאו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोटो या वीडियो लेने के लिए सेटिंग्स में कैमरा एक्सेस की अनुमति दें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Engedélyezze a kamerahozzáférést a Beállításokban fénykép vagy videó készítéséhez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan akses kamera di Pengaturan untuk mengambil foto atau video."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti l'accesso alla fotocamera in Impostazioni per scattare una foto o un video."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真やビデオを撮るには、設定でカメラへのアクセスを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진이나 동영상을 촬영하려면 설정에서 카메라 접근을 허용하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gi tilgang til kameraet i Innstillinger for å ta et bilde eller en video."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta cameratoegang toe in Instellingen om een foto of video te maken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól na dostęp do aparatu w Ustawieniach, aby zrobić zdjęcie lub wideo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso à câmara nas Definições para tirar uma foto ou vídeo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso à câmera em Configurações para tirar uma foto ou gravar um vídeo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite accesul la cameră în Setări pentru a face o fotografie sau un videoclip."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите доступ к камере в Настройках, чтобы сделать фото или видео."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillåt kameraåtkomst i Inställningar för att ta ett foto eller en video."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตการเข้าถึงกล้องในการตั้งค่าเพื่อถ่ายภาพหรือวิดีโอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraf veya video çekmek için Ayarlar'da kamera erişimine izin verin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозвольте доступ до камери в Налаштуваннях, щоб зробити фото чи відео."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy cho phép truy cập camera trong Cài đặt để chụp ảnh hoặc quay video."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“设置”中允许相机访问，以便拍照或录像。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「設定」中允許相機取用，以便拍照或錄影。"
          }
        }
      }
    },
