    "login.codeIntroAuthenticator": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account asks for a second step. Enter the 6 digit code from your authenticator app."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطلب هذا الحساب خطوة ثانية. أدخل الرمز المكوّن من 6 أرقام من تطبيق المصادقة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento účet vyžaduje druhý krok. Zadejte 6místný kód z ověřovací aplikace."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne konto kræver et ekstra trin. Indtast den 6-cifrede kode fra din godkendelsesapp."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Konto verlangt einen zweiten Schritt. Gib den 6-stelligen Code aus deiner Authenticator-App ein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτός ο λογαριασμός ζητά δεύτερο βήμα. Εισαγάγετε τον 6ψήφιο κωδικό από την εφαρμογή ελέγχου ταυτότητας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cuenta pide un segundo paso. Introduce el código de 6 dígitos de tu app de autenticación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä tili pyytää toista vaihetta. Syötä 6-numeroinen koodi todennussovelluksestasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce compte demande une seconde étape. Saisissez le code à 6 chiffres de votre app d'authentification."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החשבון הזה מבקש שלב שני. הזינו את הקוד בן 6 הספרות מאפליקציית האימות שלכם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह खाता दूसरा चरण मांगता है। अपने ऑथेंटिकेटर ऐप से 6 अंकों का कोड दर्ज करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a fiók második lépést kér. Adja meg a hitelesítő alkalmazás 6 számjegyű kódját."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akun ini meminta langkah kedua. Masukkan kode 6 digit dari aplikasi autentikator Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo account richiede un secondo passaggio. Inserisci il codice a 6 cifre della tua app di autenticazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントでは2段階目の認証が必要です。認証アプリに表示される 6 桁のコードを入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계정은 두 번째 단계가 필요합니다. 인증 앱의 6자리 코드를 입력하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne kontoen krever et ekstra trinn. Skriv inn den sekssifrede koden fra autentiseringsappen din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor dit account is een tweede stap nodig. Voer de 6-cijferige code uit je authenticatie-app in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To konto wymaga dodatkowego kroku. Wpisz 6-cyfrowy kod z aplikacji uwierzytelniającej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conta pede um segundo passo. Introduza o código de 6 dígitos da sua aplicação de autenticação."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conta pede uma segunda etapa. Digite o código de 6 dígitos do seu app autenticador."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest cont cere un al doilea pas. Introdu codul din 6 cifre din aplicația ta de autentificare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для этой учётной записи нужен второй шаг. Введите 6-значный код из приложения-аутентификатора."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här kontot kräver ett andra steg. Ange den sexsiffriga koden från din autentiseringsapp."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บัญชีนี้ขอขั้นตอนที่สอง ป้อนรหัส 6 หลักจากแอปยืนยันตัวตนของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hesap ikinci bir adım istiyor. Kimlik doğrulayıcı uygulamanızdaki 6 haneli kodu girin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей обліковий запис вимагає другого кроку. Введіть 6-значний код із вашого застосунку-автентифікатора."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản này yêu cầu bước thứ hai. Hãy nhập mã 6 chữ số từ ứng dụng xác thực của bạn."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此账户需要进行第二步验证。请输入验证器 App 中的 6 位验证码。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "此帳號需要進行第二步驗證。請輸入驗證器 App 中的 6 位數驗證碼。"
          }
        }
      }
    },
    "login.codeIntroRecovery": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter one of your recovery codes. Each one works only once."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل أحد رموز الاسترداد. يعمل كل رمز مرة واحدة فقط."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadejte jeden ze svých záložních kódů. Každý funguje jen jednou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indtast en af dine gendannelseskoder. Hver kode virker kun én gang."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib einen deiner Wiederherstellungscodes ein. Jeder funktioniert nur einmal."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εισαγάγετε έναν από τους κωδικούς ανάκτησής σας. Καθένας λειτουργεί μόνο μία φορά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce uno de tus códigos de recuperación. Cada uno funciona solo una vez."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Syötä jokin palautuskoodeistasi. Jokainen toimii vain kerran."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez l'un de vos codes de récupération. Chacun ne fonctionne qu'une seule fois."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הזינו אחד מקודי השחזור שלכם. כל אחד פועל פעם אחת בלבד."
