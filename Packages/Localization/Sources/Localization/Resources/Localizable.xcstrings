    "uploadSettings.chunkedEnableHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use TUS to send large files through multiple smaller requests."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم TUS لإرسال الملفات الكبيرة عبر عدة طلبات أصغر."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Používá TUS k odesílání velkých souborů několika menšími požadavky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruger TUS til at sende store filer i flere mindre forespørgsler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet TUS, um große Dateien über mehrere kleinere Anfragen zu senden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποιεί το TUS για την αποστολή μεγάλων αρχείων με πολλά μικρότερα αιτήματα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa TUS para enviar archivos grandes en varias solicitudes más pequeñas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käyttää TUS:ia suurten tiedostojen lähettämiseen useissa pienemmissä pyynnöissä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise TUS pour envoyer les gros fichiers en plusieurs requêtes plus petites."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משתמש ב-TUS כדי לשלוח קבצים גדולים בכמה בקשות קטנות יותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बड़ी फ़ाइलों को कई छोटे अनुरोधों के माध्यम से भेजने के लिए TUS का उपयोग करें।."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A TUS használatával a nagy fájlokat több kisebb kérésben küldi el."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menggunakan TUS untuk mengirim file besar melalui beberapa permintaan yang lebih kecil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa TUS per inviare file di grandi dimensioni tramite più richieste più piccole."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TUSを使い、大きなファイルを複数の小さなリクエストに分けて送信します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TUS를 사용하여 대용량 파일을 여러 개의 작은 요청으로 나누어 전송합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruker TUS til å sende store filer i flere mindre forespørsler."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik TUS om grote bestanden in meerdere kleinere verzoeken te verzenden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wykorzystuje protokół TUS, aby wysyłać duże pliki w wielu mniejszych żądaniach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliza o TUS para enviar ficheiros grandes em vários pedidos mais pequenos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar o TUS para enviar arquivos grandes por meio de várias requisições menores."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folosește TUS pentru a trimite fișierele mari prin mai multe cereri mai mici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использует TUS для отправки больших файлов несколькими меньшими запросами."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd TUS för att skicka stora filer via flera mindre förfrågningar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ TUS เพื่อส่งไฟล์ขนาดใหญ่ผ่านคำขอที่เล็กลงหลายคำขอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Büyük dosyaları birden çok küçük istekle göndermek için TUS kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовує TUS для надсилання великих файлів кількома меншими запитами."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng TUS để gửi tệp lớn qua nhiều yêu cầu nhỏ hơn."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 TUS 通过多个较小的请求发送大文件。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 TUS 透過多個較小的請求傳送大型檔案。"
          }
        }
      }
    },
