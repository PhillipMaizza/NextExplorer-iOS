          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Overschrijf lees- en schrijftoegang voor specifieke paden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastąp dostęp do odczytu i zapisu dla określonych ścieżek."
