    "settings.removeAllDownloadsMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This deletes every downloaded file from this device. They stay on the server."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي هذا إلى حذف كل ملف تم تنزيله من هذا الجهاز. تبقى على الخادم."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tím se z tohoto zařízení smažou všechny stažené soubory. Na serveru zůstanou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette sletter hver hentet fil fra denne enhed. De forbliver på serveren."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies löscht jede geladene Datei von diesem Gerät. Sie bleiben auf dem Server."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό διαγράφει κάθε αρχείο που έχει ληφθεί από αυτήν τη συσκευή. Παραμένουν στον διακομιστή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina todos los archivos descargados de este dispositivo. Permanecen en el servidor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä poistaa kaikki ladatut tiedostot tästä laitteesta. Ne säilyvät palvelimella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime tous les fichiers téléchargés de cet appareil. Ils restent sur le serveur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולה זו מוחקת כל קובץ שהורד ממכשיר זה. הקבצים נשארים בשרת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह इस डिवाइस से हर डाउनलोड की गई फ़ाइल हटा देता है। वे सर्वर पर बनी रहती हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez minden letöltött fájlt töröl erről az eszközről. A kiszolgálón megmaradnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini menghapus semua file yang diunduh dari perangkat ini. File tetap ada di server."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo elimina ogni file scaricato da questo dispositivo. Restano sul server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスからすべてのダウンロード済みファイルを削除します。サーバーには残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 다운로드한 모든 파일을 삭제합니다. 서버에는 남아 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette sletter alle nedlastede filer fra denne enheten. De blir liggende på serveren."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee worden alle gedownloade bestanden van dit apparaat verwijderd. Ze blijven op de server."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to usunięcie wszystkich pobranych plików z tego urządzenia. Pozostają one na serwerze."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto elimina todos os ficheiros transferidos deste dispositivo. Permanecem no servidor."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto exclui todos os arquivos baixados deste dispositivo. Eles continuam no servidor."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceasta șterge toate fișierele descărcate de pe acest dispozitiv. Rămân pe server."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это удалит все загруженные файлы с этого устройства. Они останутся на сервере."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta raderar alla nedladdade filer från den här enheten. De finns kvar på servern."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดำเนินการนี้จะลบไฟล์ที่ดาวน์โหลดทุกไฟล์ออกจากอุปกรณ์เครื่องนี้ ไฟล์ยังอยู่บนเซิร์ฟเวอร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem indirilen her dosyayı bu cihazdan siler. Dosyalar sunucuda kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це видалить усі завантажені файли з цього пристрою. Вони залишаться на сервері."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này xóa mọi tệp đã tải xuống khỏi thiết bị này. Chúng vẫn còn trên máy chủ."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
