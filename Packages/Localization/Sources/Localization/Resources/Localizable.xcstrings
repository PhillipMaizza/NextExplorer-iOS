    "accessRules.emptyHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a rule to override access for a path."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف قاعدة لتجاوز الوصول إلى مسار."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge eine Regel hinzu, um den Zugriff auf einen Pfad zu überschreiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una regla para anular el acceso a una ruta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez une règle pour remplacer l'accès à un chemin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी पथ के एक्सेस को ओवरराइड करने के लिए एक नियम जोड़ें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi una regola per sovrascrivere l'accesso a un percorso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスのアクセスを上書きするルールを追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "경로 접근을 재정의하려면 규칙을 추가하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg een regel toe om de toegang tot een pad te overschrijven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj regułę, aby zastąpić dostęp do ścieżki."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione uma regra para substituir o acesso a um caminho."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaugă o regulă pentru a suprascrie accesul la o cale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте правило, чтобы переопределить доступ к пути."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till en regel för att åsidosätta åtkomst till en sökväg."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "添加规则以覆盖对某路径的访问权限。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "加入規則以覆寫對某路徑的取用權限。"
          }
        }
