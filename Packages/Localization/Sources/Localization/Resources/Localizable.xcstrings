    "media.clientCertificateUnsupported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This format can't stream from a server that asks for a client certificate. Download the file to play it."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن بث هذا التنسيق من خادم يطلب شهادة عميل. نزّل الملف لتشغيله."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento formát nelze streamovat ze serveru, který vyžaduje klientský certifikát. Stáhněte soubor a přehrajte ho."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette format kan ikke streames fra en server, der kræver et klientcertifikat. Hent filen for at afspille den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Format kann nicht von einem Server gestreamt werden, der ein Client-Zertifikat verlangt. Lade die Datei herunter, um sie abzuspielen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η μορφή δεν μπορεί να αναπαραχθεί ως ροή από διακομιστή που ζητά πιστοποιητικό πελάτη. Κάντε λήψη του αρχείου για να το αναπαραγάγετε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este formato no se puede reproducir en streaming desde un servidor que pide un certificado de cliente. Descarga el archivo para reproducirlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tätä muotoa ei voi suoratoistaa palvelimelta, joka pyytää asiakasvarmennetta. Lataa tiedosto toistaaksesi sen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce format ne peut pas être lu en streaming depuis un serveur qui demande un certificat client. Téléchargez le fichier pour le lire."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן להזרים פורמט זה משרת שמבקש אישור לקוח. הורידו את הקובץ כדי להפעיל אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्लाइंट सर्टिफ़िकेट माँगने वाले सर्वर से यह फ़ॉर्मेट स्ट्रीम नहीं हो सकता। चलाने के लिए फ़ाइल डाउनलोड करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a formátum nem streamelhető olyan kiszolgálóról, amely kliens tanúsítványt kér. Töltse le a fájlt a lejátszáshoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Format ini tidak dapat di-streaming dari server yang meminta sertifikat klien. Unduh file untuk memutarnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo formato non può essere riprodotto in streaming da un server che richiede un certificato client. Scarica il file per riprodurlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クライアント証明書を要求するサーバーからは、この形式をストリーミング再生できません。ファイルをダウンロードして再生してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클라이언트 인증서를 요청하는 서버에서는 이 형식을 스트리밍할 수 없습니다. 파일을 다운로드하여 재생하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette formatet kan ikke strømmes fra en server som ber om et klientsertifikat. Last ned filen for å spille den av."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit formaat kan niet worden gestreamd vanaf een server die om een clientcertificaat vraagt. Download het bestand om het af te spelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tego formatu nie można strumieniować z serwera, który prosi o certyfikat klienta. Pobierz plik, aby go odtworzyć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este formato não pode ser transmitido a partir de um servidor que pede um certificado de cliente. Descarregue o ficheiro para o reproduzir."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este formato não pode ser transmitido de um servidor que exige certificado de cliente. Baixe o arquivo para reproduzi-lo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest format nu poate fi redat în streaming de pe un server care cere un certificat de client. Descarcă fișierul pentru a-l reda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот формат нельзя воспроизвести потоком с сервера, который запрашивает клиентский сертификат. Скачайте файл, чтобы воспроизвести его."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här formatet kan inte strömmas från en server som ber om ett klientcertifikat. Hämta filen för att spela upp den."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถสตรีมรูปแบบนี้จากเซิร์ฟเวอร์ที่ขอใบรับรองไคลเอนต์ ดาวน์โหลดไฟล์เพื่อเล่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu biçim, istemci sertifikası isteyen bir sunucudan akış olarak oynatılamaz. Oynatmak için dosyayı indirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей формат не можна передавати потоком із сервера, що запитує клієнтський сертифікат. Завантажте файл, щоб відтворити його."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Định dạng này không thể phát trực tuyến từ máy chủ yêu cầu chứng chỉ máy khách. Hãy tải tệp xuống để phát."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "无法从要求客户端证书的服务器流式播放此格式。请下载文件后播放。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "無法從要求用戶端憑證的伺服器串流播放此格式。請下載檔案後播放。"
          }
        }
      }
    },
