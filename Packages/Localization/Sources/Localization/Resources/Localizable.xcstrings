    "shared.deleteMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The link stops working immediately. The file or folder itself isn't touched."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتوقف الرابط عن العمل فورًا. لا يتأثر الملف أو المجلد نفسه."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odkaz okamžitě přestane fungovat. Samotného souboru ani složky se to netýká."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Linket holder straks op med at virke. Selve filen eller mappen berøres ikke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Link funktioniert sofort nicht mehr. Die Datei oder der Ordner selbst wird nicht berührt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο σύνδεσμος σταματά να λειτουργεί αμέσως. Το ίδιο το αρχείο ή ο φάκελος δεν επηρεάζεται."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El enlace deja de funcionar de inmediato. El archivo o carpeta en sí no se modifica."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Linkki lakkaa toimimasta heti. Itse tiedostoon tai kansioon ei kosketa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lien cesse de fonctionner immédiatement. Le fichier ou le dossier lui-même n'est pas touché."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקישור מפסיק לעבוד מיד. הקובץ או התיקייה עצמם לא ייפגעו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लिंक तुरंत काम करना बंद कर देता है। फ़ाइल या फ़ोल्डर स्वयं प्रभावित नहीं होता।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hivatkozás azonnal megszűnik működni. Magához a fájlhoz vagy mappához nem nyúlunk."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tautan langsung berhenti berfungsi. File atau folder itu sendiri tidak terpengaruh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il link smette di funzionare immediatamente. Il file o la cartella non viene toccato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクはすぐに機能しなくなります。ファイルやフォルダ自体には影響しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크가 즉시 작동을 멈춥니다. 파일이나 폴더 자체는 영향을 받지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lenken slutter å virke umiddelbart. Selve filen eller mappen berøres ikke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De link werkt onmiddellijk niet meer. Het bestand of de map zelf blijft ongemoeid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Link natychmiast przestaje działać. Sam plik ani folder nie zostaje naruszony."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A ligação deixa de funcionar de imediato. O ficheiro ou pasta em si não é afetado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O link deixa de funcionar imediatamente. O arquivo ou a pasta em si não é afetado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Linkul încetează să funcționeze imediat. Fișierul sau dosarul în sine nu este afectat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ссылка сразу перестанет работать. Сам файл или папка не затрагиваются."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Länken slutar fungera omedelbart. Själva filen eller mappen påverkas inte."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลิงก์จะหยุดทำงานทันที ตัวไฟล์หรือโฟลเดอร์จะไม่ได้รับผลกระทบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı hemen çalışmayı durdurur. Dosya veya klasörün kendisine dokunulmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Посилання одразу перестане працювати. Сам файл чи папка не змінюються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liên kết sẽ ngừng hoạt động ngay lập tức. Bản thân tệp hoặc thư mục không bị ảnh hưởng."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "链接会立即停止工作。文件或文件夹本身不受影响。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "連結會立即停止運作。檔案或檔案夾本身不受影響。"
          }
        }
      }
    },
