    "error.offline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're offline. Connect to the internet and try again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت غير متصل. اتصل بالإنترنت وأعد المحاولة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jste offline. Připojte se k internetu a zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er offline. Opret forbindelse til internettet, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist offline. Verbinde dich mit dem Internet und versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είστε εκτός σύνδεσης. Συνδεθείτε στο διαδίκτυο και δοκιμάστε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás sin conexión. Conéctate a internet e inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olet offline-tilassa. Yhdistä internetiin ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes hors ligne. Connectez-vous à Internet et réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אתם במצב לא מקוון. התחברו לאינטרנט ונסו שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप ऑफ़लाइन हैं। इंटरनेट से कनेक्ट करें और पुनः प्रयास करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline van. Csatlakozzon az internethez, és próbálja újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda sedang offline. Hubungkan ke internet dan coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei offline. Connettiti a internet e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフラインです。インターネットに接続して再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인 상태입니다. 인터넷에 연결하고 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er frakoblet. Koble til internett og prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent offline. Maak verbinding met internet en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jesteś offline. Połącz się z internetem i spróbuj ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Está offline. Ligue-se à internet e tente novamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está offline. Conecte-se à internet e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ești offline. Conectează-te la internet și încearcă din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы офлайн. Подключитесь к интернету и повторите попытку."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du är offline. Anslut till internet och försök igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณออฟไลน์อยู่ เชื่อมต่ออินเทอร์เน็ตแล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çevrimdışısınız. İnternete bağlanıp tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви офлайн. Підключіться до інтернету й спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đang ngoại tuyến. Hãy kết nối internet và thử lại."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "您已离线。请连接到互联网后重试。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "您已離線。請連線到網際網路後重試。"
          }
        }
      }
    },
    "error.rateLimited": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many requests. Try again shortly."
          }
