    "settings.accountSignOutMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign %@ out on this device? You'll need to sign in again to use this account."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجيل خروج %@ من هذا الجهاز؟ ستحتاج إلى تسجيل الدخول مرة أخرى لاستخدام هذا الحساب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ auf diesem Gerät abmelden? Du musst dich erneut anmelden, um dieses Konto zu verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cerrar la sesión de %@ en este dispositivo? Deberás iniciar sesión de nuevo para usar esta cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déconnecter %@ de cet appareil ? Vous devrez vous reconnecter pour utiliser ce compte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस पर %@ को साइन आउट करें? इस खाते का उपयोग करने के लिए आपको फिर से साइन इन करना होगा."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnettere %@ da questo dispositivo? Dovrai accedere di nuovo per usare questo account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスで %@ をサインアウトしますか？このアカウントを使うには再度サインインする必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 %@ 계정을 로그아웃할까요? 이 계정을 사용하려면 다시 로그인해야 합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ afmelden op dit apparaat? Je moet opnieuw inloggen om dit account te gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wylogować %@ na tym urządzeniu? Aby korzystać z tego konta, trzeba będzie zalogować się ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminar a sessão de %@ neste dispositivo? Terá de iniciar sessão novamente para usar esta conta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deconectezi %@ de pe acest dispozitiv? Va trebui să te autentifici din nou pentru a folosi acest cont."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выйти из аккаунта %@ на этом устройстве? Чтобы снова использовать этот аккаунт, потребуется войти заново."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Logga ut %@ på den här enheten? Du måste logga in igen för att använda det här kontot."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "在此设备上退出 %@ 吗？您需要重新登录才能使用此账户。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "要在此裝置上登出 %@ 嗎？您需要重新登入才能使用此帳戶。"
          }
        }
      }
    },
