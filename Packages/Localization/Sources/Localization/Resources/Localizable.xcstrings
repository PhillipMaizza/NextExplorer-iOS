    "offline.preferOfflineSubtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a downloaded video instead of streaming when it's available."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم مقطع فيديو تم تنزيله بدلاً من البث عندما يكون متاحًا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použít stažené video místo streamování, když je k dispozici."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug en hentet video i stedet for streaming, når den er tilgængelig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein heruntergeladenes Video abspielen statt zu streamen, wenn es verfügbar ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρήση ληφθέντος βίντεο αντί ροής όταν είναι διαθέσιμο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar un vídeo descargado en lugar de transmitirlo cuando esté disponible."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytä ladattua videota suoratoiston sijaan, kun se on saatavilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser une vidéo téléchargée au lieu de la diffuser lorsqu'elle est disponible."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שימוש בסרטון שהורד במקום סטרימינג כשהוא זמין."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उपलब्ध होने पर स्ट्रीम करने के बजाय डाउनलोड किया गया वीडियो उपयोग करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Használja a letöltött videót a streamelés helyett, ha elérhető."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan video yang diunduh alih-alih streaming bila tersedia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un video scaricato invece dello streaming quando è disponibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用可能な場合はストリーミングの代わりにダウンロードした動画を使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용 가능할 때 스트리밍 대신 다운로드한 동영상을 사용합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk en nedlastet video i stedet for strømming når den er tilgjengelig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een gedownloade video gebruiken in plaats van streamen wanneer die beschikbaar is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Używaj pobranego wideo zamiast strumieniowania, gdy jest dostępne."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar um vídeo transferido em vez de o transmitir, quando estiver disponível."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar um vídeo baixado em vez de transmitir quando estiver disponível."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folosește un videoclip descărcat în loc de streaming când este disponibil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использовать загруженное видео вместо потоковой передачи, когда оно доступно."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd en hämtad video i stället för att strömma när den finns."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้วิดีโอที่ดาวน์โหลดแทนการสตรีมเมื่อมีให้ใช้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İndirilmiş bir video varsa akış yerine onu kullan."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовувати завантажене відео замість потокової передачі, коли воно доступне."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng video đã tải xuống thay vì phát trực tuyến khi có sẵn."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "可用时使用已下载的视频而非流式播放。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "可用時使用已下載的影片而非串流播放。"
          }
        }
      }
    },
