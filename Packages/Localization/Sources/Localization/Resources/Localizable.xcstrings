    "settings.storageFootnote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folders download as a zip, with nothing left behind on the server. Removing downloads or clearing the cache only affects this device; nothing on the server is touched."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُنزَّل المجلدات كملف ZIP دون ترك أي شيء على الخادم. إزالة التنزيلات أو مسح ذاكرة التخزين المؤقت يؤثر على هذا الجهاز فقط؛ لا يتأثر أي شيء على الخادم."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Složky se stahují jako zip, na serveru nezůstane nic. Odebrání stažených souborů nebo vymazání mezipaměti se týká jen tohoto zařízení; na serveru se nic nemění."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mapper hentes som zip uden at efterlade noget på serveren. Fjernelse af downloads eller rydning af cachen påvirker kun denne enhed; intet på serveren berøres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordner werden als ZIP geladen, ohne etwas auf dem Server zu hinterlassen. Das Entfernen von Downloads oder das Leeren des Caches betrifft nur dieses Gerät; auf dem Server wird nichts berührt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι φάκελοι κατεβαίνουν ως zip, χωρίς να μένει τίποτα στον διακομιστή. Η αφαίρεση λήψεων ή η εκκαθάριση της προσωρινής μνήμης επηρεάζει μόνο αυτήν τη συσκευή· τίποτα στον διακομιστή δεν αγγίζεται."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las carpetas se descargan como ZIP sin dejar nada en el servidor. Eliminar descargas o vaciar la caché solo afecta a este dispositivo; no se toca nada en el servidor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kansiot ladataan zip-tiedostoina jättämättä mitään palvelimelle. Latausten poistaminen tai välimuistin tyhjentäminen vaikuttaa vain tähän laitteeseen; palvelimella ei muuteta mitään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dossiers se téléchargent en ZIP, sans rien laisser sur le serveur. Supprimer les téléchargements ou vider le cache n'affecte que cet appareil ; rien n'est modifié sur le serveur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תיקיות מורדות כקובץ ZIP, בלי להשאיר דבר בשרת. הסרת הורדות או ניקוי המטמון משפיעים רק על מכשיר זה; דבר לא משתנה בשרת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोल्डर ZIP के रूप में डाउनलोड होते हैं, सर्वर पर कुछ भी नहीं छूटता। डाउनलोड हटाने या कैश साफ़ करने से केवल यह डिवाइस प्रभावित होता है; सर्वर पर कुछ नहीं बदलता।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mappák zip-ként töltődnek le, és semmi sem marad a kiszolgálón. A letöltések eltávolítása vagy a gyorsítótár ürítése csak ezt az eszközt érinti; a kiszolgálón semmihez sem nyúlunk."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder diunduh sebagai zip, tanpa meninggalkan apa pun di server. Menghapus unduhan atau cache hanya memengaruhi perangkat ini; tidak ada yang berubah di server."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cartelle si scaricano come ZIP, senza lasciare nulla sul server. Rimuovere i download o svuotare la cache riguarda solo questo dispositivo; sul server non viene toccato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダは ZIP としてダウンロードされ、サーバーには何も残りません。ダウンロードの削除やキャッシュの消去はこのデバイスにのみ影響し、サーバー上のものには影響しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더는 ZIP으로 다운로드되며 서버에는 아무것도 남지 않습니다. 다운로드를 삭제하거나 캐시를 지워도 이 기기에만 적용되며 서버에는 영향을 주지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mapper lastes ned som zip, uten at noe blir liggende igjen på serveren. Å fjerne nedlastinger eller tømme hurtigbufferen påvirker bare denne enheten; ingenting på serveren berøres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mappen worden als ZIP gedownload, zonder iets op de server achter te laten. Downloads verwijderen of de cache wissen heeft alleen invloed op dit apparaat; op de server verandert niets."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Foldery są pobierane jako ZIP i nic nie zostaje na serwerze. Usuwanie pobranych plików lub czyszczenie pamięci podręcznej dotyczy tylko tego urządzenia; na serwerze nic się nie zmienia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As pastas são transferidas em formato ZIP, sem deixar nada no servidor. Remover transferências ou limpar a cache afeta apenas este dispositivo; nada no servidor é alterado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As pastas são baixadas como ZIP, sem deixar nada no servidor. Remover downloads ou limpar o cache afeta apenas este dispositivo; nada no servidor é alterado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosarele se descarcă ca ZIP, fără să rămână nimic pe server. Ștergerea descărcărilor sau golirea cache-ului afectează doar acest dispozitiv; nimic de pe server nu este modificat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Папки загружаются в виде ZIP, на сервере ничего не остаётся. Удаление загрузок или очистка кэша затрагивает только это устройство; на сервере ничего не меняется."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mappar laddas ned som ZIP utan att något lämnas kvar på servern. Att ta bort nedladdningar eller rensa cachen påverkar bara den här enheten; inget på servern ändras."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โฟลเดอร์จะดาวน์โหลดเป็นไฟล์ zip โดยไม่ทิ้งสิ่งใดไว้บนเซิร์ฟเวอร์ การนำการดาวน์โหลดออกหรือล้างแคชมีผลเฉพาะอุปกรณ์เครื่องนี้ ไม่มีสิ่งใดบนเซิร์ฟเวอร์ถูกแตะต้อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klasörler zip olarak indirilir, sunucuda hiçbir şey bırakılmaz. İndirilenleri kaldırmak veya önbelleği temizlemek yalnızca bu cihazı etkiler; sunucudaki hiçbir şeye dokunulmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Папки завантажуються як zip, нічого не лишаючи на сервері. Вилучення завантажень чи очищення кешу стосується лише цього пристрою; на сервері нічого не змінюється."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thư mục được tải xuống dưới dạng zip, không để lại gì trên máy chủ. Xóa tệp đã tải xuống hoặc bộ nhớ đệm chỉ ảnh hưởng đến thiết bị này; không có gì trên máy chủ bị thay đổi."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "文件夹以 ZIP 形式下载，服务器上不会留下任何文件。删除下载或清除缓存只影响此设备，不会改动服务器上的任何内容。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "資料夾以 ZIP 形式下載，伺服器上不會留下任何檔案。刪除下載或清除快取只會影響此裝置，不會更動伺服器上的任何內容。"
          }
        }
      }
    },
