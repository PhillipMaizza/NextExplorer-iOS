    "activityLog.enabledHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-ins, downloads, uploads, deletions, restores, share links and account changes are written down while this is on. Nothing before it was switched on is there."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُدوَّن عمليات تسجيل الدخول والتنزيل والرفع والحذف والاستعادة وروابط المشاركة وتغييرات الحساب ما دام هذا الخيار مفعّلًا. ما حدث قبل تفعيله غير موجود."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přihlášení, stahování, nahrávání, mazání, obnovení, odkazy ke sdílení a změny účtů se zapisují, dokud je to zapnuté. Co se stalo před zapnutím, tu není."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Logins, downloads, uploads, sletninger, gendannelser, delingslinks og kontoændringer registreres, mens dette er slået til. Det, der skete før, er ikke med."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmeldungen, Downloads, Uploads, Löschungen, Wiederherstellungen, Freigabelinks und Kontoänderungen werden aufgezeichnet, solange dies aktiv ist. Was davor geschah, steht nicht darin."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι συνδέσεις, οι λήψεις, οι μεταφορτώσεις, οι διαγραφές, οι επαναφορές, οι σύνδεσμοι κοινοποίησης και οι αλλαγές λογαριασμών καταγράφονται όσο αυτό είναι ενεργό. Ό,τι έγινε πριν δεν περιλαμβάνεται."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicios de sesión, descargas, subidas, eliminaciones, restauraciones, enlaces y cambios de cuenta se anotan mientras esté activo. Lo anterior a activarlo no aparece."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjautumiset, lataukset, lähetykset, poistot, palautukset, jakolinkit ja tilimuutokset kirjataan, kun tämä on päällä. Ennen käyttöönottoa tapahtunutta ei ole mukana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connexions, téléchargements, envois, suppressions, restaurations, liens de partage et modifications de compte sont consignés tant que c’est actif. Rien de ce qui précède l’activation n’y figure."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התחברויות, הורדות, העלאות, מחיקות, שחזורים, קישורי שיתוף ושינויים בחשבון נרשמים כל עוד האפשרות מופעלת. מה שקרה לפני ההפעלה לא מופיע כאן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब तक यह चालू है, साइन-इन, डाउनलोड, अपलोड, विलोपन, पुनर्स्थापन, साझा लिंक और खाते के बदलाव दर्ज होते हैं। इससे पहले जो हुआ, वह इसमें नहीं है।."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A bejelentkezések, letöltések, feltöltések, törlések, visszaállítások, megosztási hivatkozások és fiókmódosítások rögzítésre kerülnek, amíg ez be van kapcsolva. A bekapcsolás előtt történtek nem szerepelnek benne."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Login, unduhan, unggahan, penghapusan, pemulihan, tautan berbagi, dan perubahan akun dicatat selama ini aktif. Apa yang terjadi sebelum diaktifkan tidak ada di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessi, download, caricamenti, eliminazioni, ripristini, link di condivisione e modifiche all’account vengono annotati finché è attivo. Quello che è successo prima non c’è."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンの間、サインイン、ダウンロード、アップロード、削除、復元、共有リンク、アカウントの変更が記録されます。オンにする前の操作は含まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜져 있는 동안 로그인, 다운로드, 업로드, 삭제, 복원, 공유, 계정 변경이 기록됩니다. 켜기 전의 일은 남아 있지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Innlogginger, nedlastinger, opplastinger, slettinger, gjenopprettinger, delingslenker og kontoendringer registreres så lenge dette er på. Det som skjedde før, er ikke med."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aanmeldingen, downloads, uploads, verwijderingen, terugzettingen, deellinks en accountwijzigingen worden vastgelegd zolang dit aanstaat. Wat daarvoor gebeurde staat er niet in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Logowania, pobrania, wysyłki, usunięcia, przywrócenia, udostępnienia i zmiany konta są zapisywane, gdy to działa. Tego, co było wcześniej, tu nie ma."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Inícios de sessão, transferências, envios, eliminações, restauros, ligações de partilha e alterações de conta ficam anotados enquanto isto estiver ativo. O que aconteceu antes não consta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Logins, downloads, envios, exclusões, restaurações, links de compartilhamento e mudanças de conta são registrados enquanto isto estiver ativado. O que aconteceu antes não aparece aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectările, descărcările, încărcările, ștergerile, restaurările, partajările și schimbările de cont sunt notate cât timp este pornit. Ce a fost înainte nu apare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Входы, загрузки, отправки, удаления, восстановления, ссылки и изменения учётной записи записываются, пока это включено. Того, что было раньше, здесь нет."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inloggningar, nedladdningar, uppladdningar, borttagningar, återställningar, delningar och kontoändringar skrivs ned så länge detta är på. Det som hände innan finns inte med."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเข้าสู่ระบบ ดาวน์โหลด อัปโหลด ลบ กู้คืน ลิงก์แชร์ และการเปลี่ยนแปลงบัญชีจะถูกบันทึกขณะที่เปิดอยู่ สิ่งที่เกิดขึ้นก่อนเปิดจะไม่อยู่ที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu açıkken oturum açmalar, indirmeler, yüklemeler, silmeler, geri yüklemeler, paylaşım bağlantıları ve hesap değişiklikleri yazılır. Açılmadan önceki hiçbir şey burada yer almaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Входи, завантаження, вивантаження, видалення, відновлення, посилання для спільного доступу та зміни облікових записів записуються, доки це ввімкнено. Того, що було до ввімкнення, тут немає."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập, tải xuống, tải lên, xóa, khôi phục, liên kết chia sẻ và thay đổi tài khoản được ghi lại khi bật. Những gì xảy ra trước khi bật sẽ không có ở đây."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "开启期间，登录、下载、上传、删除、还原、分享和账户变更会被记录。开启之前发生的事不在其中。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟期間，登入、下載、上傳、刪除、還原、分享與帳戶變更都會被記錄。開啟之前發生的事不在其中。"
          }
        }
      }
    },
