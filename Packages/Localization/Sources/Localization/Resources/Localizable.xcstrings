    "userDetail.volumesNoneSubtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This user only sees the default shared space."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرى هذا المستخدم المساحة المشتركة الافتراضية فقط."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento uživatel vidí pouze výchozí sdílený prostor."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne bruger kan kun se det delte standardområde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Benutzer sieht nur den standardmäßigen freigegebenen Bereich."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτός ο χρήστης βλέπει μόνο τον προεπιλεγμένο κοινόχρηστο χώρο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este usuario solo ve el espacio compartido predeterminado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä käyttäjä näkee vain oletusarvoisen jaetun tilan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet utilisateur ne voit que l'espace partagé par défaut."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המשתמש הזה רואה רק את המרחב המשותף שמוגדר כברירת מחדל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह उपयोगकर्ता केवल डिफ़ॉल्ट साझा स्थान देखता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a felhasználó csak az alapértelmezett megosztott területet látja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengguna ini hanya melihat ruang bersama default."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo utente vede solo lo spazio condiviso predefinito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このユーザはデフォルトの共有スペースのみを表示できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사용자는 기본 공유 공간만 볼 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne brukeren ser bare standard delt område."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze gebruiker ziet alleen de standaard gedeelde ruimte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten użytkownik widzi tylko domyślną przestrzeń współdzieloną."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este utilizador só vê o espaço partilhado predefinido."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este usuário só vê o espaço compartilhado padrão."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest utilizator vede doar spațiul partajat implicit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот пользователь видит только стандартное общее пространство."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här användaren ser bara det delade standardutrymmet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้ใช้นี้เห็นเฉพาะพื้นที่ใช้ร่วมกันเริ่มต้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kullanıcı yalnızca varsayılan paylaşılan alanı görür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей користувач бачить лише типовий спільний простір."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người dùng này chỉ thấy không gian chia sẻ mặc định."
          }
        },
        "zh-CN": {
