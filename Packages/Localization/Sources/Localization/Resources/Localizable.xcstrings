    "shareUpload.certificateRejected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server refused your client certificate. Open NextExplorer and replace it in Settings, then share again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض الخادم شهادة العميل الخاصة بك. افتح NextExplorer واستبدلها في الإعدادات ثم شارك مرة أخرى."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Server odmítl váš klientský certifikát. Otevřete NextExplorer, nahraďte ho v Nastavení a pak sdílejte znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveren afviste dit klientcertifikat. Åbn NextExplorer, og erstat det i Indstillinger, og del derefter igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat dein Clientzertifikat abgelehnt. Öffne NextExplorer, ersetze es in den Einstellungen und teile dann erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο διακομιστής απέρριψε το πιστοποιητικό πελάτη σας. Ανοίξτε το NextExplorer και αντικαταστήστε το στις Ρυθμίσεις και μετά κοινοποιήστε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor rechazó tu certificado de cliente. Abre NextExplorer, reemplázalo en Ajustes y vuelve a compartir."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palvelin hylkäsi asiakasvarmenteesi. Avaa NextExplorer ja korvaa se Asetuksissa, ja jaa sitten uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a refusé votre certificat client. Ouvrez NextExplorer, remplacez-le dans les Réglages, puis partagez à nouveau."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השרת דחה את אישור הלקוח שלכם. פתחו את NextExplorer והחליפו אותו בהגדרות, ואז שתפו שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्वर ने आपका क्लाइंट सर्टिफ़िकेट अस्वीकार कर दिया। NextExplorer खोलें, सेटिंग्स में उसे बदलें, फिर दोबारा साझा करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kiszolgáló elutasította a kliens tanúsítványát. Nyissa meg a NextExplorert, és cserélje le a Beállításokban, majd ossza meg újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Server menolak sertifikat klien Anda. Buka NextExplorer dan gantilah di Pengaturan, lalu bagikan lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server ha rifiutato il tuo certificato client. Apri NextExplorer, sostituiscilo in Impostazioni, poi condividi di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーがクライアント証明書を拒否しました。NextExplorerを開き、設定で置き換えてから、もう一度共有してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 클라이언트 인증서를 거부했습니다. NextExplorer를 열어 설정에서 교체한 다음 다시 공유하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveren avviste klientsertifikatet ditt. Åpne NextExplorer og bytt det ut i Innstillinger, og del deretter på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De server heeft je clientcertificaat geweigerd. Open NextExplorer, vervang het in Instellingen en deel daarna opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer odrzucił Twój certyfikat klienta. Otwórz NextExplorer, wymień go w Ustawieniach, a potem udostępnij ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor recusou o seu certificado de cliente. Abra o NextExplorer, substitua-o nos Ajustes e partilhe novamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor recusou seu certificado de cliente. Abra o NextExplorer, substitua-o em Configurações e compartilhe novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Serverul a refuzat certificatul tău de client. Deschide NextExplorer, înlocuiește-l în Setări, apoi distribuie din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер отклонил ваш клиентский сертификат. Откройте NextExplorer, замените его в настройках, затем поделитесь снова."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Servern avvisade ditt klientcertifikat. Öppna NextExplorer, byt ut det i Inställningar och dela sedan igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เซิร์ฟเวอร์ปฏิเสธใบรับรองไคลเอนต์ของคุณ เปิด NextExplorer แล้วแทนที่ในการตั้งค่า จากนั้นแชร์อีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu istemci sertifikanızı reddetti. NextExplorer'ı açıp Ayarlar'dan değiştirin, sonra tekrar paylaşın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер відхилив ваш клієнтський сертифікат. Відкрийте NextExplorer і замініть його в Налаштуваннях, потім поділіться знову."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy chủ đã từ chối chứng chỉ máy khách của bạn. Hãy mở NextExplorer và thay chứng chỉ trong Cài đặt, rồi chia sẻ lại."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器拒绝了你的客户端证书。请打开 NextExplorer,在“设置”中替换它,然后再次分享。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器拒絕了你的用戶端憑證。請開啟 NextExplorer,在「設定」中取代它,然後再次分享。"
          }
        }
      }
    },
