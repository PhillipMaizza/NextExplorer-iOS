    "ffmpegSettings.invalid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both paths must be absolute container paths beginning with /."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن يكون المساران مسارين مطلقين داخل الحاوية يبدآن بـ /."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obě cesty musí být absolutní cesty v kontejneru začínající znakem /."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Begge stier skal være absolutte containerstier, der begynder med /."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide Pfade müssen absolute Container-Pfade sein und mit / beginnen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Και οι δύο διαδρομές πρέπει να είναι απόλυτες διαδρομές κοντέινερ που ξεκινούν με /."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambas rutas deben ser rutas absolutas del contenedor y empezar por /."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Molempien polkujen on oltava absoluuttisia säiliön polkuja, jotka alkavat merkillä /."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les deux chemins doivent être des chemins absolus du conteneur, commençant par /."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שני הנתיבים חייבים להיות נתיבים מוחלטים בקונטיינר המתחילים ב-/."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोनों पथ कंटेनर के पूर्ण पथ होने चाहिए और / से शुरू होने चाहिए।."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindkét elérési útnak abszolút konténerútnak kell lennie, amely /-jellel kezdődik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kedua jalur harus berupa jalur absolut kontainer yang diawali dengan /."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrambi i percorsi devono essere percorsi assoluti del container e iniziare con /."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どちらのパスも / で始まるコンテナ内の絶対パスにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 경로는 모두 /로 시작하는 컨테이너의 절대 경로여야 합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Begge stiene må være absolutte containerstier som begynner med /."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide paden moeten absolute containerpaden zijn en met / beginnen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obie ścieżki muszą być bezwzględnymi ścieżkami kontenera i zaczynać się od /."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambos os caminhos têm de ser caminhos absolutos do contentor, começados por /."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dois caminhos devem ser caminhos absolutos do contêiner e começar com /."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambele căi trebuie să fie căi absolute din container și să înceapă cu /."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оба пути должны быть абсолютными путями контейнера и начинаться с /."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Båda sökvägarna måste vara absoluta sökvägar i containern och börja med /."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พาธทั้งสองต้องเป็นพาธสัมบูรณ์ในคอนเทนเนอร์ที่ขึ้นต้นด้วย /"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her iki yol da / ile başlayan mutlak kapsayıcı yolları olmalıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обидва шляхи мають бути абсолютними шляхами в контейнері, що починаються з /."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cả hai đường dẫn phải là đường dẫn tuyệt đối trong container, bắt đầu bằng /."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "两个路径都必须是以 / 开头的容器绝对路径。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "兩個路徑都必須是以 / 開頭的容器絕對路徑。"
          }
        }
      }
    },
