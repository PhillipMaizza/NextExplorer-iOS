    "trashSettings.enabledHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When off, deleting removes items for good. Items already in the trash still expire."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند الإيقاف، يزيل الحذف العناصر نهائيًا. أما العناصر الموجودة في السلة فتنتهي صلاحيتها كالمعتاد."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když je vypnuto, smazání položky odstraní trvale. Položky, které už v koši jsou, stále vyprší."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når den er slået fra, fjerner sletning emner permanent. Emner, der allerede er i papirkurven, udløber stadig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgeschaltet entfernt Löschen Elemente endgültig. Elemente im Papierkorb laufen trotzdem ab."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν είναι απενεργοποιημένο, η διαγραφή αφαιρεί τα στοιχεία οριστικά. Τα στοιχεία που βρίσκονται ήδη στον κάδο εξακολουθούν να λήγουν."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivada, eliminar borra definitivamente. Los elementos que ya están en la papelera siguen caducando."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun tämä on pois päältä, poistaminen poistaa kohteet pysyvästi. Jo roskakorissa olevat kohteet vanhenevat edelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivée, la suppression efface définitivement. Les éléments déjà dans la corbeille expirent toujours."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כשהאפשרות כבויה, מחיקה מסירה פריטים לצמיתות. פריטים שכבר בפח האשפה ממשיכים לפוג."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बंद होने पर हटाने से आइटम स्थायी रूप से हट जाते हैं। रीसायकल बिन में पहले से मौजूद आइटम फिर भी समाप्त होते हैं।."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kikapcsolt állapotban a törlés véglegesen eltávolítja az elemeket. A már a kukában lévő elemek továbbra is lejárnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika mati, penghapusan menghapus item secara permanen. Item yang sudah ada di sampah tetap kedaluwarsa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se disattivato, eliminare cancella definitivamente. Gli elementi già nel cestino scadono comunque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにすると、削除した項目は完全に削除されます。すでにゴミ箱にある項目は引き続き期限が切れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끄면 삭제 시 영구적으로 제거됩니다. 이미 휴지통에 있는 항목은 계속 만료됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når dette er av, fjerner sletting elementer for godt. Elementer som allerede er i papirkurven, utløper fortsatt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Indien uitgeschakeld, wist verwijderen items definitief. Items die al in de prullenbak liggen, verlopen nog steeds."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po wyłączeniu usuwanie jest trwałe. Elementy już w koszu nadal wygasają."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado, eliminar remove os itens definitivamente. Os que já estão na reciclagem continuam a expirar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativada, excluir apaga permanentemente. Itens que já estão na lixeira continuam expirando."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dezactivat, ștergerea elimină definitiv. Elementele aflate deja în coș expiră în continuare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если отключено, удаление происходит навсегда. Элементы, уже находящиеся в корзине, по-прежнему истекают."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Avstängd tar radering bort permanent. Objekt som redan ligger i papperskorgen löper fortfarande ut."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อปิด การลบจะนำรายการออกถาวร รายการที่อยู่ในถังขยะแล้วยังคงหมดอายุตามปกติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapalıyken silme, öğeleri kalıcı olarak kaldırır. Çöp kutusundaki öğelerin süresi yine de dolar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли вимкнено, видалення стирає елементи назавжди. Елементи, що вже лежать у кошику, все одно втрачають чинність."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi tắt, việc xóa sẽ loại bỏ mục vĩnh viễn. Các mục đã có trong thùng rác vẫn hết hạn."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后，删除将永久移除项目。回收站中已有的项目仍会到期。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉後，刪除會永久移除項目。資源回收筒中已有的項目仍會到期。"
          }
        }
      }
    },
