          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folosește un videoclip descărcat în loc de streaming când este disponibil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использовать загруженное видео вместо потоковой передачи, когда оно доступно."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
