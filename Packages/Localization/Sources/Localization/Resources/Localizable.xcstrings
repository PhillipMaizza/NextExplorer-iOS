    "twoFactor.enrollIntro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan this QR code with your authenticator app, or type the key in by hand. Then enter the 6-digit code the app shows."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امسح رمز QR هذا بتطبيق المصادقة، أو اكتب المفتاح يدويًا. ثم أدخل الرمز المكوّن من 6 أرقام الذي يعرضه التطبيق."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Naskenujte tento QR kód ověřovací aplikací nebo zadejte klíč ručně. Pak zadejte 6místný kód, který aplikace zobrazí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan denne QR-kode med din godkendelsesapp, eller skriv nøglen ind manuelt. Indtast derefter den 6-cifrede kode, appen viser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanne diesen QR-Code mit deiner Authenticator-App oder tippe den Schlüssel von Hand ein. Gib dann den 6-stelligen Code ein, den die App anzeigt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σαρώστε αυτόν τον κωδικό QR με την εφαρμογή ελέγχου ταυτότητας ή πληκτρολογήστε το κλειδί με το χέρι. Έπειτα εισαγάγετε τον 6ψήφιο κωδικό που εμφανίζει η εφαρμογή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea este código QR con tu app de autenticación, o escribe la clave a mano. Después introduce el código de 6 dígitos que muestra la app."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Skannaa tämä QR-koodi todennussovelluksellasi tai kirjoita avain käsin. Syötä sitten sovelluksen näyttämä 6-numeroinen koodi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannez ce code QR avec votre app d'authentification, ou saisissez la clé à la main. Saisissez ensuite le code à 6 chiffres affiché par l'app."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סרקו את קוד ה-QR הזה באפליקציית האימות שלכם, או הקלידו את המפתח ידנית. לאחר מכן הזינו את הקוד בן 6 הספרות שהאפליקציה מציגה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस QR कोड को अपने ऑथेंटिकेटर ऐप से स्कैन करें, या कुंजी हाथ से टाइप करें। फिर ऐप में दिखने वाला 6 अंकों का कोड दर्ज करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvassa be ezt a QR-kódot a hitelesítő alkalmazással, vagy írja be kézzel a kulcsot. Ezután adja meg az alkalmazás által mutatott 6 számjegyű kódot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindai kode QR ini dengan aplikasi autentikator Anda, atau ketik kuncinya secara manual. Lalu masukkan kode 6 digit yang ditampilkan aplikasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scansiona questo codice QR con la tua app di autenticazione, oppure digita la chiave a mano. Poi inserisci il codice a 6 cifre mostrato dall'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証アプリでこの QR コードをスキャンするか、キーを手動で入力してください。その後、アプリに表示される 6 桁のコードを入力します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증 앱으로 이 QR 코드를 스캔하거나 키를 직접 입력하세요. 그런 다음 앱에 표시되는 6자리 코드를 입력하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skann denne QR-koden med autentiseringsappen din, eller skriv inn nøkkelen manuelt. Skriv deretter inn den sekssifrede koden appen viser."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan deze QR-code met je authenticatie-app of typ de sleutel handmatig in. Voer daarna de 6-cijferige code in die de app toont."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeskanuj ten kod QR aplikacją uwierzytelniającą lub wpisz klucz ręcznie. Następnie wpisz 6-cyfrowy kod pokazany w aplikacji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Leia este código QR com a sua aplicação de autenticação ou introduza a chave manualmente. Depois, introduza o código de 6 dígitos que a aplicação mostra."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escaneie este código QR com seu app autenticador ou digite a chave manualmente. Depois, digite o código de 6 dígitos que o app mostra."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanează acest cod QR cu aplicația ta de autentificare sau introdu cheia manual. Apoi introdu codul din 6 cifre afișat de aplicație."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отсканируйте этот QR-код в приложении-аутентификаторе или введите ключ вручную. Затем введите 6-значный код, который покажет приложение."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skanna den här QR-koden med din autentiseringsapp eller skriv in nyckeln för hand. Ange sedan den sexsiffriga koden som appen visar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สแกนคิวอาร์โค้ดนี้ด้วยแอปยืนยันตัวตนของคุณ หรือพิมพ์คีย์ด้วยตนเอง จากนั้นป้อนรหัส 6 หลักที่แอปแสดง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu QR kodunu kimlik doğrulayıcı uygulamanızla tarayın veya anahtarı elle yazın. Ardından uygulamanın gösterdiği 6 haneli kodu girin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скануйте цей QR-код застосунком-автентифікатором або введіть ключ уручну. Потім введіть 6-значний код, який показує застосунок."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quét mã QR này bằng ứng dụng xác thực của bạn, hoặc nhập khóa bằng tay. Sau đó nhập mã 6 chữ số mà ứng dụng hiển thị."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "使用验证器 App 扫描此二维码，或手动输入密钥。然后输入 App 显示的 6 位验证码。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "使用驗證器 App 掃描此 QR Code，或手動輸入密鑰。然後輸入 App 顯示的 6 位數驗證碼。"
          }
        }
      }
    },
