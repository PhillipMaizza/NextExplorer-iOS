    "favorites.emptyList": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Star folders in Browse to see them here."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضع علامة نجمة على المجلدات في تصفح لتظهر هنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markiere Ordner in Durchsuchen mit einem Stern, um sie hier zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca carpetas en Explorar para verlas aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marquez des dossiers dans Explorer pour les voir ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोल्डर यहां देखने के लिए उन्हें ब्राउज़ में तारांकित करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrassegna le cartelle in Esplora per vederle qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ブラウズ」でフォルダにスターを付けると、ここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탐색에서 폴더를 즐겨찾기로 표시하면 여기에 나타납니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Markeer mappen in Verkennen om ze hier te zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznacz foldery w Przeglądaj, aby zobaczyć je tutaj."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque pastas em Explorar para as ver aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Marchează dosare în Explorează pentru a le vedea aici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отмечайте папки в Обзоре, чтобы видеть их здесь."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
