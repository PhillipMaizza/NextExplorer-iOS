    "trashSettings.zonesEmpty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing has been deleted into a trash yet."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُنقل أي شيء إلى سلة المحذوفات بعد."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Do koše zatím nebylo nic smazáno."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet er slettet til en papirkurv endnu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch wurde nichts in einen Papierkorb gelöscht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν έχει διαγραφεί ακόμη τίποτα σε κάδο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no se ha eliminado nada a una papelera."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Roskakoriin ei ole vielä poistettu mitään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'a encore été supprimé vers une corbeille."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדיין לא נמחק דבר אל פח אשפה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी तक किसी रीसायकल बिन में कुछ नहीं हटाया गया।."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még semmi sem került törlésre kukába."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada yang dihapus ke sampah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è ancora stato eliminato nulla in un cestino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだゴミ箱に削除されたものはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 휴지통으로 삭제된 항목이 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting er slettet til en papirkurv ennå."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is nog niets naar een prullenbak verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic jeszcze nie trafiło do kosza."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda nada foi enviado para a reciclagem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada foi excluído para uma lixeira ainda."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încă nu s-a șters nimic într-un coș de gunoi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В корзину пока ничего не удалялось."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget har raderats till en papperskorg ännu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีสิ่งใดถูกลบลงถังขยะ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz çöp kutusuna hiçbir şey silinmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "До кошика поки що нічого не видалено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có gì được xóa vào thùng rác."
          }
