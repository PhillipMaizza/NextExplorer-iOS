    "userDetail.passwordHasLocal": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This user signs in with an email and password."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسجّل هذا المستخدم الدخول ببريد إلكتروني وكلمة سر."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento uživatel se přihlašuje e-mailem a heslem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne bruger logger ind med e-mail og adgangskode."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Benutzer meldet sich mit E-Mail und Passwort an."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτός ο χρήστης συνδέεται με email και κωδικό πρόσβασης."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este usuario inicia sesión con un correo y una contraseña."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä käyttäjä kirjautuu sähköpostilla ja salasanalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet utilisateur se connecte avec un e-mail et un mot de passe."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המשתמש הזה מתחבר באמצעות אימייל וסיסמה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह उपयोगकर्ता ईमेल और पासवर्ड से साइन इन करता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a felhasználó e-maillel és jelszóval jelentkezik be."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengguna ini masuk dengan email dan kata sandi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo utente accede con un'email e una password."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このユーザはメールとパスワードでサインインします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사용자는 이메일과 비밀번호로 로그인합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne brukeren logger inn med e-post og passord."
          }
        },
        "nl": {
          "stringUnit": {
