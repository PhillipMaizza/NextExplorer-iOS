    "ffmpegSettings.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the FFmpeg and FFprobe executables used for media previews and metadata."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر الملفين التنفيذيين FFmpeg وFFprobe المستخدمين لمعاينة الوسائط وبياناتها الوصفية."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte spustitelné soubory FFmpeg a FFprobe používané pro náhledy médií a metadata."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg de programfiler til FFmpeg og FFprobe, der bruges til forhåndsvisninger og metadata for medier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "FFmpeg- und FFprobe-Programme für Medienvorschauen und Metadaten auswählen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε τα εκτελέσιμα FFmpeg και FFprobe που χρησιμοποιούνται για προεπισκοπήσεις και μεταδεδομένα πολυμέσων."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija los ejecutables de FFmpeg y FFprobe usados para las miniaturas y los metadatos de los medios."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse FFmpeg- ja FFprobe-ohjelmat, joita käytetään median esikatseluihin ja metatietoihin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez les exécutables FFmpeg et FFprobe utilisés pour les aperçus et les métadonnées des médias."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחרו את קובצי ההרצה FFmpeg ו-FFprobe המשמשים לתצוגות מקדימות ולמטא-נתונים של מדיה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मीडिया पूर्वावलोकन और मेटाडेटा के लिए उपयोग होने वाले FFmpeg और FFprobe निष्पादनीय चुनें।."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassza ki az előnézetekhez és a médiametaadatokhoz használt FFmpeg és FFprobe futtatható fájlokat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih file eksekusi FFmpeg dan FFprobe yang digunakan untuk pratinjau dan metadata media."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegliere gli eseguibili FFmpeg e FFprobe usati per le anteprime e i metadati dei media."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メディアのプレビューとメタデータに使うFFmpegとFFprobeの実行ファイルを選びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미디어 미리 보기와 메타데이터에 사용할 FFmpeg 및 FFprobe 실행 파일을 선택하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg de kjørbare filene for FFmpeg og FFprobe som brukes til forhåndsvisninger og metadata for medier."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies de FFmpeg- en FFprobe-programma's voor mediavoorbeelden en metagegevens."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz pliki wykonywalne FFmpeg i FFprobe używane do miniatur i metadanych multimediów."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha os executáveis FFmpeg e FFprobe usados nas pré-visualizações e nos metadados dos conteúdos multimédia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha os executáveis do FFmpeg e do FFprobe usados nas miniaturas e nos metadados de mídia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alegeți executabilele FFmpeg și FFprobe folosite pentru previzualizările și metadatele media."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите исполняемые файлы FFmpeg и FFprobe для предпросмотра и метаданных медиафайлов."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj de FFmpeg- och FFprobe-program som används för förhandsvisningar och metadata."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกไฟล์ที่เรียกใช้งานของ FFmpeg และ FFprobe ที่ใช้สำหรับตัวอย่างและข้อมูลเมทาของสื่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ortam önizlemeleri ve meta veriler için kullanılan FFmpeg ve FFprobe çalıştırılabilir dosyalarını seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть виконувані файли FFmpeg і FFprobe, що використовуються для попереднього перегляду й метаданих медіа."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn các tệp thực thi FFmpeg và FFprobe dùng cho bản xem trước và siêu dữ liệu phương tiện."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "选择用于媒体预览和元数据的 FFmpeg 与 FFprobe 可执行文件。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇用於媒體預覽與中介資料的 FFmpeg 與 FFprobe 執行檔。"
          }
        }
      }
    },
    "ffmpegSettings.unavailable": {
      "extractionState": "manual",
      "localizations": {
