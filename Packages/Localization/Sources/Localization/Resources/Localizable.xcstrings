    "trashSettings.versionsEnabledHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Independent of the trash. When off, saves keep nothing new; existing versions stay until they expire or are deleted."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مستقل عن السلة. عند الإيقاف لا يحتفظ الحفظ بأي جديد؛ وتبقى الإصدارات الموجودة حتى تنتهي صلاحيتها أو تُحذف."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nezávisí na koši. Když je vypnuto, ukládání nic nového nezachová; stávající verze zůstanou, dokud nevyprší nebo nejsou smazány."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Uafhængig af papirkurven. Når den er slået fra, bevarer gemninger intet nyt; eksisterende versioner bliver, indtil de udløber eller slettes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unabhängig vom Papierkorb. Ausgeschaltet wird beim Speichern nichts Neues behalten; vorhandene Versionen bleiben bis zu ihrem Ablauf oder ihrer Löschung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανεξάρτητο από τον κάδο. Όταν είναι απενεργοποιημένο, οι αποθηκεύσεις δεν διατηρούν τίποτα νέο· οι υπάρχουσες εκδόσεις παραμένουν μέχρι να λήξουν ή να διαγραφούν."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Independiente de la papelera. Desactivado, los guardados no conservan nada nuevo; las versiones existentes permanecen hasta que caducan o se eliminan."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Riippumaton roskakorista. Kun tämä on pois päältä, tallennukset eivät säilytä mitään uutta; olemassa olevat versiot säilyvät, kunnes ne vanhenevat tai poistetaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indépendant de la corbeille. Désactivé, les enregistrements ne gardent plus rien ; les versions existantes restent jusqu'à leur expiration ou leur suppression."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בלתי תלוי בפח האשפה. כשהאפשרות כבויה, שמירות אינן שומרות דבר חדש; גרסאות קיימות נשארות עד שתפוג תקופתן או יימחקו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रीसायकल बिन से स्वतंत्र। बंद होने पर सहेजने से कुछ नया नहीं रखा जाता; मौजूदा संस्करण अवधि पूरी होने या हटाए जाने तक रहते हैं।."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kukától független. Kikapcsolt állapotban a mentések nem őriznek meg semmi újat; a meglévő verziók addig maradnak, amíg le nem járnak vagy nem törlik őket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terpisah dari sampah. Jika mati, penyimpanan tidak mempertahankan yang baru; versi yang ada tetap sampai kedaluwarsa atau dihapus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indipendente dal cestino. Se disattivato, i salvataggi non conservano nulla di nuovo; le versioni esistenti restano fino alla scadenza o all'eliminazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱とは独立しています。オフにすると新しい保持は行われず、既存のバージョンは期限切れか削除されるまで残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통과 별개로 동작합니다. 끄면 저장해도 새로 보관되지 않으며, 기존 버전은 만료되거나 삭제될 때까지 남습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Uavhengig av papirkurven. Når dette er av, beholder lagringer ingenting nytt; eksisterende versjoner blir værende til de utløper eller slettes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Los van de prullenbak. Indien uitgeschakeld, bewaart opslaan niets nieuws; bestaande versies blijven tot ze verlopen of worden verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niezależne od kosza. Po wyłączeniu zapisy nie zachowują nic nowego; istniejące wersje pozostają do wygaśnięcia lub usunięcia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Independente da reciclagem. Desativado, as gravações não mantêm nada de novo; as versões existentes ficam até expirarem ou serem eliminadas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Independente da lixeira. Desativado, os salvamentos não guardam nada novo; as versões existentes permanecem até expirarem ou serem excluídas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Independent de coșul de gunoi. Dezactivat, salvările nu mai păstrează nimic nou; versiunile existente rămân până expiră sau sunt șterse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не зависит от корзины. Если выключено, сохранения ничего нового не оставляют; существующие версии хранятся до истечения срока или удаления."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Oberoende av papperskorgen. Avstängt behåller sparningar inget nytt; befintliga versioner finns kvar tills de löper ut eller tas bort."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แยกจากถังขยะ เมื่อปิด การบันทึกจะไม่เก็บสิ่งใหม่ เวอร์ชันที่มีอยู่จะคงอยู่จนกว่าจะหมดอายุหรือถูกลบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çöp kutusundan bağımsızdır. Kapalıyken kaydetmeler yeni bir şey tutmaz; mevcut sürümler süresi dolana veya silinene kadar kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не залежить від кошика. Коли вимкнено, збереження нічого нового не залишають; наявні версії лишаються, доки не втратять чинність або не будуть видалені."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Độc lập với thùng rác. Khi tắt, việc lưu không giữ thêm gì mới; các phiên bản hiện có vẫn còn đến khi hết hạn hoặc bị xóa."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "独立于回收站。关闭后保存不再保留新内容；已有版本保留到过期或被删除。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "獨立於資源回收筒。關閉後儲存不再保留新內容；現有版本保留到過期或被刪除。"
          }
        }
      }
    },
    "trashSettings.versionsEnvironmentNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
