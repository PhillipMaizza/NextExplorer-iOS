    "login.errorClientCertificateRejected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server refused this client certificate."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض الخادم شهادة العميل هذه."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Server odmítl tento klientský certifikát."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveren afviste dette klientcertifikat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat dieses Client-Zertifikat abgelehnt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο διακομιστής απέρριψε αυτό το πιστοποιητικό πελάτη."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor ha rechazado este certificado de cliente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palvelin hylkäsi tämän asiakasvarmenteen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a refusé ce certificat client."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השרת דחה את אישור הלקוח הזה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्वर ने यह क्लाइंट सर्टिफ़िकेट अस्वीकार कर दिया।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kiszolgáló elutasította ezt a kliens tanúsítványt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Server menolak sertifikat klien ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server ha rifiutato questo certificato client."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーがこのクライアント証明書を拒否しました。"
          }
        },
        "ko": {
          "stringUnit": {
