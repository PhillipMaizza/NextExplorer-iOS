    "userDetail.dangerZoneSubtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removing a user revokes their access immediately. Files they own on the server are not deleted."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إزالة مستخدم يلغي وصوله فورًا. لا تُحذف الملفات التي يملكها على الخادم."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odebrání uživatele okamžitě zruší jeho přístup. Soubory, které na serveru vlastní, se nesmažou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjernelse af en bruger tilbagekalder straks vedkommendes adgang. Filer, vedkommende ejer på serveren, slettes ikke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Entfernen eines Benutzers widerruft sofort dessen Zugriff. Dateien, die er auf dem Server besitzt, werden nicht gelöscht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αφαίρεση ενός χρήστη ανακαλεί αμέσως την πρόσβασή του. Τα αρχεία που κατέχει στον διακομιστή δεν διαγράφονται."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar un usuario revoca su acceso de inmediato. Los archivos que posee en el servidor no se eliminan."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käyttäjän poistaminen peruu hänen käyttöoikeutensa heti. Hänen palvelimella omistamiaan tiedostoja ei poisteta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer un utilisateur révoque immédiatement son accès. Les fichiers qu'il possède sur le serveur ne sont pas supprimés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הסרת משתמש מבטלת את הגישה שלו מיד. קבצים שבבעלותו בשרת אינם נמחקים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी उपयोगकर्ता को निकालने से उसका एक्सेस तुरंत रद्द हो जाता है। सर्वर पर उसके स्वामित्व वाली फ़ाइलें नहीं हटाई जातीं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A felhasználó eltávolítása azonnal visszavonja a hozzáférését. A kiszolgálón lévő fájljai nem törlődnek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghapus pengguna langsung mencabut aksesnya. File miliknya di server tidak dihapus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovere un utente revoca subito il suo accesso. I file che possiede sul server non vengono eliminati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザを削除すると、そのアクセス権はすぐに取り消されます。サーバー上でそのユーザが所有するファイルは削除されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자를 제거하면 접근 권한이 즉시 취소됩니다. 서버에서 해당 사용자가 소유한 파일은 삭제되지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å fjerne en bruker trekker tilbake tilgangen umiddelbart. Filer brukeren eier på serveren, slettes ikke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een gebruiker verwijderen trekt zijn toegang onmiddellijk in. Bestanden die hij op de server bezit, worden niet verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunięcie użytkownika natychmiast odbiera mu dostęp. Pliki, których jest właścicielem na serwerze, nie są usuwane."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover um utilizador revoga o seu acesso de imediato. Os ficheiros que possui no servidor não são eliminados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover um usuário revoga o acesso dele imediatamente. Os arquivos que ele possui no servidor não são excluídos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminarea unui utilizator îi revocă accesul imediat. Fișierele pe care le deține pe server nu sunt șterse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаление пользователя немедленно отзывает его доступ. Файлы, которыми он владеет на сервере, не удаляются."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att ta bort en användare återkallar åtkomsten omedelbart. Filer de äger på servern raderas inte."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การนำผู้ใช้ออกจะเพิกถอนสิทธิ์การเข้าถึงของผู้ใช้ทันที ไฟล์ที่ผู้ใช้เป็นเจ้าของบนเซิร์ฟเวอร์จะไม่ถูกลบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kullanıcıyı kaldırmak erişimini hemen iptal eder. Sunucuda sahip olduğu dosyalar silinmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вилучення користувача негайно скасовує його доступ. Файли, якими він володіє на сервері, не видаляються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa người dùng sẽ thu hồi quyền truy cập của họ ngay lập tức. Các tệp họ sở hữu trên máy chủ không bị xóa."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "移除用户会立即撤销其访问权限。其在服务器上拥有的文件不会被删除。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "移除使用者會立即撤銷其取用權限。其在伺服器上擁有的檔案不會被刪除。"
          }
        }
      }
    },
