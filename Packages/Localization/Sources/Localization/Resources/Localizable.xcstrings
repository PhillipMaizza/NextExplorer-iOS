          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se așteaptă aprobarea. Vei fi taxat după aprobare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ожидание подтверждения. Списание произойдёт после одобрения."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Väntar på godkännande. Du debiteras när det har godkänts."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "等待批准。批准后将进行扣款。"
          }
        },
