    "twoFactor.offIntro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a second step to signing in. After your password you will enter a code from an authenticator app."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف خطوة ثانية لتسجيل الدخول. بعد كلمة السر ستدخل رمزًا من تطبيق المصادقة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidejte při přihlášení druhý krok. Po zadání hesla zadáte kód z ověřovací aplikace."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj et ekstra trin til login. Efter din adgangskode indtaster du en kode fra en godkendelsesapp."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge der Anmeldung einen zweiten Schritt hinzu. Nach deinem Passwort gibst du einen Code aus einer Authenticator-App ein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε ένα δεύτερο βήμα στη σύνδεση. Μετά τον κωδικό πρόσβασης θα εισαγάγετε έναν κωδικό από μια εφαρμογή ελέγχου ταυτότητας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un segundo paso al inicio de sesión. Después de tu contraseña, introducirás un código de una app de autenticación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää kirjautumiseen toinen vaihe. Salasanan jälkeen syötät koodin todennussovelluksesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez une seconde étape à la connexion. Après votre mot de passe, vous saisirez un code issu d'une app d'authentification."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוסיפו שלב שני להתחברות. אחרי הסיסמה תזינו קוד מאפליקציית אימות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साइन इन में दूसरा चरण जोड़ें। पासवर्ड के बाद आप ऑथेंटिकेटर ऐप से एक कोड दर्ज करेंगे।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjon egy második lépést a bejelentkezéshez. A jelszó után egy hitelesítő alkalmazásból kapott kódot kell megadnia."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan langkah kedua saat masuk. Setelah kata sandi, Anda akan memasukkan kode dari aplikasi autentikator."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un secondo passaggio all'accesso. Dopo la password inserirai un codice da un'app di autenticazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインに2段階目を追加します。パスワードの後に、認証アプリのコードを入力します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인에 두 번째 단계를 추가합니다. 비밀번호 다음에 인증 앱의 코드를 입력하게 됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til et ekstra trinn ved innlogging. Etter passordet skriver du inn en kode fra en autentiseringsapp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg een tweede stap toe aan het inloggen. Na je wachtwoord voer je een code uit een authenticatie-app in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj drugi krok do logowania. Po wpisaniu hasła podasz kod z aplikacji uwierzytelniającej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione um segundo passo ao início de sessão. Depois da palavra-passe, introduzirá um código de uma aplicação de autenticação."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione uma segunda etapa ao login. Depois da senha, você digitará um código de um app autenticador."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaugă un al doilea pas la conectare. După parolă, vei introduce un cod dintr-o aplicație de autentificare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте второй шаг при входе. После пароля вы будете вводить код из приложения-аутентификатора."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till ett andra steg vid inloggning. Efter lösenordet anger du en kod från en autentiseringsapp."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มขั้นตอนที่สองในการเข้าสู่ระบบ หลังจากรหัสผ่าน คุณจะป้อนรหัสจากแอปยืนยันตัวตน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturum açmaya ikinci bir adım ekleyin. Parolanızdan sonra bir kimlik doğrulayıcı uygulamadan kod gireceksiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте другий крок до входу. Після пароля ви вводитимете код із застосунку-автентифікатора."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm bước thứ hai khi đăng nhập. Sau mật khẩu, bạn sẽ nhập mã từ ứng dụng xác thực."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "为登录添加第二步验证。输入密码后，您还需要输入验证器 App 中的验证码。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "為登入加入第二步驗證。輸入密碼後，您還需要輸入驗證器 App 中的驗證碼。"
          }
        }
      }
    },
