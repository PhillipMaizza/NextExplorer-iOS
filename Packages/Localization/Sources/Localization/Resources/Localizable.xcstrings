    "login.plaintextWarning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This connection isn't encrypted. Your password and session are sent in the clear over the local network."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الاتصال غير مشفّر. تُرسل كلمة سرك وجلستك كنص عادي عبر الشبكة المحلية."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto připojení není šifrované. Vaše heslo a relace se přenášejí v čitelné podobě přes místní síť."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne forbindelse er ikke krypteret. Din adgangskode og session sendes i klartekst over det lokale netværk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Verbindung ist nicht verschlüsselt. Dein Passwort und deine Sitzung werden im Klartext über das lokale Netzwerk gesendet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η σύνδεση δεν είναι κρυπτογραφημένη. Ο κωδικός πρόσβασης και η συνεδρία σας αποστέλλονται σε απλό κείμενο μέσω του τοπικού δικτύου."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conexión no está cifrada. Tu contraseña y sesión se envían sin protección por la red local."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä yhteys ei ole salattu. Salasanasi ja istuntosi lähetetään selkokielisenä paikallisen verkon kautta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette connexion n'est pas chiffrée. Votre mot de passe et votre session sont envoyés en clair sur le réseau local."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החיבור הזה אינו מוצפן. הסיסמה והסשן שלכם נשלחים כטקסט גלוי ברשת המקומית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह कनेक्शन एन्क्रिप्टेड नहीं है। आपका पासवर्ड और सत्र स्थानीय नेटवर्क पर सादे रूप में भेजे जाते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a kapcsolat nincs titkosítva. A jelszava és a munkamenete egyszerű szövegként kerül elküldésre a helyi hálózaton."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Koneksi ini tidak terenkripsi. Kata sandi dan sesi Anda dikirim apa adanya melalui jaringan lokal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa connessione non è cifrata. La tua password e la tua sessione vengono inviate in chiaro sulla rete locale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この接続は暗号化されていません。パスワードとセッションはローカルネットワーク上を平文で送信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 연결은 암호화되지 않았습니다. 비밀번호와 세션이 로컬 네트워크를 통해 평문으로 전송됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne tilkoblingen er ikke kryptert. Passordet og økten din sendes i klartekst over det lokale nettverket."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze verbinding is niet versleuteld. Je wachtwoord en sessie worden onversleuteld over het lokale netwerk verzonden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To połączenie nie jest szyfrowane. Twoje hasło i sesja są wysyłane otwartym tekstem przez sieć lokalną."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta ligação não está cifrada. A sua palavra-passe e sessão são enviadas em texto simples pela rede local."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conexão não é criptografada. Sua senha e sua sessão são enviadas em texto simples pela rede local."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această conexiune nu este criptată. Parola și sesiunea ta sunt trimise în clar prin rețeaua locală."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это соединение не зашифровано. Ваш пароль и сессия передаются в открытом виде по локальной сети."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här anslutningen är inte krypterad. Ditt lösenord och din session skickas i klartext över det lokala nätverket."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเชื่อมต่อนี้ไม่ได้เข้ารหัส รหัสผ่านและเซสชันของคุณจะถูกส่งเป็นข้อความธรรมดาผ่านเครือข่ายภายใน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bağlantı şifrelenmemiş. Parolanız ve oturumunuz yerel ağ üzerinden düz metin olarak gönderilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це з’єднання не зашифроване. Ваш пароль і сеанс передаються відкритим текстом локальною мережею."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối này không được mã hóa. Mật khẩu và phiên của bạn được gửi dạng văn bản thuần qua mạng nội bộ."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此连接未加密。您的密码和会话以明文形式通过本地网络发送。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "此連線未加密。您的密碼和工作階段以明文形式透過本地網路傳送。"
          }
        }
      }
    },
    "login.portHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a port (e.g. :3000). Most homelab servers don't listen on plain port 80."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف منفذًا (مثل :3000). معظم خوادم المنزل لا تستمع على المنفذ 80 العادي."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidejte port (např. :3000). Většina domácích serverů neposlouchá na běžném portu 80."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj en port (f.eks. :3000). De fleste homelab-servere lytter ikke på den almindelige port 80."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge einen Port hinzu (z. B. :3000). Die meisten Heimserver hören nicht auf dem einfachen Port 80."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε μια θύρα (π.χ. :3000). Οι περισσότεροι διακομιστές homelab δεν ακούν στην απλή θύρα 80."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un puerto (p. ej. :3000). La mayoría de los servidores caseros no escuchan en el puerto 80."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää portti (esim. :3000). Useimmat kotilaboratoriopalvelimet eivät kuuntele tavallista porttia 80."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un port (par ex. :3000). La plupart des serveurs domestiques n'écoutent pas sur le port 80."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוסיפו פורט (למשל ‎:3000‎). רוב שרתי ה-homelab אינם מאזינים לפורט 80 הרגיל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक पोर्ट जोड़ें (उदा. :3000)। अधिकांश होमलैब सर्वर सादे पोर्ट 80 पर नहीं सुनते।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjon meg egy portot (pl. :3000). A legtöbb homelab-kiszolgáló nem a szokásos 80-as porton figyel."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan port (mis. :3000). Sebagian besar server homelab tidak mendengarkan di port 80 biasa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi una porta (es. :3000). La maggior parte dei server casalinghi non ascolta sulla porta 80."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポートを追加してください（例: :3000）。ほとんどのホームラボサーバーは通常のポート 80 で待ち受けていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포트를 추가하세요 (예: :3000). 대부분의 홈랩 서버는 기본 포트 80에서 수신 대기하지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til en port (f.eks. :3000). De fleste homelab-servere lytter ikke på vanlig port 80."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg een poort toe (bijv. :3000). De meeste thuisservers luisteren niet op poort 80."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj port (np. :3000). Większość serwerów domowych nie nasłuchuje na porcie 80."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione uma porta (por ex. :3000). A maioria dos servidores domésticos não escuta na porta 80."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione uma porta (por ex. :3000). A maioria dos servidores domésticos não escuta na porta 80."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaugă un port (de ex. :3000). Majoritatea serverelor de acasă nu ascultă pe portul 80."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте порт (например, :3000). Большинство домашних серверов не слушают порт 80."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till en port (t.ex. :3000). De flesta hemservrar lyssnar inte på port 80."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มพอร์ต (เช่น :3000) เซิร์ฟเวอร์ homelab ส่วนใหญ่ไม่รับฟังที่พอร์ต 80 ปกติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir bağlantı noktası ekleyin (ör. :3000). Çoğu ev laboratuvarı sunucusu düz 80 numaralı bağlantı noktasını dinlemez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте порт (наприклад, :3000). Більшість домашніх серверів не слухають звичайний порт 80."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm một cổng (ví dụ :3000). Hầu hết máy chủ homelab không lắng nghe ở cổng 80 thông thường."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "添加端口（例如 :3000）。大多数家庭服务器不会在默认的 80 端口上监听。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "加入通訊埠（例如 :3000）。大多數家用伺服器不會在預設的 80 通訊埠上接聽。"
          }
        }
      }
    },
