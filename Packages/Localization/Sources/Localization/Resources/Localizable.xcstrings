          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toàn quyền kiểm soát tệp, chia sẻ và người dùng."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "对文件、共享和用户的完全控制。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
