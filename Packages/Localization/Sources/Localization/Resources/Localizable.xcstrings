    "userDetail.removeUserMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ loses access immediately. Their files on the server are not deleted."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفقد %@ الوصول فورًا. لا تُحذف ملفاته على الخادم."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ okamžitě ztrácí přístup. Jeho soubory na serveru se nemažou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ mister straks adgang. Vedkommendes filer på serveren slettes ikke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ verliert sofort den Zugriff. Seine Dateien auf dem Server werden nicht gelöscht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο χρήστης %@ χάνει αμέσως την πρόσβαση. Τα αρχεία του στον διακομιστή δεν διαγράφονται."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pierde el acceso de inmediato. Sus archivos en el servidor no se eliminan."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ menettää käyttöoikeutensa heti. Hänen palvelimella olevia tiedostojaan ei poisteta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ perd immédiatement l'accès. Ses fichiers sur le serveur ne sont pas supprimés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ מאבד גישה מיד. הקבצים שלו בשרת אינם נמחקים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ तुरंत एक्सेस खो देता है। सर्वर पर उसकी फ़ाइलें नहीं हटाई जातीं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ azonnal elveszíti a hozzáférését. A kiszolgálón lévő fájljai nem törlődnek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ langsung kehilangan akses. File miliknya di server tidak dihapus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ perde subito l'accesso. I suoi file sul server non vengono eliminati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はすぐにアクセス権を失います。サーバー上のファイルは削除されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 즉시 접근 권한을 잃습니다. 서버의 파일은 삭제되지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ mister tilgangen umiddelbart. Filene på serveren slettes ikke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ verliest onmiddellijk de toegang. Zijn bestanden op de server worden niet verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ natychmiast traci dostęp. Jego pliki na serwerze nie są usuwane."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ perde o acesso de imediato. Os seus ficheiros no servidor não são eliminados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ perde o acesso imediatamente. Os arquivos dele no servidor não são excluídos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pierde accesul imediat. Fișierele sale de pe server nu sunt șterse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ немедленно теряет доступ. Его файлы на сервере не удаляются."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ förlorar åtkomsten omedelbart. Deras filer på servern raderas inte."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ สูญเสียสิทธิ์การเข้าถึงทันที ไฟล์ของผู้ใช้บนเซิร์ฟเวอร์จะไม่ถูกลบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ erişimini hemen kaybeder. Sunucudaki dosyaları silinmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ негайно втрачає доступ. Його файли на сервері не видаляються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ mất quyền truy cập ngay lập tức. Các tệp của họ trên máy chủ không bị xóa."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 会立即失去访问权限。其在服务器上的文件不会被删除。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 會立即失去取用權限。其在伺服器上的檔案不會被刪除。"
          }
        }
      }
    },
