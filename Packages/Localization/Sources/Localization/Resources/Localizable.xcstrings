    "activityLog.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Who did what, when, and from where. Off unless you ask for it."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من فعل ماذا، ومتى، ومن أين. متوقف ما لم تُشغّله."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kdo co udělal, kdy a odkud. Vypnuto, dokud to nezapnete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvem gjorde hvad, hvornår og hvorfra. Slået fra, medmindre du slår den til."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer was wann und von wo getan hat. Aus, solange du es nicht einschaltest."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ποιος έκανε τι, πότε και από πού. Απενεργοποιημένο, εκτός αν το ενεργοποιήσετε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quién hizo qué, cuándo y desde dónde. Desactivado mientras no lo pidas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuka teki mitä, milloin ja mistä. Pois käytöstä, ellet ota sitä käyttöön."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui a fait quoi, quand, et depuis où. Désactivé tant que vous ne le demandez pas."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מי עשה מה, מתי ומאיפה. כבוי אלא אם תפעילו אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसने क्या किया, कब और कहाँ से। जब तक आप न कहें, बंद रहता है।."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ki mit csinált, mikor és honnan. Ki van kapcsolva, amíg be nem kapcsolja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Siapa melakukan apa, kapan, dan dari mana. Mati kecuali Anda mengaktifkannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chi ha fatto cosa, quando e da dove. Spento finché non lo chiedi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誰がいつどこから何をしたかを記録します。オンにしない限りオフです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누가, 언제, 어디서 무엇을 했는지. 요청하기 전에는 꺼져 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvem som gjorde hva, når og hvorfra. Av med mindre du slår den på."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie wat deed, wanneer en vanwaar. Uit tot je erom vraagt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kto co zrobił, kiedy i skąd. Wyłączony, dopóki go nie włączysz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quem fez o quê, quando e a partir de onde. Desativado enquanto não o ativar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quem fez o quê, quando e de onde. Desligado até você pedir."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cine ce a făcut, când și de unde. Oprit până îl cereți."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кто что сделал, когда и откуда. Выключен, пока вы не попросите."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vem som gjorde vad, när och varifrån. Av tills du ber om den."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใครทำอะไร เมื่อใด และจากที่ไหน ปิดอยู่เว้นแต่คุณจะเปิด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kim ne yaptı, ne zaman ve nereden. Siz istemedikçe kapalıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Хто що зробив, коли і звідки. Вимкнено, доки ви не ввімкнете."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai đã làm gì, khi nào và từ đâu. Tắt trừ khi bạn bật."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "谁在何时、从何处做了什么。除非你开启，否则不记录。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "誰在何時、從何處做了什麼。除非你開啟，否則不記錄。"
          }
        }
      }
    },
    "activityLog.unavailable": {
      "extractionState": "manual",
      "localizations": {
