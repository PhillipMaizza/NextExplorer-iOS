    "uploads.reviewInsecureNetworkNotice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected over http. If this server is only on your home network, uploads won't work while you're away from it."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متصل عبر http. إذا كان هذا الخادم على شبكتك المنزلية فقط، فلن يعمل الرفع عندما تكون بعيدًا عنها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über http verbunden. Wenn dieser Server nur in deinem Heimnetzwerk ist, funktionieren Uploads nicht, wenn du dich außerhalb befindest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectado por http. Si este servidor solo está en tu red doméstica, las subidas no funcionarán cuando estés fuera de ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecté en http. Si ce serveur n'est que sur votre réseau domestique, les envois ne fonctionneront pas hors de ce réseau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "http के माध्यम से कनेक्ट किया गया। यदि यह सर्वर केवल आपके होम नेटवर्क पर है, तो उससे दूर रहने पर अपलोड काम नहीं करेंगे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Connesso tramite http. Se questo server è solo sulla tua rete domestica, i caricamenti non funzioneranno quando sei lontano da essa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "http で接続しています。このサーバがホームネットワークのみにある場合、そのネットワークから離れるとアップロードは機能しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "http로 연결되었습니다. 이 서버가 홈 네트워크에만 있다면 네트워크를 벗어나면 업로드가 작동하지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbonden via http. Als deze server alleen op je thuisnetwerk staat, werken uploads niet wanneer je er niet mee verbonden bent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połączono przez http. Jeśli ten serwer jest tylko w sieci domowej, przesyłanie nie będzie działać poza nią."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ligado por http. Se este servidor estiver apenas na sua rede doméstica, os envios não funcionarão quando estiver fora dela."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectat prin http. Dacă acest server este doar în rețeaua ta de acasă, încărcările nu vor funcționa când ești în afara ei."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключено по http. Если этот сервер доступен только в вашей домашней сети, отправка не будет работать вне её."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ansluten via http. Om den här servern bara finns i ditt hemnätverk fungerar inte uppladdningar när du är borta från det."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 http 连接。如果此服务器仅在您的家庭网络中，离开该网络时上传将无法工作。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "透過 http 連線。如果此伺服器僅在您的家庭網路中，離開該網路時上傳將無法運作。"
          }
        }
      }
    },
