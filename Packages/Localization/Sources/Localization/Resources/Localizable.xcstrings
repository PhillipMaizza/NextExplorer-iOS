    "userDetail.grantAdminMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ becomes an administrator with full control over files, shares and users. Administrators can't be demoted from the app."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ سيصبح مسؤولاً بتحكم كامل في الملفات والمشاركات والمستخدمين. لا يمكن إزالة صلاحيات المسؤول من التطبيق."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se stane správcem s plnou kontrolou nad soubory, sdíleními a uživateli. Správce nelze v aplikaci degradovat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bliver administrator med fuld kontrol over filer, delinger og brugere. Administratorer kan ikke nedgraderes fra appen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird Administrator mit voller Kontrolle über Dateien, Freigaben und Benutzer. Administratoren können in der App nicht herabgestuft werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο χρήστης %@ γίνεται διαχειριστής με πλήρη έλεγχο αρχείων, κοινοποιήσεων και χρηστών. Οι διαχειριστές δεν μπορούν να υποβαθμιστούν μέσα από την εφαρμογή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pasará a ser administrador con control total sobre archivos, recursos compartidos y usuarios. Los administradores no pueden ser degradados desde la app."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:sta tulee ylläpitäjä, jolla on täysi hallinta tiedostoihin, jakoihin ja käyttäjiin. Ylläpitäjiltä ei voi poistaa oikeuksia sovelluksessa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ deviendra administrateur avec un contrôle total sur les fichiers, les partages et les utilisateurs. Un administrateur ne peut pas être rétrogradé depuis l’app."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ הופך למנהל מערכת עם שליטה מלאה בקבצים, בשיתופים ובמשתמשים. לא ניתן להסיר הרשאת מנהל מתוך האפליקציה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ फ़ाइलों, शेयर और उपयोगकर्ताओं पर पूर्ण नियंत्रण के साथ एडमिन बन जाएगा। ऐप से किसी एडमिन की भूमिका घटाई नहीं जा सकती।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ rendszergazda lesz, teljes irányítással a fájlok, megosztások és felhasználók felett. A rendszergazdák nem fokozhatók le az alkalmazásból."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ menjadi administrator dengan kendali penuh atas file, berbagi, dan pengguna. Administrator tidak dapat diturunkan dari aplikasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ diventerà amministratore con pieno controllo su file, condivisioni e utenti. Gli amministratori non possono essere declassati dall'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は、ファイル、共有、ユーザを完全に管理できる管理者になります。管理者の権限はアプリから取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 님이 파일, 공유 및 사용자를 완전히 제어하는 관리자가 됩니다. 앱에서는 관리자 권한을 해제할 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ blir administrator med full kontroll over filer, delinger og brukere. Administratorer kan ikke nedgraderes fra appen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wordt beheerder met volledige controle over bestanden, shares en gebruikers. Beheerders kunnen niet vanuit de app worden gedegradeerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ zostanie administratorem z pełną kontrolą nad plikami, udostępnieniami i użytkownikami. Administratora nie można zdegradować z poziomu aplikacji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ passa a ser administrador com controlo total sobre ficheiros, partilhas e utilizadores. Os administradores não podem ser despromovidos a partir da aplicação."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ passa a ser administrador, com controle total sobre arquivos, compartilhamentos e usuários. Administradores não podem ser rebaixados pelo app."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ devine administrator, cu control deplin asupra fișierelor, partajărilor și utilizatorilor. Administratorii nu pot fi retrogradați din aplicație."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ станет администратором с полным контролем над файлами, общим доступом и пользователями. Из приложения нельзя лишить прав администратора."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ blir administratör med full kontroll över filer, delningar och användare. Administratörer kan inte nedgraderas från appen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ จะเป็นผู้ดูแลระบบที่ควบคุมไฟล์ การแชร์ และผู้ใช้ได้อย่างเต็มที่ ไม่สามารถลดสิทธิ์ผู้ดูแลระบบจากในแอปได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, dosyalar, paylaşımlar ve kullanıcılar üzerinde tam denetime sahip bir yönetici olur. Yöneticilerin yetkisi uygulamadan alınamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ стане адміністратором із повним контролем над файлами, спільним доступом і користувачами. Адміністраторів не можна понизити в застосунку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sẽ trở thành quản trị viên với toàn quyền kiểm soát tệp, chia sẻ và người dùng. Không thể hạ quyền quản trị viên từ ứng dụng."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 将成为管理员，可完全控制文件、共享和用户。无法在应用中撤销管理员权限。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 將成為管理員，可完整控制檔案、分享和使用者。無法從 App 中降級管理員。"
          }
        }
      }
    },
