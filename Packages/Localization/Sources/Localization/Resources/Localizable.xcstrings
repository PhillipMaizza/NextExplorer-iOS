          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For mange versioner mangler på én gang: intet blev ændret"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele Versionen fehlen auf einmal: Nichts wurde geändert"
