    "clientCertificate.removeMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer will stop presenting it to %@. If that server requires one, the app can't connect until you add a certificate again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتوقف NextExplorer عن تقديمها إلى %@. إذا كان هذا الخادم يتطلب شهادة، فلن يتمكن التطبيق من الاتصال حتى تضيف شهادة مرة أخرى."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer ho přestane předkládat serveru %@. Pokud tento server certifikát vyžaduje, aplikace se nepřipojí, dokud certifikát znovu nepřidáte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer holder op med at fremvise det for %@. Hvis serveren kræver et, kan appen ikke oprette forbindelse, før du tilføjer et certifikat igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer legt es %@ nicht mehr vor. Verlangt dieser Server eines, kann die App keine Verbindung herstellen, bis du wieder ein Zertifikat hinzufügst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το NextExplorer θα σταματήσει να το παρουσιάζει στο %@. Αν αυτός ο διακομιστής απαιτεί πιστοποιητικό, η εφαρμογή δεν μπορεί να συνδεθεί μέχρι να προσθέσετε ξανά πιστοποιητικό."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer dejará de presentarlo a %@. Si ese servidor lo exige, la app no podrá conectarse hasta que vuelvas a añadir un certificado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer lakkaa esittämästä sitä palvelimelle %@. Jos kyseinen palvelin vaatii varmenteen, sovellus ei voi yhdistää, ennen kuin lisäät varmenteen uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer ne le présentera plus à %@. Si ce serveur en exige un, l’app ne pourra pas se connecter tant que vous n’aurez pas ajouté un nouveau certificat."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer יפסיק להציג אותו ל-%@. אם השרת הזה דורש אישור, האפליקציה לא תוכל להתחבר עד שתוסיפו אישור שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer इसे %@ को दिखाना बंद कर देगा। अगर उस सर्वर को इसकी ज़रूरत है, तो जब तक आप फिर से सर्टिफ़िकेट नहीं जोड़ते, ऐप कनेक्ट नहीं कर पाएगा।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A NextExplorer nem mutatja be többé a(z) %@ kiszolgálónak. Ha az a kiszolgáló megköveteli, az alkalmazás nem tud csatlakozni, amíg újra hozzá nem ad egy tanúsítványt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer akan berhenti menyajikannya ke %@. Jika server itu memerlukannya, aplikasi tidak dapat terhubung sampai Anda menambahkan sertifikat lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer smetterà di presentarlo a %@. Se quel server lo richiede, l’app non potrà connettersi finché non aggiungi di nuovo un certificato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer は %@ にこの証明書を提示しなくなります。サーバーが証明書を必要とする場合、証明書を再度追加するまでアプリは接続できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer가 더 이상 %@에 이 인증서를 제시하지 않습니다. 서버에서 인증서를 요구하면 인증서를 다시 추가할 때까지 앱이 연결할 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer slutter å vise det frem for %@. Hvis serveren krever ett, kan ikke appen koble til før du legger til et sertifikat igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer toont het niet meer aan %@. Als die server er een vereist, kan de app geen verbinding maken totdat je opnieuw een certificaat toevoegt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer przestanie go przedstawiać serwerowi %@. Jeśli ten serwer go wymaga, aplikacja nie połączy się, dopóki ponownie nie dodasz certyfikatu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O NextExplorer deixará de o apresentar a %@. Se esse servidor o exigir, a app não consegue ligar-se até adicionar um certificado novamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O NextExplorer deixará de apresentá-lo a %@. Se esse servidor exigir um, o app não conseguirá se conectar até você adicionar um certificado novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer nu îl va mai prezenta serverului %@. Dacă serverul cere unul, aplicația nu se poate conecta până nu adaugi din nou un certificat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer больше не будет предъявлять его серверу %@. Если сервер его требует, приложение не сможет подключиться, пока вы снова не добавите сертификат."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer slutar visa upp det för %@. Om servern kräver ett kan appen inte ansluta förrän du lägger till ett certifikat igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer จะหยุดแสดงใบรับรองนี้ให้ %@ หากเซิร์ฟเวอร์นั้นต้องการ แอปจะเชื่อมต่อไม่ได้จนกว่าคุณจะเพิ่มใบรับรองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer bunu artık %@ sunucusuna sunmayacak. O sunucu bir sertifika gerektiriyorsa, yeniden sertifika ekleyene kadar uygulama bağlanamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer більше не пред’являтиме його серверу %@. Якщо цей сервер вимагає сертифікат, застосунок не зможе підключитися, доки ви знову не додасте сертифікат."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer sẽ ngừng xuất trình chứng chỉ này cho %@. Nếu máy chủ đó yêu cầu, ứng dụng sẽ không kết nối được cho đến khi bạn thêm lại chứng chỉ."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer 将不再向 %@ 出示此证书。如果该服务器要求证书，在您重新添加证书之前，App 将无法连接。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer 將不再向 %@ 出示此憑證。若該伺服器要求憑證，在你重新加入憑證之前，App 將無法連線。"
          }
        }
      }
    },
