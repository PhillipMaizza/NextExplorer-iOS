    "trashSettings.versionsInvalid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the values: 1 to 720 hours, 1 to 365 days per hour, 1 to 3650 days per day, 1 to 1000 versions per file, a checkpoint from 1 to 1440 minutes."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق من القيم: من 1 إلى 720 ساعة، ومن 1 إلى 365 يومًا لكل ساعة، ومن 1 إلى 3650 يومًا لكل يوم، ومن 1 إلى 1000 إصدار لكل ملف، ونقطة تحقق من 1 إلى 1440 دقيقة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkontrolujte hodnoty: 1 až 720 hodin, 1 až 365 dnů na hodinu, 1 až 3650 dnů na den, 1 až 1000 verzí na soubor, kontrolní bod od 1 do 1440 minut."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tjek værdierne: 1 til 720 timer, 1 til 365 dage pr. time, 1 til 3650 dage pr. dag, 1 til 1000 versioner pr. fil, et kontrolpunkt fra 1 til 1440 minutter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe die Werte: 1 bis 720 Stunden, 1 bis 365 Tage pro Stunde, 1 bis 3650 Tage pro Tag, 1 bis 1000 Versionen pro Datei, ein Zwischenstand von 1 bis 1440 Minuten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ελέγξτε τις τιμές: 1 έως 720 ώρες, 1 έως 365 ημέρες ανά ώρα, 1 έως 3650 ημέρες ανά ημέρα, 1 έως 1000 εκδόσεις ανά αρχείο, σημείο ελέγχου από 1 έως 1440 λεπτά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa los valores: de 1 a 720 horas, de 1 a 365 días por hora, de 1 a 3650 días por día, de 1 a 1000 versiones por archivo, un punto de control de 1 a 1440 minutos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkista arvot: 1–720 tuntia, 1–365 päivää tunnissa, 1–3650 päivää päivässä, 1–1000 versiota tiedostoa kohti, tarkistuspiste 1–1440 minuuttia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez les valeurs : 1 à 720 heures, 1 à 365 jours par heure, 1 à 3650 jours par jour, 1 à 1000 versions par fichier, un point d'étape de 1 à 1440 minutes."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בדקו את הערכים: 1 עד 720 שעות, 1 עד 365 ימים לשעה, 1 עד 3650 ימים ליום, 1 עד 1000 גרסאות לקובץ, נקודת ביקורת מ-1 עד 1440 דקות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मान जाँचें: 1 से 720 घंटे, प्रति घंटा 1 से 365 दिन, प्रति दिन 1 से 3650 दिन, प्रति फ़ाइल 1 से 1000 संस्करण, 1 से 1440 मिनट का चेकपॉइंट।."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ellenőrizze az értékeket: 1–720 óra, 1–365 nap óránként, 1–3650 nap naponta, 1–1000 verzió fájlonként, ellenőrzőpont 1–1440 perc."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Periksa nilainya: 1 sampai 720 jam, 1 sampai 365 hari per jam, 1 sampai 3650 hari per hari, 1 sampai 1000 versi per file, titik pemeriksaan 1 sampai 1440 menit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla i valori: da 1 a 720 ore, da 1 a 365 giorni orari, da 1 a 3650 giorni giornalieri, da 1 a 1000 versioni per file, un punto di controllo da 1 a 1440 minuti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "値を確認してください。1〜720時間、1時間あたり1〜365日、1日あたり1〜3650日、ファイルあたり1〜1000バージョン、チェックポイントは1〜1440分です。"
          }
        },
        "ko": {
          "stringUnit": {
