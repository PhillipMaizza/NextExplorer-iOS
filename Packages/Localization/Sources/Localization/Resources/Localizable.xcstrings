    "trashSettings.zonesSubtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each volume keeps its trash in a hidden .nextexplorer folder at its root, so deleting never copies anything."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتفظ كل وحدة تخزين بسلتها في مجلد مخفي باسم .nextexplorer في جذرها، لذا لا ينسخ الحذف أي شيء."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý svazek uchovává svůj koš ve skryté složce .nextexplorer v kořeni, takže smazání nic nekopíruje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert drev har sin papirkurv i en skjult .nextexplorer-mappe i roden, så sletning aldrig kopierer noget."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Volume bewahrt seinen Papierkorb in einem versteckten Ordner .nextexplorer an seiner Wurzel auf, daher kopiert Löschen nie etwas."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε τόμος κρατά τον κάδο του σε έναν κρυφό φάκελο .nextexplorer στη ρίζα του, επομένως η διαγραφή δεν αντιγράφει ποτέ τίποτα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada volumen guarda su papelera en una carpeta oculta .nextexplorer en su raíz, así que eliminar nunca copia nada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokainen taltio pitää roskakorinsa piilotetussa .nextexplorer-kansiossa juuressaan, joten poistaminen ei koskaan kopioi mitään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque volume garde sa corbeille dans un dossier caché .nextexplorer à sa racine : supprimer ne copie jamais rien."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל כרך שומר את פח האשפה שלו בתיקייה מוסתרת בשם ‎.nextexplorer‎ בשורש שלו, כך שמחיקה אינה מעתיקה דבר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर वॉल्यूम अपना रीसायकल बिन अपनी जड़ में छिपे फ़ोल्डर .nextexplorer में रखता है, इसलिए हटाना कभी कुछ कॉपी नहीं करता।."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden kötet a saját kukáját a gyökerében lévő rejtett .nextexplorer mappában tartja, így a törlés soha nem másol semmit."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap volume menyimpan sampahnya di folder tersembunyi .nextexplorer di root-nya, sehingga penghapusan tidak menyalin apa pun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni volume tiene il suo cestino in una cartella nascosta .nextexplorer nella sua radice, quindi eliminare non copia mai nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各ボリュームは、ルートの隠しフォルダ .nextexplorer にゴミ箱を保持するため、削除時に何もコピーされません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 볼륨은 루트의 숨김 폴더 .nextexplorer에 휴지통을 두므로 삭제할 때 아무것도 복사하지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert volum har papirkurven sin i en skjult .nextexplorer-mappe i roten, så sletting kopierer aldri noe."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk volume bewaart zijn prullenbak in een verborgen .nextexplorer-map in de hoofdmap, zodat verwijderen nooit iets kopieert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy wolumin trzyma swój kosz w ukrytym folderze .nextexplorer w katalogu głównym, więc usuwanie nigdy niczego nie kopiuje."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada volume guarda a sua reciclagem numa pasta oculta .nextexplorer na sua raiz, pelo que eliminar nunca copia nada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada volume guarda sua lixeira em uma pasta oculta .nextexplorer na raiz, então excluir nunca copia nada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare volum își păstrează coșul de gunoi într-un folder ascuns .nextexplorer la rădăcina sa, așa că ștergerea nu copiază niciodată nimic."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый том хранит свою корзину в скрытой папке .nextexplorer в корне, поэтому удаление никогда ничего не копирует."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje volym har sin papperskorg i en dold mapp .nextexplorer i roten, så radering kopierar aldrig något."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แต่ละวอลุ่มเก็บถังขยะของตัวเองไว้ในโฟลเดอร์ซ่อน .nextexplorer ที่รากของวอลุ่ม ดังนั้นการลบจึงไม่คัดลอกอะไรเลย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her birim çöp kutusunu kök dizinindeki gizli bir .nextexplorer klasöründe tutar, bu yüzden silme hiçbir şeyi kopyalamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен том зберігає свій кошик у прихованій папці .nextexplorer у корені, тож видалення нічого не копіює."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi volume giữ thùng rác của mình trong thư mục ẩn .nextexplorer ở gốc, nên việc xóa không sao chép gì cả."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "每个卷把回收站放在其根目录的隐藏文件夹 .nextexplorer 中，因此删除从不复制任何内容。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "每個卷宗把資源回收筒放在根目錄的隱藏資料夾 .nextexplorer 中，因此刪除從不複製任何內容。"
          }
        }
      }
    },
