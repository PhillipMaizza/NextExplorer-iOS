    "thumbnailSettings.qualityHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Higher looks better and uses more space."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأعلى يبدو أفضل ويستخدم مساحة أكبر."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyšší kvalita vypadá lépe a zabírá více místa."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Højere ser bedre ud og fylder mere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höher sieht besser aus und braucht mehr Speicher."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μεγαλύτερη τιμή φαίνεται καλύτερη και καταλαμβάνει περισσότερο χώρο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más alta se ve mejor y usa más espacio."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Korkeampi näyttää paremmalta ja vie enemmän tilaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus élevée : meilleur rendu, plus d'espace utilisé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ערך גבוה נראה טוב יותר ותופס יותר מקום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उच्चतर बेहतर दिखता है और अधिक स्थान लेता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A magasabb szebben néz ki, és több helyet foglal."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lebih tinggi terlihat lebih baik dan memakai lebih banyak ruang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più alta appare meglio e usa più spazio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高いほど見栄えが良くなり、容量も増えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "높을수록 더 좋아 보이고 더 많은 공간을 사용합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Høyere ser bedre ut og bruker mer plass."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoger ziet er beter uit en gebruikt meer ruimte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyższa wygląda lepiej i zajmuje więcej miejsca."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais alta fica melhor e ocupa mais espaço."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais alta fica melhor e ocupa mais espaço."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mai mare arată mai bine și ocupă mai mult spațiu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чем выше, тем лучше выглядит и больше места занимает."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Högre ser bättre ut och tar mer plats."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค่าสูงขึ้นดูดีกว่าแต่ใช้พื้นที่มากกว่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüksek değer daha iyi görünür ve daha fazla yer kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вища якість виглядає краще й займає більше місця."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cao hơn trông đẹp hơn nhưng tốn nhiều dung lượng hơn."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "越高看起来越好，占用空间也越多。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "越高看起來越好，佔用空間也越多。"
          }
        }
      }
    },
