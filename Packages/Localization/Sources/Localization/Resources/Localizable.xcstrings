        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Resim ve videoları kaydetmek için Ayarlar’da Fotoğraflar erişimine izin verin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозвольте доступ до Фото в налаштуваннях, щоб зберігати зображення й відео."
