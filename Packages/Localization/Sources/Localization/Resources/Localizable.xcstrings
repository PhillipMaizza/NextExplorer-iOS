    "trashSettings.maxSizeHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. The smaller of the share and the cap applies."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختياري. يُطبَّق الأصغر بين الحصة والحد."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Volitelné. Platí menší z podílu a limitu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgfrit. Den mindste af andelen og grænsen gælder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Es gilt der kleinere Wert von Anteil und Limit."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προαιρετικό. Ισχύει το μικρότερο μεταξύ του μεριδίου και του ορίου."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. Se aplica el menor entre la parte y el límite."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valinnainen. Osuuden ja rajan pienempi on voimassa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif. La plus petite des deux limites s'applique."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אופציונלי. חל הקטן מבין החלק והמגבלה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वैकल्पिक। हिस्से और सीमा में से छोटा लागू होता है।."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem kötelező. Az arány és a korlát közül a kisebb érvényes."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Opsional. Yang lebih kecil antara bagian dan batas yang berlaku."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Facoltativo. Si applica il minore tra quota e limite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意。割合と上限のうち小さいほうが適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 사항. 비율과 제한 중 작은 값이 적용됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgfritt. Den minste av andelen og grensen gjelder."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Optioneel. De kleinste van het aandeel en het maximum geldt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcjonalnie. Obowiązuje mniejsza z wartości: udział lub limit."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. Aplica-se o menor entre a parte e o limite."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. Vale o menor entre a parte e o limite."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Opțional. Se aplică cea mai mică dintre cotă și limită."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Необязательно. Применяется меньшее из доли и предела."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Valfritt. Det minsta av andelen och gränsen gäller."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่บังคับ ใช้ค่าที่น้อยกว่าระหว่างสัดส่วนและขีดจำกัด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İsteğe bağlı. Pay ile sınırdan küçük olanı geçerlidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Необов’язково. Діє менше зі значень частки й обмеження."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tùy chọn. Áp dụng giá trị nhỏ hơn giữa phần và giới hạn."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "可选。占比与上限取较小者。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "選填。比例與上限取較小者。"
          }
        }
      }
