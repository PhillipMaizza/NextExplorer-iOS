    "userDetail.volumesNoneSubtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This user only sees the default shared space."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرى هذا المستخدم المساحة المشتركة الافتراضية فقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Benutzer sieht nur den standardmäßigen freigegebenen Bereich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este usuario solo ve el espacio compartido predeterminado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet utilisateur ne voit que l'espace partagé par défaut."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह उपयोगकर्ता केवल डिफ़ॉल्ट साझा स्थान देखता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo utente vede solo lo spazio condiviso predefinito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このユーザはデフォルトの共有スペースのみを表示できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사용자는 기본 공유 공간만 볼 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze gebruiker ziet alleen de standaard gedeelde ruimte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten użytkownik widzi tylko domyślną przestrzeń współdzieloną."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este utilizador só vê o espaço partilhado predefinido."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest utilizator vede doar spațiul partajat implicit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот пользователь видит только стандартное общее пространство."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här användaren ser bara det delade standardutrymmet."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此用户仅能看到默认共享空间。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "此使用者僅能看到預設共享空間。"
          }
        }
