    "clientCertificate.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some servers only let in devices that present a client certificate (mTLS). Choose the .p12 or .pfx file you were given for this server."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسمح بعض الخوادم فقط بالأجهزة التي تقدّم شهادة عميل (mTLS). اختر ملف .p12 أو .pfx الذي حصلت عليه لهذا الخادم."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Některé servery pouštějí jen zařízení, která předloží klientský certifikát (mTLS). Vyberte soubor .p12 nebo .pfx, který jste pro tento server dostali."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nogle servere lukker kun enheder ind, der fremviser et klientcertifikat (mTLS). Vælg den .p12- eller .pfx-fil, du har fået til denne server."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Manche Server lassen nur Geräte zu, die ein Client-Zertifikat vorweisen (mTLS). Wähle die .p12- oder .pfx-Datei, die du für diesen Server erhalten hast."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ορισμένοι διακομιστές δέχονται μόνο συσκευές που παρουσιάζουν πιστοποιητικό πελάτη (mTLS). Επιλέξτε το αρχείο .p12 ή .pfx που σας δόθηκε για αυτόν τον διακομιστή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos servidores solo admiten dispositivos que presentan un certificado de cliente (mTLS). Elige el archivo .p12 o .pfx que te dieron para este servidor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jotkin palvelimet päästävät sisään vain laitteet, jotka esittävät asiakasvarmenteen (mTLS). Valitse .p12- tai .pfx-tiedosto, jonka sait tälle palvelimelle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains serveurs n’acceptent que les appareils qui présentent un certificat client (mTLS). Choisissez le fichier .p12 ou .pfx qui vous a été fourni pour ce serveur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שרתים מסוימים מאפשרים כניסה רק למכשירים שמציגים אישור לקוח (mTLS). בחרו את קובץ ה-p12 או ה-pfx שקיבלתם עבור השרת הזה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ सर्वर केवल उन्हीं डिवाइस को आने देते हैं जो क्लाइंट सर्टिफ़िकेट (mTLS) दिखाते हैं। इस सर्वर के लिए मिली .p12 या .pfx फ़ाइल चुनें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyes kiszolgálók csak azokat az eszközöket engedik be, amelyek kliens tanúsítványt mutatnak (mTLS). Válassza ki a .p12 vagy .pfx fájlt, amelyet ehhez a kiszolgálóhoz kapott."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beberapa server hanya mengizinkan perangkat yang menunjukkan sertifikat klien (mTLS). Pilih file .p12 atau .pfx yang diberikan untuk server ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcuni server accettano solo dispositivi che presentano un certificato client (mTLS). Scegli il file .p12 o .pfx che ti è stato fornito per questo server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クライアント証明書 (mTLS) を提示したデバイスだけを受け入れるサーバーがあります。このサーバー用に受け取った .p12 または .pfx ファイルを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 서버는 클라이언트 인증서(mTLS)를 제시하는 기기만 허용합니다. 이 서버용으로 받은 .p12 또는 .pfx 파일을 선택하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Noen servere slipper bare inn enheter som viser frem et klientsertifikat (mTLS). Velg .p12- eller .pfx-filen du fikk for denne serveren."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommige servers laten alleen apparaten toe die een clientcertificaat tonen (mTLS). Kies het .p12- of .pfx-bestand dat je voor deze server hebt gekregen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niektóre serwery wpuszczają tylko urządzenia, które przedstawią certyfikat klienta (mTLS). Wybierz plik .p12 lub .pfx otrzymany dla tego serwera."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns servidores só aceitam dispositivos que apresentam um certificado de cliente (mTLS). Escolha o ficheiro .p12 ou .pfx que recebeu para este servidor."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns servidores só aceitam dispositivos que apresentam um certificado de cliente (mTLS). Escolha o arquivo .p12 ou .pfx que você recebeu para este servidor."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Unele servere permit accesul doar dispozitivelor care prezintă un certificat de client (mTLS). Alege fișierul .p12 sau .pfx primit pentru acest server."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Некоторые серверы пускают только устройства с клиентским сертификатом (mTLS). Выберите файл .p12 или .pfx, который вам выдали для этого сервера."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vissa servrar släpper bara in enheter som visar upp ett klientcertifikat (mTLS). Välj den .p12- eller .pfx-fil du fick för den här servern."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เซิร์ฟเวอร์บางแห่งอนุญาตเฉพาะอุปกรณ์ที่แสดงใบรับรองไคลเอนต์ (mTLS) เลือกไฟล์ .p12 หรือ .pfx ที่คุณได้รับสำหรับเซิร์ฟเวอร์นี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazı sunucular yalnızca istemci sertifikası (mTLS) sunan cihazlara izin verir. Bu sunucu için size verilen .p12 veya .pfx dosyasını seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Деякі сервери пускають лише пристрої, що пред’являють клієнтський сертифікат (mTLS). Виберіть файл .p12 або .pfx, наданий для цього сервера."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một số máy chủ chỉ cho phép các thiết bị xuất trình chứng chỉ máy khách (mTLS). Hãy chọn tệp .p12 hoặc .pfx bạn được cấp cho máy chủ này."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "有些服务器只允许出示客户端证书 (mTLS) 的设备访问。请选择为此服务器提供给您的 .p12 或 .pfx 文件。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "有些伺服器只允許出示用戶端憑證 (mTLS) 的裝置存取。請選擇為此伺服器提供給你的 .p12 或 .pfx 檔案。"
          }
        }
      }
    },
