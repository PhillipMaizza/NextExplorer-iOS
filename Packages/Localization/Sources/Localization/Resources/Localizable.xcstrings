    "serverDetails.cameraDeniedMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on camera access in Settings to take a photo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فعّل الوصول إلى الكاميرا في الإعدادات لالتقاط صورة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapněte v Nastavení přístup k fotoaparátu, abyste mohli pořídit fotku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå kameraadgang til i Indstillinger for at tage et foto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere den Kamerazugriff in den Einstellungen, um ein Foto aufzunehmen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενεργοποιήστε την πρόσβαση στην κάμερα στις Ρυθμίσεις για να τραβήξετε φωτογραφία."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa el acceso a la cámara en Ajustes para hacer una foto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salli kameran käyttö Asetuksissa ottaaksesi kuvan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez l'accès à l'appareil photo dans Réglages pour prendre une photo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפעילו גישה למצלמה בהגדרות כדי לצלם תמונה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोटो लेने के लिए सेटिंग्स में कैमरा एक्सेस चालू करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsolja be a kamerahozzáférést a Beállításokban fénykép készítéséhez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktifkan akses kamera di Pengaturan untuk mengambil foto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva l'accesso alla fotocamera in Impostazioni per scattare una foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を撮るには、設定でカメラへのアクセスをオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진을 촬영하려면 설정에서 카메라 접근을 켜세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på kameratilgang i Innstillinger for å ta et bilde."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet cameratoegang aan in Instellingen om een foto te maken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz dostęp do aparatu w Ustawieniach, aby zrobić zdjęcie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o acesso à câmara nas Definições para tirar uma foto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o acesso à câmera em Configurações para tirar uma foto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Activează accesul la cameră în Setări pentru a face o fotografie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите доступ к камере в Настройках, чтобы сделать фото."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivera kameraåtkomst i Inställningar för att ta ett foto."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดการเข้าถึงกล้องในการตั้งค่าเพื่อถ่ายภาพ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraf çekmek için Ayarlar'da kamera erişimini açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть доступ до камери в Налаштуваннях, щоб зробити фото."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật quyền truy cập camera trong Cài đặt để chụp ảnh."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“设置”中开启相机访问以便拍照。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「設定」中開啟相機取用以便拍照。"
          }
        }
      }
    },
