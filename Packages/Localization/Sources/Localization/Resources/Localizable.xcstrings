    "uploadSettings.chunkSizeHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximum size of each upload request. Keep this below your reverse proxy limit. Smaller chunks give smoother progress."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحجم الأقصى لكل طلب رفع. أبقِه أقل من حد الوكيل العكسي لديك. الأجزاء الأصغر تعطي تقدمًا أكثر سلاسة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximální velikost každého požadavku na nahrání. Držte ji pod limitem vašeho reverzního proxy. Menší části dávají plynulejší průběh."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Maksimal størrelse på hver uploadforespørgsel. Hold den under grænsen på din reverse proxy. Mindre blokke giver jævnere fremdrift."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximale Größe jeder Upload-Anfrage. Halte sie unter dem Limit deines Reverse-Proxys. Kleinere Teile ergeben einen gleichmäßigeren Fortschritt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το μέγιστο μέγεθος κάθε αιτήματος μεταφόρτωσης. Κρατήστε το κάτω από το όριο του αντίστροφου διακομιστή μεσολάβησης. Τα μικρότερα τμήματα δίνουν πιο ομαλή πρόοδο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamaño máximo de cada solicitud de subida. Mantenlo por debajo del límite de tu proxy inverso. Las partes más pequeñas dan un progreso más fluido."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunkin lähetyspyynnön enimmäiskoko. Pidä se käänteisen välityspalvelimesi rajan alapuolella. Pienemmät osat antavat tasaisemman edistymisen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taille maximale de chaque requête d’envoi. Gardez-la sous la limite de votre proxy inverse. Des morceaux plus petits donnent une progression plus fluide."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגודל המרבי של כל בקשת העלאה. שמרו אותו מתחת למגבלה של פרוקסי הפוך שלכם. חלקים קטנים יותר נותנים התקדמות חלקה יותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर अपलोड अनुरोध का अधिकतम आकार। इसे अपने रिवर्स प्रॉक्सी की सीमा से कम रखें। छोटे हिस्सों से प्रगति अधिक सहज दिखती है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az egyes feltöltési kérések legnagyobb mérete. Tartsa a fordított proxy korlátja alatt. A kisebb darabok egyenletesebb haladást adnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukuran maksimum setiap permintaan unggah. Jaga agar tetap di bawah batas reverse proxy Anda. Potongan lebih kecil memberi kemajuan yang lebih mulus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimensione massima di ogni richiesta di caricamento. Tienila sotto il limite del tuo reverse proxy. Blocchi più piccoli danno un avanzamento più fluido."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各アップロードリクエストの最大サイズです。リバースプロキシの上限より小さくしてください。小さく分けるほど進行状況が滑らかになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 업로드 요청의 최대 크기입니다. 리버스 프록시의 제한보다 작게 유지하세요. 작게 나눌수록 진행이 더 부드럽습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Maksimal størrelse på hver opplastingsforespørsel. Hold den under grensen til reverse proxy-en din. Mindre deler gir jevnere fremdrift."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximale grootte van elk uploadverzoek. Houd dit onder de limiet van je reverse proxy. Kleinere delen geven een vloeiendere voortgang."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maksymalny rozmiar każdego żądania przesyłania. Utrzymaj go poniżej limitu swojego reverse proxy. Mniejsze części dają płynniejszy postęp."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamanho máximo de cada pedido de envio. Mantenha-o abaixo do limite do seu proxy inverso. Partes mais pequenas dão um progresso mais fluido."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamanho máximo de cada solicitação de envio. Mantenha-o abaixo do limite do seu proxy reverso. Partes menores dão um progresso mais fluido."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimensiunea maximă a fiecărei cereri de încărcare. Păstrează-o sub limita reverse proxy-ului tău. Bucățile mai mici dau un progres mai fluid."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Максимальный размер каждого запроса загрузки. Держите его ниже лимита вашего обратного прокси. Меньшие части дают более плавный прогресс."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Största storlek för varje uppladdningsförfrågan. Håll den under gränsen för din reverse proxy. Mindre delar ger jämnare framsteg."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขนาดสูงสุดของแต่ละคำขออัปโหลด ควรตั้งให้ต่ำกว่าขีดจำกัดของรีเวิร์สพร็อกซีของคุณ ส่วนที่เล็กลงให้ความคืบหน้าที่ราบรื่นกว่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her yükleme isteğinin en büyük boyutu. Bunu ters proxy sınırınızın altında tutun. Daha küçük parçalar daha akıcı ilerleme sağlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Максимальний розмір кожного запиту вивантаження. Тримайте його нижче за ліміт вашого зворотного проксі. Менші частини дають плавніший прогрес."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kích thước tối đa của mỗi yêu cầu tải lên. Hãy giữ dưới giới hạn của reverse proxy. Phần nhỏ hơn cho tiến trình mượt hơn."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "每个上传请求的最大大小。请保持在反向代理的限制以下。分块越小，进度越平滑。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "每個上傳請求的大小上限。請保持在反向代理的限制以下。分塊越小，進度越平順。"
          }
        }
      }
    },
