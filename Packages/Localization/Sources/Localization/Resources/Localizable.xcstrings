    "thumbnailSettings.qualityHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Higher looks better and uses more space."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأعلى يبدو أفضل ويستخدم مساحة أكبر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höher sieht besser aus und braucht mehr Speicher."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más alta se ve mejor y usa más espacio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus élevée : meilleur rendu, plus d'espace utilisé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उच्चतर बेहतर दिखता है और अधिक स्थान लेता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più alta appare meglio e usa più spazio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高いほど見栄えが良くなり、容量も増えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "높을수록 더 좋아 보이고 더 많은 공간을 사용합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoger ziet er beter uit en gebruikt meer ruimte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyższa wygląda lepiej i zajmuje więcej miejsca."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais alta fica melhor e ocupa mais espaço."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mai mare arată mai bine și ocupă mai mult spațiu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выше — лучше выглядит и занимает больше места."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Högre ser bättre ut och tar mer plats."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "越高看起来越好，占用空间也越多。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "越高看起來越好，佔用空間也越多。"
          }
        }
      }
    },
