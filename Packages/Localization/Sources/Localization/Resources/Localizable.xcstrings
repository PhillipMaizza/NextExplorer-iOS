    "offline.tabEmpty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is available offline yet. Choose Available Offline on a file or folder."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء متاح دون اتصال بعد. اختر «متاح دون اتصال» لملف أو مجلد."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím není nic dostupné offline. U souboru nebo složky zvolte „Dostupné offline“."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet er tilgængeligt offline endnu. Vælg “Tilgængelig offline” på en fil eller mappe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nichts offline verfügbar. Wähle bei einer Datei oder einem Ordner „Offline verfügbar“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τίποτα δεν είναι διαθέσιμο εκτός σύνδεσης ακόμη. Επιλέξτε «Διαθέσιμο εκτός σύνδεσης» σε ένα αρχείο ή φάκελο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay nada disponible sin conexión. Elige «Disponible sin conexión» en un archivo o carpeta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitään ei ole vielä saatavilla offline-tilassa. Valitse tiedostolle tai kansiolle “Saatavilla offline-tilassa”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’est encore disponible hors connexion. Choisissez « Disponible hors ligne » sur un fichier ou un dossier."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדיין אין דבר זמין ללא חיבור. בחרו ״זמין במצב לא מקוון״ בקובץ או בתיקייה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कुछ भी ऑफ़लाइन उपलब्ध नहीं है। किसी फ़ाइल या फ़ोल्डर पर “ऑफ़लाइन उपलब्ध” चुनें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még semmi sem érhető el offline. Válassza a(z) „Elérhető offline” lehetőséget egy fájlnál vagy mappánál."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada yang tersedia secara offline. Pilih “Tersedia offline” pada file atau folder."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nulla è disponibile offline. Scegli “Disponibile offline” su un file o una cartella."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフラインで利用できる項目はまだありません。ファイルまたはフォルダで「オフラインで利用可能」を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인으로 사용할 수 있는 항목이 아직 없습니다. 파일이나 폴더에서 “오프라인 사용 가능”을(를) 선택하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting er tilgjengelig uten nett ennå. Velg «Tilgjengelig frakoblet» på en fil eller mappe."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is nog niets offline beschikbaar. Kies ‘Offline beschikbaar’ bij een bestand of map."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie jest jeszcze dostępne offline. Wybierz „Dostępne offline” przy pliku lub folderze."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há nada disponível offline. Escolha “Disponível offline” num ficheiro ou pasta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há nada disponível offline. Escolha “Disponível offline” em um arquivo ou pasta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încă nu este nimic disponibil offline. Alege „Disponibil offline” pentru un fișier sau un dosar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока нет ничего, что доступно офлайн. Выберите «Доступно офлайн» для файла или папки."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget är tillgängligt offline än. Välj ”Tillgängligt offline” för en fil eller mapp."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีสิ่งใดใช้งานแบบออฟไลน์ได้ เลือก “ใช้งานแบบออฟไลน์ได้” ที่ไฟล์หรือโฟลเดอร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz çevrimdışı kullanılabilir bir şey yok. Bir dosya veya klasörde “Çevrimdışı kullanılabilir” seçeneğini seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поки що нічого немає в офлайн-доступі. Виберіть «Доступно офлайн» для файлу або папки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có gì khả dụng ngoại tuyến. Chọn “Có sẵn ngoại tuyến” trên một tệp hoặc thư mục."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "目前还没有可离线使用的内容。请在文件或文件夹上选择“可离线使用”。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "目前還沒有可離線使用的項目。請在檔案或檔案夾上選擇「可離線使用」。"
          }
        }
      }
    },
    "offline.tunnelSpeedNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reaching your server through a remote tunnel can slow downloads. For large files, connect to the same network and use your server's local address."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد يؤدي الوصول إلى خادمك عبر نفق بعيد إلى إبطاء التنزيلات. للملفات الكبيرة، اتصل بالشبكة نفسها واستخدم العنوان المحلي لخادمك."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připojení k serveru přes vzdálený tunel může stahování zpomalit. U velkých souborů se připojte ke stejné síti a použijte místní adresu serveru."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At nå din server via en fjerntunnel kan gøre downloads langsommere. Til store filer skal du oprette forbindelse til samme netværk og bruge serverens lokale adresse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zugriff auf deinen Server über einen entfernten Tunnel kann Downloads verlangsamen. Verbinde dich für große Dateien mit demselben Netzwerk und verwende die lokale Adresse deines Servers."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η πρόσβαση στον διακομιστή μέσω απομακρυσμένης σήραγγας μπορεί να επιβραδύνει τις λήψεις. Για μεγάλα αρχεία, συνδεθείτε στο ίδιο δίκτυο και χρησιμοποιήστε την τοπική διεύθυνση του διακομιστή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acceder a tu servidor a través de un túnel remoto puede ralentizar las descargas. Para archivos grandes, conéctate a la misma red y usa la dirección local de tu servidor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palvelimeen pääsy etätunnelin kautta voi hidastaa latauksia. Suurille tiedostoille yhdistä samaan verkkoon ja käytä palvelimen paikallista osoitetta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accéder à votre serveur via un tunnel distant peut ralentir les téléchargements. Pour les gros fichiers, connectez-vous au même réseau et utilisez l'adresse locale de votre serveur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גישה לשרת דרך מנהרה מרוחקת עלולה להאט הורדות. לקבצים גדולים, התחברו לאותה רשת והשתמשו בכתובת המקומית של השרת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी रिमोट टनल के ज़रिए अपने सर्वर तक पहुँचने से डाउनलोड धीमे हो सकते हैं। बड़ी फ़ाइलों के लिए, उसी नेटवर्क से कनेक्ट करें और अपने सर्वर का लोकल पता इस्तेमाल करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kiszolgáló távoli alagúton keresztüli elérése lassíthatja a letöltéseket. Nagy fájlok esetén csatlakozzon ugyanahhoz a hálózathoz, és használja a kiszolgáló helyi címét."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menjangkau server melalui terowongan jarak jauh dapat memperlambat unduhan. Untuk file besar, hubungkan ke jaringan yang sama dan gunakan alamat lokal server Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Raggiungere il server tramite un tunnel remoto può rallentare i download. Per i file di grandi dimensioni, collegati alla stessa rete e usa l'indirizzo locale del server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモートトンネル経由でサーバーに接続するとダウンロードが遅くなることがあります。大きなファイルの場合は、同じネットワークに接続してサーバーのローカルアドレスを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원격 터널을 통해 서버에 연결하면 다운로드가 느려질 수 있습니다. 큰 파일은 같은 네트워크에 연결한 뒤 서버의 로컬 주소를 사용하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å nå serveren din via en ekstern tunnel kan gjøre nedlastinger tregere. For store filer bør du koble til samme nettverk og bruke serverens lokale adresse."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toegang tot je server via een externe tunnel kan downloads vertragen. Verbind voor grote bestanden met hetzelfde netwerk en gebruik het lokale adres van je server."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Łączenie się z serwerem przez zdalny tunel może spowalniać pobieranie. W przypadku dużych plików połącz się z tą samą siecią i użyj lokalnego adresu serwera."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceder ao teu servidor através de um túnel remoto pode tornar as transferências lentas. Para ficheiros grandes, liga-te à mesma rede e usa o endereço local do servidor."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acessar seu servidor por um túnel remoto pode deixar os downloads lentos. Para arquivos grandes, conecte-se à mesma rede e use o endereço local do servidor."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesarea serverului printr-un tunel la distanță poate încetini descărcările. Pentru fișiere mari, conectează-te la aceeași rețea și folosește adresa locală a serverului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к серверу через удалённый туннель может замедлить загрузки. Для больших файлов подключитесь к той же сети и используйте локальный адрес сервера."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att nå servern via en fjärrtunnel kan göra nedladdningar långsamma. Anslut till samma nätverk och använd serverns lokala adress för stora filer."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเข้าถึงเซิร์ฟเวอร์ผ่านอุโมงค์ระยะไกลอาจทำให้การดาวน์โหลดช้าลง สำหรับไฟล์ขนาดใหญ่ ให้เชื่อมต่อเครือข่ายเดียวกันและใช้ที่อยู่ภายในของเซิร์ฟเวอร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucunuza uzak bir tünel üzerinden ulaşmak indirmeleri yavaşlatabilir. Büyük dosyalar için aynı ağa bağlanın ve sunucunuzun yerel adresini kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ до сервера через віддалений тунель може уповільнювати завантаження. Для великих файлів підключіться до тієї самої мережі й скористайтеся локальною адресою сервера."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Truy cập máy chủ qua đường hầm từ xa có thể làm chậm việc tải xuống. Với tệp lớn, hãy kết nối cùng mạng và dùng địa chỉ cục bộ của máy chủ."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "通过远程隧道访问服务器可能会降低下载速度。下载大文件时，请连接到同一网络并使用服务器的本地地址。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "透過遠端通道存取伺服器可能會拖慢下載速度。下載大型檔案時，請連線到相同網路並使用伺服器的本機位址。"
          }
        }
      }
    },
