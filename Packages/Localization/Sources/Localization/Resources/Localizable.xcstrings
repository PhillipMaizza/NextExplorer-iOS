    "uploadSettings.autoFallbackHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If a direct upload fails because a reverse proxy rejects the body size, switch to chunked uploads automatically."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا فشل الرفع المباشر لأن وكيلًا عكسيًا يرفض الحجم، يتم التحويل تلقائيًا إلى الرفع على أجزاء."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud přímé nahrání selže, protože reverzní proxy odmítne velikost těla požadavku, automaticky se přepne na nahrávání po částech."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis en direkte upload mislykkes, fordi en reverse proxy afviser størrelsen, skiftes der automatisk til opdelte uploads."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn ein direkter Upload scheitert, weil ein Reverse-Proxy die Größe ablehnt, wird automatisch auf Uploads in Teilen umgeschaltet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν μια άμεση μεταφόρτωση αποτύχει επειδή ένας αντίστροφος διακομιστής μεσολάβησης απορρίπτει το μέγεθος, γίνεται αυτόματη εναλλαγή σε τμηματική μεταφόρτωση."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si una subida directa falla porque un proxy inverso rechaza el tamaño, cambia automáticamente a subidas por partes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos suora lähetys epäonnistuu, koska käänteinen välityspalvelin hylkää sisällön koon, siirrytään automaattisesti osissa lähettämiseen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si un envoi direct échoue parce qu’un proxy inverse refuse la taille, bascule automatiquement vers des envois par morceaux."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אם העלאה ישירה נכשלת כי פרוקסי הפוך דוחה את גודל הגוף, עוברים אוטומטית להעלאה בחלקים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर रिवर्स प्रॉक्सी आकार को अस्वीकार करने से सीधा अपलोड विफल हो जाए, तो अपने-आप हिस्सों में अपलोड पर स्विच हो जाता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha egy közvetlen feltöltés azért hiúsul meg, mert a fordított proxy elutasítja a méretet, automatikusan darabolt feltöltésre vált."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika unggahan langsung gagal karena reverse proxy menolak ukuran isi, beralih ke unggahan bertahap secara otomatis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se un caricamento diretto fallisce perché un reverse proxy rifiuta la dimensione, passa automaticamente ai caricamenti a blocchi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リバースプロキシがサイズを拒否して直接アップロードに失敗した場合、自動的に分割アップロードに切り替えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "리버스 프록시가 크기를 거부해 직접 업로드가 실패하면 자동으로 분할 업로드로 전환합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis en direkte opplasting mislykkes fordi en reverse proxy avviser størrelsen, byttes det automatisk til oppdelte opplastinger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als een directe upload mislukt omdat een reverse proxy de grootte weigert, wordt automatisch overgeschakeld naar uploads in delen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli bezpośrednie przesyłanie się nie powiedzie, bo reverse proxy odrzuca rozmiar, automatycznie przechodzi na przesyłanie w częściach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se um envio direto falhar porque um proxy inverso rejeita o tamanho, muda automaticamente para envios por partes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se um envio direto falhar porque um proxy reverso rejeita o tamanho, muda automaticamente para envios em partes."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă o încărcare directă eșuează pentru că un reverse proxy refuză dimensiunea, trece automat la încărcări pe bucăți."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если прямая загрузка не удалась, потому что обратный прокси отклоняет размер, автоматически переключается на загрузку по частям."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om en direkt uppladdning misslyckas eftersom en reverse proxy avvisar storleken växlar den automatiskt till uppladdning i delar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากการอัปโหลดโดยตรงล้มเหลวเพราะรีเวิร์สพร็อกซีปฏิเสธขนาด ระบบจะสลับเป็นการอัปโหลดแบบแบ่งส่วนโดยอัตโนมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ters proxy gövde boyutunu reddettiği için doğrudan yükleme başarısız olursa, otomatik olarak parçalı yüklemeye geçilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо пряме вивантаження не вдалося, бо зворотний проксі відхиляє розмір тіла запиту, автоматично перемикатися на вивантаження частинами."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu tải lên trực tiếp thất bại vì reverse proxy từ chối kích thước nội dung, tự động chuyển sang tải lên theo từng phần."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "如果直接上传因反向代理拒绝该大小而失败，则自动切换为分块上传。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "如果直接上傳因反向代理拒絕該大小而失敗，則自動切換為分塊上傳。"
          }
        }
      }
    },
