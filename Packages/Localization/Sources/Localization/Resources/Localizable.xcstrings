    "folderSizeSettings.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclude paths from folder size calculation and indexing."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استبعد مسارات من حساب أحجام المجلدات وفهرستها."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyloučit cesty z výpočtu a indexování velikostí složek."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Udeluk stier fra beregning og indeksering af mappestørrelser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pfade von der Berechnung und Indizierung der Ordnergrößen ausschließen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εξαίρεση διαδρομών από τον υπολογισμό και την ευρετηρίαση μεγεθών φακέλων."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluye rutas del cálculo y la indexación del tamaño de las carpetas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rajaa polkuja pois kansioiden kokojen laskennasta ja indeksoinnista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclure des chemins du calcul et de l’indexation des tailles."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החרגת נתיבים מחישוב גדלי תיקיות ומאינדוקס שלהם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोल्डर आकार की गणना और अनुक्रमण से पथ बाहर रखें।."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elérési utak kizárása a mappaméretek számításából és indexeléséből."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kecualikan jalur dari penghitungan dan pengindeksan ukuran folder."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Escludi percorsi dal calcolo e dall'indicizzazione delle dimensioni delle cartelle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダサイズの計算とインデックス作成から除外するパスを指定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더 크기 계산 및 인덱싱에서 제외할 경로를 지정합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Utelat stier fra beregning og indeksering av mappestørrelser."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Paden uitsluiten van het berekenen en indexeren van mapgroottes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyklucz ścieżki z obliczania i indeksowania rozmiaru folderów."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclua caminhos do cálculo e da indexação dos tamanhos das pastas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclua caminhos do cálculo e da indexação dos tamanhos das pastas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclude căi din calculul și indexarea dimensiunii dosarelor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исключите пути из расчета и индексации размеров папок."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Undanta sökvägar från beräkning och indexering av mappstorlekar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยกเว้นพาธจากการคำนวณและการสร้างดัชนีขนาดโฟลเดอร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yolları klasör boyutu hesaplamasının ve dizinlemesinin dışında tutun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виключіть шляхи з обчислення й індексації розмірів папок."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Loại trừ các đường dẫn khỏi việc tính và lập chỉ mục kích thước thư mục."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "将路径排除在文件夹大小计算和索引之外。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "將路徑排除在資料夾大小計算與索引之外。"
          }
        }
      }
    },
    "folderSizeSettings.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder size settings are only available to administrators."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعدادات أحجام المجلدات متاحة للمشرفين فقط."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavení velikostí složek je dostupné pouze správcům."
          }
