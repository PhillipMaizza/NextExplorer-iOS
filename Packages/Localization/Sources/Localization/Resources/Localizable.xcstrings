    "textPreview.unsavedMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your changes are lost if you don't save them."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستفقد تغييراتك إذا لم تحفظها."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud je neuložíte, změny se ztratí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine ændringer går tabt, hvis du ikke gemmer dem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Änderungen gehen verloren, wenn du sie nicht sicherst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι αλλαγές σας χάνονται αν δεν τις αποθηκεύσετε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no los guardas, perderás los cambios."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muutoksesi menetetään, ellet tallenna niitä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos modifications seront perdues si vous ne les enregistrez pas."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השינויים שלכם יאבדו אם לא תשמרו אותם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर आप सहेजते नहीं हैं, तो आपके बदलाव खो जाएँगे।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A módosítások elvesznek, ha nem menti őket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perubahan Anda hilang jika tidak disimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se non le salvi, le modifiche andranno perse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存しないと変更内容は失われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장하지 않으면 변경 사항이 사라집니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Endringene dine går tapt hvis du ikke lagrer dem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je wijzigingen gaan verloren als je ze niet bewaart."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli ich nie zachowasz, zmiany zostaną utracone."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As suas alterações perdem-se se não as guardar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas alterações serão perdidas se você não salvá-las."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Modificările se pierd dacă nu le salvezi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если не сохранить изменения, они будут потеряны."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina ändringar går förlorade om du inte sparar dem."
          }
        },
        "th": {
