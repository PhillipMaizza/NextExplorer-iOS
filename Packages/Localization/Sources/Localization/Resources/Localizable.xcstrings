          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer'da oturum açın, sonra Tekrar Dene'ye yeniden dokunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увійдіть у NextExplorer, потім знову торкніться «Повторити»."
