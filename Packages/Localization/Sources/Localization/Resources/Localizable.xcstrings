    "textPreview.conflictMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Overwrite it with your version, or reload the file and discard your edits. The replaced version stays in the file's version history."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استبدله بنسختك، أو أعد تحميل الملف وتجاهل تعديلاتك. تبقى النسخة المستبدلة في سجل إصدارات الملف."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přepište ho svou verzí, nebo soubor znovu načtěte a zahoďte své úpravy. Nahrazená verze zůstane v historii verzí souboru."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Overskriv den med din version, eller genindlæs filen, og kassér dine rettelser. Den erstattede version forbliver i filens versionshistorik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überschreibe sie mit deiner Version oder lade die Datei neu und verwirf deine Änderungen. Die ersetzte Version bleibt im Versionsverlauf der Datei."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αντικαταστήστε το με την έκδοσή σας ή φορτώστε ξανά το αρχείο και απορρίψτε τις αλλαγές σας. Η έκδοση που αντικαταστάθηκε παραμένει στο ιστορικό εκδόσεων του αρχείου."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobrescríbelo con tu versión o recarga el archivo y descarta tus cambios. La versión reemplazada permanece en el historial de versiones del archivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Korvaa se omalla versiollasi tai lataa tiedosto uudelleen ja hylkää muokkauksesi. Korvattu versio säilyy tiedoston versiohistoriassa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écrasez-le avec votre version, ou rechargez le fichier et abandonnez vos modifications. La version remplacée reste dans l’historique des versions du fichier."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החליפו אותו בגרסה שלכם, או טענו מחדש את הקובץ וזרקו את העריכות שלכם. הגרסה שהוחלפה נשארת בהיסטוריית הגרסאות של הקובץ."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे अपने संस्करण से ओवरराइट करें, या फ़ाइल को फिर से लोड करें और अपने बदलाव छोड़ दें। बदला गया संस्करण फ़ाइल के संस्करण इतिहास में रहेगा।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Írja felül a saját verziójával, vagy töltse újra a fájlt, és dobja el a módosításait. A lecserélt verzió a fájl verzióelőzményeiben marad."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Timpa dengan versi Anda, atau muat ulang file dan buang suntingan Anda. Versi yang diganti tetap ada di riwayat versi file."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovrascrivilo con la tua versione oppure ricarica il file e scarta le modifiche. La versione sostituita resta nella cronologia delle versioni del file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分のバージョンで上書きするか、ファイルを再読み込みして編集内容を破棄してください。置き換えられたバージョンはファイルのバージョン履歴に残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 버전으로 덮어쓰거나, 파일을 다시 불러와 수정 내용을 버리세요. 대체된 버전은 파일의 버전 기록에 남습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Overskriv den med versjonen din, eller last filen på nytt og forkast endringene dine. Den erstattede versjonen blir værende i filens versjonshistorikk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Overschrijf het met jouw versie, of laad het bestand opnieuw en gooi je wijzigingen weg. De vervangen versie blijft in de versiegeschiedenis van het bestand."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadpisz go swoją wersją albo wczytaj plik ponownie i odrzuć swoje zmiany. Zastąpiona wersja pozostaje w historii wersji pliku."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Substitua-o pela sua versão ou volte a carregar o ficheiro e descarte as suas edições. A versão substituída permanece no histórico de versões do ficheiro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Substitua-o pela sua versão ou recarregue o arquivo e descarte suas edições. A versão substituída permanece no histórico de versões do arquivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Suprascrie-l cu versiunea ta sau reîncarcă fișierul și renunță la modificări. Versiunea înlocuită rămâne în istoricul versiunilor fișierului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перезапишите его своей версией или перезагрузите файл и отмените свои правки. Заменённая версия останется в истории версий файла."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv över den med din version, eller läs in filen igen och förkasta dina ändringar. Den ersatta versionen finns kvar i filens versionshistorik."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เขียนทับด้วยเวอร์ชันของคุณ หรือโหลดไฟล์ใหม่และทิ้งการแก้ไขของคุณ เวอร์ชันที่ถูกแทนที่จะยังอยู่ในประวัติเวอร์ชันของไฟล์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendi sürümünüzle üzerine yazın veya dosyayı yeniden yükleyip düzenlemelerinizi atın. Değiştirilen sürüm dosyanın sürüm geçmişinde kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перезапишіть його своєю версією або перезавантажте файл і відхиліть свої правки. Замінена версія залишається в історії версій файлу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi đè bằng phiên bản của bạn, hoặc tải lại tệp và bỏ các chỉnh sửa của bạn. Phiên bản bị thay thế vẫn nằm trong lịch sử phiên bản của tệp."
          }
        },
