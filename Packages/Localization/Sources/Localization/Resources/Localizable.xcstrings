    "tipJar.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer is free and open source. If it's useful to you, a small tip helps keep it going. Thank you!"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer مجاني ومفتوح المصدر. إذا كان مفيدًا لك، فإن إكرامية صغيرة تساعد على استمراره. شكرًا لك!"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer je zdarma a open source. Pokud vám je užitečný, malé spropitné pomáhá udržet ho při životě. Děkujeme!"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer er gratis og open source. Hvis det er nyttigt for dig, hjælper en lille drikkepenge med at holde det kørende. Tak!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer ist kostenlos und quelloffen. Wenn sie dir nützt, hilft ein kleines Trinkgeld, sie am Leben zu halten. Danke!"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το NextExplorer είναι δωρεάν και ανοικτού κώδικα. Αν σας φανεί χρήσιμο, ένα μικρό φιλοδώρημα βοηθά να συνεχίσει. Ευχαριστούμε!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer es gratis y de código abierto. Si te resulta útil, una pequeña propina ayuda a mantenerlo. ¡Gracias!"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer on ilmainen ja avoimen lähdekoodin. Jos siitä on sinulle hyötyä, pieni juomaraha auttaa pitämään sen käynnissä. Kiitos!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer est gratuit et open source. S’il vous est utile, un petit pourboire aide à le faire vivre. Merci !"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer הוא חינמי ובקוד פתוח. אם הוא שימושי עבורכם, טיפ קטן עוזר להמשיך לפתח אותו. תודה!"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer मुफ़्त और ओपन सोर्स है। अगर यह आपके काम आता है, तो एक छोटी सी टिप इसे चलाते रहने में मदद करती है। धन्यवाद!"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A NextExplorer ingyenes és nyílt forráskódú. Ha hasznosnak találja, egy kis borravaló segít a működésben tartásában. Köszönjük!"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer gratis dan open source. Jika bermanfaat bagi Anda, tip kecil membantu proyek ini terus berjalan. Terima kasih!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer è gratuito e open source. Se ti è utile, una piccola offerta aiuta a mantenerlo. Grazie!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer は無料でオープンソースです。お役に立てているなら、ささやかなチップが開発の支えになります。ありがとうございます！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer는 무료이며 오픈 소스입니다. 유용하셨다면 작은 후원이 개발을 이어가는 데 도움이 됩니다. 감사합니다!"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer er gratis og har åpen kildekode. Hvis den er nyttig for deg, bidrar et lite tips til å holde den i gang. Takk!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer is gratis en open source. Als je er iets aan hebt, helpt een kleine fooi om het draaiende te houden. Bedankt!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer jest darmowy i open source. Jeśli jest dla Ciebie przydatny, mały napiwek pomoże go utrzymać. Dziękuję!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O NextExplorer é gratuito e de código aberto. Se lhe for útil, uma pequena gorjeta ajuda a mantê-lo. Obrigado!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O NextExplorer é gratuito e de código aberto. Se for útil para você, uma pequena gorjeta ajuda a mantê-lo. Obrigado!"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer este gratuit și open source. Dacă îți este util, un mic bacșiș ajută să meargă mai departe. Mulțumesc!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer бесплатен и с открытым исходным кодом. Если он вам полезен, небольшие чаевые помогут его развивать. Спасибо!"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer är gratis och öppen källkod. Om den är användbar hjälper en liten dricks till att hålla den vid liv. Tack!"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer ใช้งานได้ฟรีและเป็นโอเพนซอร์ส หากเป็นประโยชน์กับคุณ ทิปเล็กน้อยช่วยให้โครงการดำเนินต่อไปได้ ขอบคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer ücretsiz ve açık kaynaklıdır. Size yararlıysa küçük bir bahşiş devam etmesine yardımcı olur. Teşekkürler!"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer безкоштовний і з відкритим кодом. Якщо він вам корисний, невеликі чайові допоможуть його підтримувати. Дякуємо!"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer miễn phí và mã nguồn mở. Nếu thấy hữu ích, một khoản ủng hộ nhỏ giúp dự án tiếp tục. Cảm ơn bạn!"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer 免费且开源。如果它对你有用，一点小小的打赏能帮助它继续下去。谢谢！"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer 免費且開源。如果它對你有用，一點小小的贊助能幫助它繼續下去。謝謝！"
          }
        }
      }
    },
    "tipJar.pending": {
      "extractionState": "manual",
      "localizations": {
