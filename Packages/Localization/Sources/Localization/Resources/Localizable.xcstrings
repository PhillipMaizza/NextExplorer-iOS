    "userManagement.setPasswordResetIntro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set a new local password for %@. Their current password stops working."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عيّن كلمة سر محلية جديدة لـ %@. ستتوقف كلمة سره الحالية عن العمل."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavte pro uživatele %@ nové místní heslo. Jeho stávající heslo přestane fungovat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Angiv en ny lokal adgangskode til %@. Den nuværende adgangskode holder op med at virke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege ein neues lokales Passwort für %@ fest. Das aktuelle Passwort funktioniert dann nicht mehr."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ορίστε έναν νέο τοπικό κωδικό πρόσβασης για τον χρήστη %@. Ο τρέχων κωδικός του σταματά να λειτουργεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Establece una nueva contraseña local para %@. Su contraseña actual dejará de funcionar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aseta uusi paikallinen salasana käyttäjälle %@. Nykyinen salasana lakkaa toimimasta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définissez un nouveau mot de passe local pour %@. Son mot de passe actuel cessera de fonctionner."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגדירו סיסמה מקומית חדשה עבור %@. הסיסמה הנוכחית שלו מפסיקה לעבוד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ के लिए नया स्थानीय पासवर्ड सेट करें। उनका वर्तमान पासवर्ड काम करना बंद कर देगा।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Állítson be új helyi jelszót a következőhöz: %@. A jelenlegi jelszava megszűnik működni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setel kata sandi lokal baru untuk %@. Kata sandi saat ini berhenti berfungsi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta una nuova password locale per %@. La sua password attuale smette di funzionare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の新しいローカルパスワードを設定します。現在のパスワードは機能しなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 새 로컬 비밀번호를 설정하세요. 현재 비밀번호는 작동을 멈춥니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Angi et nytt lokalt passord for %@. Det nåværende passordet slutter å virke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel een nieuw lokaal wachtwoord in voor %@. Het huidige wachtwoord werkt niet meer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustaw nowe hasło lokalne dla %@. Obecne hasło przestanie działać."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina uma nova palavra-passe local para %@. A palavra-passe atual deixa de funcionar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina uma nova senha local para %@. A senha atual deixa de funcionar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Setează o parolă locală nouă pentru %@. Parola actuală va înceta să funcționeze."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задайте новый локальный пароль для %@. Текущий пароль перестанет работать."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange ett nytt lokalt lösenord för %@. Det nuvarande lösenordet slutar fungera."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตั้งรหัสผ่านภายในใหม่สำหรับ %@ รหัสผ่านปัจจุบันจะหยุดทำงาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ için yeni bir yerel parola belirleyin. Mevcut parolası çalışmayı durdurur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Установіть новий локальний пароль для %@. Поточний пароль перестане працювати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt mật khẩu cục bộ mới cho %@. Mật khẩu hiện tại sẽ ngừng hoạt động."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "为 %@ 设置新的本地密码。其当前密码将停止工作。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "為 %@ 設定新的本機密碼。其目前密碼將停止運作。"
          }
        }
      }
    },
