    "browse.searchStoppedEarly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The search stopped at its time limit. These are the results found so far."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقف البحث عند حده الزمني. هذه هي النتائج التي عُثر عليها حتى الآن."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hledání se zastavilo na časovém limitu. Toto jsou dosud nalezené výsledky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Søgningen stoppede ved tidsgrænsen. Det er de resultater, der er fundet indtil nu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Suche wurde am Zeitlimit beendet. Das sind die bisher gefundenen Ergebnisse."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αναζήτηση σταμάτησε στο χρονικό της όριο. Αυτά είναι τα αποτελέσματα που βρέθηκαν μέχρι τώρα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La búsqueda se detuvo al alcanzar su límite de tiempo. Estos son los resultados encontrados hasta ahora."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Haku pysähtyi aikarajaansa. Nämä ovat toistaiseksi löydetyt tulokset."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La recherche s'est arrêtée à sa limite de temps. Voici les résultats trouvés jusqu'ici."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החיפוש נעצר במגבלת הזמן שלו. אלה התוצאות שנמצאו עד כה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खोज अपनी समय सीमा पर रुक गई। अब तक मिले परिणाम ये हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A keresés elérte az időkorlátját. Ezek az eddig talált eredmények."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencarian berhenti pada batas waktunya. Ini hasil yang ditemukan sejauh ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La ricerca si è fermata al limite di tempo. Questi sono i risultati trovati finora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索は制限時間で停止しました。これまでに見つかった結果です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검색이 시간 제한에 도달해 중단되었습니다. 지금까지 찾은 결과입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Søket stoppet ved tidsgrensen. Dette er resultatene som er funnet så langt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De zoekopdracht is gestopt bij de tijdslimiet. Dit zijn de resultaten die tot nu toe zijn gevonden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyszukiwanie zatrzymało się na limicie czasu. Oto wyniki znalezione do tej pory."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A pesquisa parou no limite de tempo. Estes são os resultados encontrados até agora."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pesquisa parou no limite de tempo. Estes são os resultados encontrados até agora."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Căutarea s-a oprit la limita de timp. Acestea sunt rezultatele găsite până acum."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поиск остановлен по истечении лимита времени. Вот результаты, найденные на данный момент."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sökningen stoppades vid tidsgränsen. Det här är resultaten som hittats hittills."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การค้นหาหยุดที่ขีดจำกัดเวลา นี่คือผลลัพธ์ที่พบจนถึงตอนนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arama zaman sınırında durdu. Şimdiye kadar bulunan sonuçlar bunlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пошук зупинився через обмеження часу. Це результати, знайдені на цей момент."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm kiếm đã dừng ở giới hạn thời gian. Đây là các kết quả tìm được cho đến nay."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索已达到时间限制而停止。以下是目前找到的结果。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "搜尋已達到時間限制而停止。以下是目前找到的結果。"
          }
        }
      }
    },
    "browse.searchTooShort": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type at least %lld characters to search subfolders and file contents."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب %lld أحرف على الأقل للبحث في المجلدات الفرعية ومحتوى الملفات."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro hledání v podsložkách a obsahu souborů zadejte alespoň znaků: %lld."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv mindst %lld tegn for at søge i undermapper og filindhold."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib mindestens %lld Zeichen ein, um Unterordner und Dateiinhalte zu durchsuchen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πληκτρολογήστε τουλάχιστον %lld χαρακτήρες για αναζήτηση σε υποφακέλους και περιεχόμενο αρχείων."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe al menos %lld caracteres para buscar en subcarpetas y en el contenido de los archivos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjoita vähintään %lld merkkiä hakeaksesi alikansioista ja tiedostojen sisällöstä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez au moins %lld caractères pour rechercher dans les sous-dossiers et le contenu des fichiers."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקלידו לפחות %lld תווים כדי לחפש בתיקיות משנה ובתוכן קבצים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सबफ़ोल्डर और फ़ाइलों की सामग्री में खोजने के लिए कम से कम %lld अक्षर लिखें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Írjon be legalább %lld karaktert az almappákban és a fájlok tartalmában való kereséshez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik minimal %lld karakter untuk mencari di subfolder dan isi file."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Digita almeno %lld caratteri per cercare nelle sottocartelle e nel contenuto dei file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブフォルダとファイルの内容を検索するには、%lld 文字以上入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하위 폴더와 파일 내용을 검색하려면 %lld자 이상 입력하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv minst %lld tegn for å søke i undermapper og filinnhold."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Typ minstens %lld tekens om in submappen en bestandsinhoud te zoeken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz co najmniej %lld znaki, aby przeszukać podfoldery i zawartość plików."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escreva pelo menos %lld caracteres para pesquisar subpastas e o conteúdo dos ficheiros."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite pelo menos %lld caracteres para pesquisar subpastas e o conteúdo dos arquivos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastează cel puțin %lld caractere pentru a căuta în subfoldere și în conținutul fișierelor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите не менее %lld символов, чтобы искать во вложенных папках и содержимом файлов."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv minst %lld tecken för att söka i undermappar och filinnehåll."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พิมพ์อย่างน้อย %lld อักขระเพื่อค้นหาในโฟลเดอร์ย่อยและเนื้อหาไฟล์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt klasörlerde ve dosya içeriklerinde aramak için en az %lld karakter yazın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть щонайменше символів: %lld, щоб шукати в підпапках і вмісті файлів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập ít nhất %lld ký tự để tìm trong thư mục con và nội dung tệp."
          }
        },
        "zh-CN": {
          "stringUnit": {
