          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Introdu unul dintre codurile tale de recuperare. Fiecare funcționează o singură dată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
