    "offline.removeConfirmMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This deletes the files saved for offline use on this device. Your files on the server are not affected."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي هذا إلى حذف الملفات المحفوظة للاستخدام دون اتصال على هذا الجهاز. لن تتأثر ملفاتك على الخادم."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tím se smažou soubory uložené pro offline použití na tomto zařízení. Vaše soubory na serveru se nezmění."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette sletter de filer, der er gemt til offline brug på denne enhed. Dine filer på serveren påvirkes ikke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden die für die Offline-Nutzung auf diesem Gerät gespeicherten Dateien gelöscht. Deine Dateien auf dem Server sind nicht betroffen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό διαγράφει τα αρχεία που έχουν αποθηκευτεί για χρήση εκτός σύνδεσης σε αυτήν τη συσκευή. Τα αρχεία σας στον διακομιστή δεν επηρεάζονται."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina los archivos guardados para uso sin conexión en este dispositivo. Tus archivos en el servidor no se ven afectados."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä poistaa tähän laitteeseen offline-käyttöön tallennetut tiedostot. Palvelimella olevia tiedostojasi ei kosketa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime les fichiers enregistrés pour une utilisation hors ligne sur cet appareil. Vos fichiers sur le serveur ne sont pas affectés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולה זו מוחקת את הקבצים ששמורים לשימוש לא מקוון במכשיר זה. הקבצים שלכם בשרת לא מושפעים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे इस डिवाइस पर ऑफ़लाइन उपयोग के लिए सहेजी गई फ़ाइलें हट जाती हैं। सर्वर पर आपकी फ़ाइलें प्रभावित नहीं होतीं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez törli az offline használatra mentett fájlokat ezen az eszközön. A kiszolgálón lévő fájljait nem érinti."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini menghapus file yang disimpan untuk penggunaan offline di perangkat ini. File Anda di server tidak terpengaruh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo elimina i file salvati per l'uso offline su questo dispositivo. I tuoi file sul server non vengono modificati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末にオフライン用として保存されたファイルを削除します。サーバー上のファイルには影響しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에 오프라인 사용을 위해 저장된 파일을 삭제합니다. 서버의 파일은 영향을 받지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette sletter filene som er lagret for frakoblet bruk på denne enheten. Filene dine på serveren påvirkes ikke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee worden de voor offline gebruik opgeslagen bestanden op dit apparaat verwijderd. Je bestanden op de server worden niet gewijzigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to usunięcie plików zapisanych do użytku offline na tym urządzeniu. Pliki na serwerze pozostaną bez zmian."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto elimina os ficheiros guardados para utilização offline neste dispositivo. Os seus ficheiros no servidor não são afetados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso exclui os arquivos salvos para uso offline neste dispositivo. Seus arquivos no servidor não são afetados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceasta șterge fișierele salvate pentru utilizare offline pe acest dispozitiv. Fișierele tale de pe server nu sunt afectate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это удалит файлы, сохранённые для офлайн-доступа на этом устройстве. Ваши файлы на сервере не будут затронуты."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta tar bort filerna som sparats för offlineanvändning på den här enheten. Dina filer på servern påverkas inte."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดำเนินการนี้จะลบไฟล์ที่บันทึกไว้สำหรับใช้แบบออฟไลน์บนอุปกรณ์เครื่องนี้ ไฟล์ของคุณบนเซิร์ฟเวอร์ไม่ได้รับผลกระทบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem, bu cihazda çevrimdışı kullanım için kaydedilen dosyaları siler. Sunucudaki dosyalarınız etkilenmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це видалить файли, збережені для офлайн-використання на цьому пристрої. Ваші файли на сервері не зачіпаються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này xóa các tệp đã lưu để dùng ngoại tuyến trên thiết bị này. Các tệp của bạn trên máy chủ không bị ảnh hưởng."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "这将删除此设备上为离线使用保存的文件。服务器上的文件不受影响。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "這會刪除此裝置上為離線使用儲存的檔案。伺服器上的檔案不受影響。"
          }
        }
      }
    },
