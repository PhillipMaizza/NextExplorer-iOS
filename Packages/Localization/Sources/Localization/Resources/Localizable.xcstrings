    "login.errorDecoding": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server responded unexpectedly. Check the address and try again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استجاب الخادم بشكل غير متوقع. تحقق من العنوان وأعد المحاولة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat unerwartet geantwortet. Prüfe die Adresse und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor respondió de forma inesperada. Comprueba la dirección e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réponse inattendue du serveur. Vérifiez l'adresse et réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्वर ने अप्रत्याशित रूप से प्रतिक्रिया दी। पता जांचें और पुनः प्रयास करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server ha risposto in modo inatteso. Controlla l'indirizzo e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバから予期しない応答がありました。アドレスを確認して再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 예기치 않게 응답했습니다. 주소를 확인하고 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De server gaf een onverwacht antwoord. Controleer het adres en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer odpowiedział nieoczekiwanie. Sprawdź adres i spróbuj ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor respondeu de forma inesperada. Verifique o endereço e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Serverul a răspuns neașteptat. Verifică adresa și încearcă din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер ответил неожиданно. Проверьте адрес и повторите попытку."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Servern svarade oväntat. Kontrollera adressen och försök igen."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器响应异常。请检查地址后重试。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器回應異常。請檢查位址後重試。"
          }
        }
      }
    },
    "login.errorIncomplete": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in didn't complete. Please try again."
