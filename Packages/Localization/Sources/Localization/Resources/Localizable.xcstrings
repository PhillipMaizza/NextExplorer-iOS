    "uploads.reviewInsecureNetworkNotice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected over http. If this server is only on your home network, uploads won't work while you're away from it."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متصل عبر http. إذا كان هذا الخادم على شبكتك المنزلية فقط، فلن يعمل الرفع عندما تكون بعيدًا عنها."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připojeno přes http. Pokud je tento server jen ve vaší domácí síti, nahrávání nebude mimo ni fungovat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forbundet via http. Hvis denne server kun findes på dit hjemmenetværk, virker uploads ikke, når du er væk fra det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über http verbunden. Wenn dieser Server nur in deinem Heimnetzwerk ist, funktionieren Uploads nicht, wenn du dich außerhalb befindest."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνδεδεμένοι μέσω http. Αν αυτός ο διακομιστής βρίσκεται μόνο στο οικιακό σας δίκτυο, οι μεταφορτώσεις δεν θα λειτουργούν όταν είστε μακριά από αυτό."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectado por http. Si este servidor solo está en tu red doméstica, las subidas no funcionarán cuando estés fuera de ella."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhdistetty http-yhteydellä. Jos tämä palvelin on vain kotiverkossasi, lähetykset eivät toimi, kun olet poissa sieltä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecté en http. Si ce serveur n'est que sur votre réseau domestique, les envois ne fonctionneront pas hors de ce réseau."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחובר באמצעות http. אם השרת הזה נמצא רק ברשת הביתית שלכם, ההעלאות לא יעבדו כשאתם מחוץ לרשת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "http के माध्यम से कनेक्ट किया गया। यदि यह सर्वर केवल आपके होम नेटवर्क पर है, तो उससे दूर रहने पर अपलोड काम नहीं करेंगे।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsolat http-n keresztül. Ha ez a kiszolgáló csak az otthoni hálózaton érhető el, a feltöltések nem működnek, amikor távol van."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terhubung melalui http. Jika server ini hanya ada di jaringan rumah Anda, unggahan tidak akan berfungsi saat Anda jauh darinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Connesso tramite http. Se questo server è solo sulla tua rete domestica, i caricamenti non funzioneranno quando sei lontano da essa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "http で接続しています。このサーバーがホームネットワークのみにある場合、そのネットワークから離れるとアップロードは機能しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "http로 연결되었습니다. 이 서버가 홈 네트워크에만 있다면 네트워크를 벗어나면 업로드가 작동하지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Koblet til via http. Hvis denne serveren bare finnes på hjemmenettverket ditt, fungerer ikke opplastinger når du er borte fra det."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbonden via http. Als deze server alleen op je thuisnetwerk staat, werken uploads niet wanneer je er niet mee verbonden bent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połączono przez http. Jeśli ten serwer jest tylko w sieci domowej, przesyłanie nie będzie działać poza nią."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ligado por http. Se este servidor estiver apenas na sua rede doméstica, os envios não funcionarão quando estiver fora dela."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectado por http. Se este servidor só for acessível na sua rede doméstica, os envios não funcionarão quando você estiver fora dela."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectat prin http. Dacă acest server este doar în rețeaua ta de acasă, încărcările nu vor funcționa când ești în afara ei."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключено по http. Если этот сервер доступен только в вашей домашней сети, отправка не будет работать вне её."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ansluten via http. Om den här servern bara finns i ditt hemnätverk fungerar inte uppladdningar när du är borta från det."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อผ่าน http หากเซิร์ฟเวอร์นี้อยู่ในเครือข่ายบ้านของคุณเท่านั้น การอัปโหลดจะใช้ไม่ได้เมื่อคุณอยู่นอกเครือข่าย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "http üzerinden bağlısınız. Bu sunucu yalnızca ev ağınızdaysa, ağdan uzakken yüklemeler çalışmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З’єднання через http. Якщо цей сервер є лише у вашій домашній мережі, вивантаження не працюватиме, коли ви поза нею."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã kết nối qua http. Nếu máy chủ này chỉ có trong mạng gia đình của bạn, việc tải lên sẽ không hoạt động khi bạn ở xa."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 http 连接。如果此服务器仅在您的家庭网络中，离开该网络时上传将无法工作。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "透過 http 連線。如果此伺服器僅在您的家庭網路中，離開該網路時上傳將無法運作。"
          }
        }
      }
    },
