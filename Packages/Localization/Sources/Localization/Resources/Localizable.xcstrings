    "folderSizeSettings.locked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set by %@ in the environment, so it is decided there and not here."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تحديده بواسطة %@ في البيئة، لذا يُقرَّر هناك وليس هنا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastaveno proměnnou %@ v prostředí, takže se rozhoduje tam, ne tady."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Angivet af %@ i miljøet, så det bestemmes dér og ikke her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durch %@ in der Umgebung festgelegt – das wird dort entschieden, nicht hier."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ορίζεται από το %@ στο περιβάλλον, επομένως αποφασίζεται εκεί και όχι εδώ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Definido por %@ en el entorno: se decide allí, no aquí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asetettu ympäristössä muuttujalla %@, joten asia päätetään siellä eikä täällä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Défini par %@ dans l'environnement : c'est là que cela se décide, pas ici."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מוגדר על ידי %@ בסביבה, ולכן ההחלטה מתקבלת שם ולא כאן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पर्यावरण में %@ द्वारा सेट है — इसका निर्णय वहीं होता है, यहाँ नहीं।."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A környezetben a(z) %@ állítja be, ezért ott dől el, nem itt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditetapkan oleh %@ di lingkungan, jadi diputuskan di sana, bukan di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impostato da %@ nell'ambiente: si decide lì, non qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "環境の%@で設定されているため、ここではなくそちらで決まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "환경의 %@(으)로 설정되어 있어, 여기가 아니라 그곳에서 결정됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Satt av %@ i miljøet, så det avgjøres der og ikke her."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingesteld door %@ in de omgeving: dat wordt daar beslist, niet hier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustawione przez %@ w środowisku — decyduje się o tym tam, a nie tutaj."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Definido por %@ no ambiente, pelo que é decidido lá e não aqui."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Definido por %@ no ambiente: isso é decidido lá, não aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Setat de %@ în mediu: se decide acolo, nu aici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задано переменной %@ в окружении — это решается там, а не здесь."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Satt av %@ i miljön – det avgörs där, inte här."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำหนดโดย %@ ในสภาพแวดล้อม จึงตัดสินที่นั่นไม่ใช่ที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ortamda %@ tarafından ayarlandı, bu yüzden burada değil orada belirlenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Задано змінною %@ у середовищі, тому це вирішується там, а не тут."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Được đặt bởi %@ trong môi trường, nên được quyết định ở đó chứ không phải ở đây."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "由环境中的 %@ 设置，因此在那里决定，而不是在这里。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "由環境中的 %@ 設定，因此在那裡決定，而不是在這裡。"
          }
        }
      }
    },
