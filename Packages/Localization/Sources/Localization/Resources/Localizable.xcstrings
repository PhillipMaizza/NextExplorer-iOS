    "activityLog.clearMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every recorded line is deleted. This cannot be undone."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم حذف كل سطر مسجَّل. لا يمكن التراجع عن ذلك."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý zaznamenaný řádek bude smazán. Tuto akci nelze vrátit zpět."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle registrerede linjer slettes. Dette kan ikke fortrydes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder aufgezeichnete Eintrag wird gelöscht. Das lässt sich nicht rückgängig machen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε καταγεγραμμένη γραμμή διαγράφεται. Αυτό δεν μπορεί να αναιρεθεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se elimina cada línea registrada. No se puede deshacer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokainen kirjattu rivi poistetaan. Tätä ei voi kumota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque ligne enregistrée est supprimée. Cette action est irréversible."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל שורה שנרשמה תימחק. לא ניתן לבטל פעולה זו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दर्ज की गई हर पंक्ति हटा दी जाएगी। इसे पूर्ववत नहीं किया जा सकता।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden rögzített sor törlődik. Ez nem vonható vissza."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap baris yang tercatat dihapus. Tindakan ini tidak dapat dibatalkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni riga registrata viene eliminata. L'operazione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録されたすべての行が削除されます。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록된 모든 줄이 삭제됩니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver registrerte linje slettes. Dette kan ikke angres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke vastgelegde regel wordt verwijderd. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy zarejestrowany wiersz zostanie usunięty. Tej operacji nie można cofnąć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as linhas registadas são eliminadas. Não é possível anular."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as linhas registradas serão excluídas. Isso não pode ser desfeito."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare linie înregistrată este ștearsă. Acțiunea nu poate fi anulată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая записанная строка будет удалена. Это нельзя отменить."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje loggad rad raderas. Detta kan inte ångras."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกบรรทัดที่บันทึกไว้จะถูกลบ ไม่สามารถเลิกทำได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedilen her satır silinir. Bu işlem geri alınamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен записаний рядок буде видалено. Цю дію не можна скасувати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi dòng đã ghi sẽ bị xóa. Không thể hoàn tác."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "所有已记录的内容都将被删除，此操作无法撤销。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "所有已記錄的內容都將被刪除，此操作無法復原。"
          }
        }
      }
    },
