    "shareUpload.sessionUnreadable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer couldn't read your sign in on this device. Open NextExplorer once, then share again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على NextExplorer قراءة تسجيل دخولك على هذا الجهاز. افتح NextExplorer مرة واحدة ثم شارك مرة أخرى."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer nedokázal přečíst vaše přihlášení na tomto zařízení. Jednou otevřete NextExplorer a pak sdílejte znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer kunne ikke læse dit login på denne enhed. Åbn NextExplorer én gang, og del derefter igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer konnte deine Anmeldung auf diesem Gerät nicht lesen. Öffne NextExplorer einmal und teile dann erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το NextExplorer δεν μπόρεσε να διαβάσει τη σύνδεσή σας σε αυτήν τη συσκευή. Ανοίξτε μία φορά το NextExplorer και μετά κοινοποιήστε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer no pudo leer tu inicio de sesión en este dispositivo. Abre NextExplorer una vez y vuelve a compartir."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer ei voinut lukea kirjautumistasi tällä laitteella. Avaa NextExplorer kerran ja jaa sitten uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer n’a pas pu lire votre connexion sur cet appareil. Ouvrez NextExplorer une fois, puis partagez à nouveau."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer לא הצליח לקרוא את ההתחברות שלכם במכשיר הזה. פתחו את NextExplorer פעם אחת, ואז שתפו שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer इस डिवाइस पर आपका साइन इन नहीं पढ़ सका। NextExplorer को एक बार खोलें, फिर दोबारा साझा करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A NextExplorer nem tudta beolvasni a bejelentkezését ezen az eszközön. Nyissa meg egyszer a NextExplorert, majd ossza meg újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer tidak dapat membaca info masuk Anda di perangkat ini. Buka NextExplorer sekali, lalu bagikan lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer non è riuscito a leggere il tuo accesso su questo dispositivo. Apri NextExplorer una volta, poi condividi di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスでNextExplorerのサインイン情報を読み取れませんでした。NextExplorerを一度開いてから、もう一度共有してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 NextExplorer 로그인 정보를 읽지 못했습니다. NextExplorer를 한 번 연 다음 다시 공유하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer kunne ikke lese innloggingen din på denne enheten. Åpne NextExplorer én gang, og del deretter på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer kon je aanmelding op dit apparaat niet lezen. Open NextExplorer één keer en deel daarna opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer nie mógł odczytać Twojego logowania na tym urządzeniu. Otwórz NextExplorer raz, a potem udostępnij ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O NextExplorer não conseguiu ler o seu início de sessão neste dispositivo. Abra o NextExplorer uma vez e partilhe novamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O NextExplorer não conseguiu ler o seu login neste dispositivo. Abra o NextExplorer uma vez e compartilhe novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer nu a putut citi autentificarea ta pe acest dispozitiv. Deschide NextExplorer o dată, apoi distribuie din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer не смог прочитать ваш вход на этом устройстве. Откройте NextExplorer один раз, затем поделитесь снова."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer kunde inte läsa din inloggning på den här enheten. Öppna NextExplorer en gång och dela sedan igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer ไม่สามารถอ่านการเข้าสู่ระบบของคุณบนอุปกรณ์เครื่องนี้ได้ เปิด NextExplorer หนึ่งครั้ง แล้วแชร์อีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer bu cihazdaki oturumunuzu okuyamadı. NextExplorer'ı bir kez açın, sonra tekrar paylaşın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer не зміг прочитати ваш вхід на цьому пристрої. Відкрийте NextExplorer один раз, потім поділіться знову."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer không đọc được thông tin đăng nhập của bạn trên thiết bị này. Hãy mở NextExplorer một lần, rồi chia sẻ lại."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer 无法读取此设备上的登录信息。请先打开一次 NextExplorer,然后再次分享。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "NextExplorer 無法讀取此裝置上的登入資訊。請先開啟一次 NextExplorer,然後再次分享。"
          }
        }
      }
    },
